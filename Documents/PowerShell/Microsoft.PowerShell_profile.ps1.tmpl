# [[[ Get-Fonts
function Get-Fonts {
    param (
        $regex
    )
    $AllFonts = (New-Object System.Drawing.Text.InstalledFontCollection).Families.Name
    if ($null -ne $regex) {
        $FilteredFonts = $($AllFonts | Select-String -Pattern ".*${regex}.*")
        return $FilteredFonts
    }
    return $AllFonts
}
