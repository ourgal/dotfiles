# [[[ git add all, commit and push shortcut
function _git_commit_and_push {
  git add .
  git commit
  git push
}
Set-PSReadLineKeyHandler -Key Alt+x `
                         -BriefDescription git_update `
                         -LongDescription "Git commit and push" `
                         -ScriptBlock {
    [Microsoft.PowerShell.PSConsoleReadLine]::RevertLine()
    [Microsoft.PowerShell.PSConsoleReadLine]::Insert("_git_commit_and_push")
    [Microsoft.PowerShell.PSConsoleReadLine]::AcceptLine()
}
