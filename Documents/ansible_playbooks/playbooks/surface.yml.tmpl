# chezmoi:template:left-delimiter=[[ right-delimiter=]]
---
- name: Configure void linux
  hosts: surface
  vars:
    username: zxc
    hostname: surface
  tasks:
    - name: Debug variables
      ansible.builtin.debug:
        var: ansible_facts
    - name: Upgrade system
      tags:
        - pkg
        - xbps
      become: true
      when:
        - ansible_facts.os_family == "Void"
      community.general.xbps:
        upgrade: true
    - name: Install packages
      tags:
        - pkg
        - xbps
      become: true
      when:
        - ansible_facts.os_family == "Void"
      environment:
        XBPS_ARCH: "{{ ansible_facts.machine }}"
      community.general.xbps:
        name:
          - git
          - curl
          - aria2
          - grep
          - fzf
          - yt-dlp
          - ffmpeg
          - 7zip
          - atool
          - unzip
          - buku
          - Clipboard
          - xclip
          - xsel
          - aria2
          - transmission
          - yt-dlp
          - gvim-huge
          - helix
          - kakoune
          - neovim
          - chezmoi
          - lf
          - nnn
          - ranger
          - yazi
          - git
          - git-annex
          - git-crypt
          - git-extras
          - lazygit
          - gitui
          - delta
          - difftastic
          - jujutsu
          - github-cli
          - tmux
          - zellij
          - dufs
          - miniserve
          - rclone
          - ImageMagick
          - fish-shell
          - fzf
          - broot
          - atuin
          - starship
          - rsync
          - syncthing
          - stc
          - xtools
          - kmonad
          - psmisc
          - ripgrep
          - zoxide
          - mmv
          - fd
          - eza
          - tree
          - duf
          - dua-cli
          - btop
          - htop
          - bat
          - gopass
          - keepassxc
          - mpv
          - firefox
          - chromium
          - kitty
          - alacritty
          - emacs-gtk3
          - vscode
          - sioyek
          - telegram-desktop
          - editorconfig
          - ansible
          - shellcheck
          - nodejs
          - uv
          - xfce4
          - xfce4-battery-plugin
          - xorg
          - lemurs
          - lightdm
          - noto-fonts-ttf
          - noto-fonts-cjk
          - nerd-fonts-symbols-ttf
          - noto-fonts-emoji
          - intel-video-accel
          - intel-ucode
          - libva-utils
          - python3-pipx
    - name: Uninstall packages
      tags:
        - pkg
        - xbps
      become: true
      when:
        - ansible_facts.os_family == "Void"
      environment:
        XBPS_ARCH: "{{ ansible_facts.machine }}"
      community.general.xbps:
        state: absent
        name:
          - dot-xsession
    - name: Setup pip mirror
      when:
        - ansible_facts.system == "Linux"
        - ansible_facts.os_family == "Darwin"
      block:
        - name: Create .pip folder
          ansible.builtin.file:
            dest: "{{ ansible_facts.user_dir }}/.pip"
            state: directory
        - name: Set pip config
          ansible.builtin.copy:
            dest: "{{ ansible_facts.user_dir }}/.pip/pip.ini"
            content: |
              [global]
              index-url = https://mirrors.nju.edu.cn/pypi/web/simple/
              [install]
              trusted-host = mirrors.nju.edu.cn
    - name: Install pipx packages
      tags: pipx
      when:
        - ansible_facts.system == "Linux"
        - ansible_facts.os_family == "Darwin"
      community.general.pipx:
        name: "{{ item }}"
      loop:
        - jellyfin-mpv-shim
        - leo
        - advance-touch
    - name: Services
      become: true
      when:
        - ansible_facts.os_family == "Void"
      block:
        - name: Create per user service folder
          ansible.builtin.file:
            dest: "/etc/sv/runsvdir-{{ username }}"
            state: directory
            mode: "0755"
        - name: Create run script
          ansible.builtin.copy:
            dest: "/etc/sv/runsvdir-{{ username }}/run"
            mode: "0755"
            content: |
              #!/bin/sh

              export USER="{{ username }}"
              export HOME="/home/{{ username }}"

              groups="$(id -Gn "$USER" | tr ' ' ':')"
              svdir="$HOME/service"

              exec chpst -u "$USER:$groups" runsvdir "$svdir"
        - name: Create lemurs service folder
          ansible.builtin.file:
            dest: /etc/sv/lemurs
            state: directory
            mode: "0755"
        - name: Create run script
          ansible.builtin.copy:
            dest: /etc/sv/lemurs/run
            mode: "0755"
            content: |
              #!/bin/sh
              # /etc/sv/lemurs/run
              # Start Lemurs on tty7 (via agetty) and, best-effort, switch to tty7 during boot.

              # If we're on a real virtual terminal (VT) console: switch to tty7 so Lemurs is visible immediately.
              if command -v fgconsole >/dev/null 2>&1 && command -v chvt >/dev/null 2>&1; then
                cur="$(fgconsole 2>/dev/null || echo "")"
                if [ -n "$cur" ] && [ "$cur" != "serial" ] && [ "$cur" != "7" ]; then
                  chvt 7 2>/dev/null || true
                fi
              fi

              # Protect tty7 from kernel printk messages so they don't overwrite Lemurs' TUI.
              TERM=linux setterm --msg off </dev/tty7 >/dev/tty7 2>/dev/null || true

              # Optional: clear tty7 once so old screen contents don't "shine through" into the UI.
              TERM=linux setterm --clear=all </dev/tty7 >/dev/tty7 2>/dev/null || true

              # Runit expects this script to exec a single foreground process.
              # agetty attaches to /dev/tty7, sets TERM=linux, and starts Lemurs as the login program.
              exec agetty --noissue --skip-login --login-program /usr/bin/lemurs tty7 linux
    - name: Enable services
      become: true
      when:
        - ansible_facts.os_family == "Void"
      ansible.builtin.file:
        src: "/etc/sv/{{ item }}"
        dest: "/var/service/{{ item }}"
        state: link
      loop:
        - "runsvdir-{{ username }}"
        - lightdm
    - name: Disable services
      become: true
      when:
        - ansible_facts.os_family == "Void"
      ansible.builtin.file:
        path: "/var/service/{{ item }}"
        state: absent
      loop:
        - lemurs
    - name: Create pam lemurs
      become: true
      ansible.builtin.copy:
        dest: /etc/pam.d/lemurs
        mode: "0644"
        content: |
          #%PAM-1.0
          auth        include    login
          account     include    login
          session     include    login
          password    include    login
    - name: Set lemurs config
      become: true
      ansible.builtin.lineinfile:
        path: /etc/lemurs/config.toml
        regexp: '^tty ='
        line: tty = 7
    - name: LinuxBrew
      tags:
        - pkg
        - brew
      environment:
        PATH: "/home/linuxbrew/.linuxbrew/bin:{{ ansible_env.PATH }}"
        HOMEBREW_BREW_GIT_REMOTE: "https://mirror.nju.edu.cn/git/homebrew/brew.git"
      block:
        - name: Check if Homebrew is installed
          ansible.builtin.stat:
            path: "/home/linuxbrew/.linuxbrew/bin/brew"
          register: brew_stat
        - name: Create Homebrew directory
          ansible.builtin.file:
            path: "/home/linuxbrew/.linuxbrew"
            state: directory
            owner: "{{ ansible_env.USER }}"
            group: "{{ ansible_env.USER }}"
            mode: '0755'
          become: true
          when: not brew_stat.stat.exists
        - name: Install Homebrew
          ansible.builtin.shell: |
            curl -fsSL https://github.com/Homebrew/brew/tarball/master | tar xz --strip 1 -C /home/linuxbrew/.linuxbrew
          when: not brew_stat.stat.exists
    - name: Set the system hostname
      become: true
      when:
        - ansible_facts.system == "Linux"
        - ansible_facts.os_family == "Darwin"
      ansible.builtin.hostname:
        name: "{{ hostname }}"
    - name: Set user groups
      become: true
      when:
        - ansible_facts.system == "Linux"
        - ansible_facts.os_family == "Darwin"
      ansible.builtin.user:
        name: "{{ username }}"
        groups:
          - '{{ "input" if ansible_facts.os_family == "Void" else omit }}'
        append: true
    - name: Regenerate initramfs
      become: true
      when:
        - ansible_facts.os_family == "Void"
      ansible.builtin.command:
        cmd: "xbps-reconfigure --force linux{{ ansible_facts.kernel | regex_search('\\d+\\.\\d+') }}"
      changed_when: true
    - name: Download xlocate data
      changed_when: true
      when:
        - ansible_facts.os_family == "Void"
      ansible.builtin.command:
        cmd: xlocate -S
