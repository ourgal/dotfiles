# chezmoi:template:left-delimiter=[[ right-delimiter=]]
---
- name: Configure windows admin
  hosts: windows
  remote_user: admin
  ignore_unreachable: true
  tags: admin
  tasks:
    - name: Gather facts
      ansible.builtin.gather_facts:
    - name: Debug variables
      ansible.builtin.debug:
        var: ansible_facts
    - name: Install choco pacakges
      tags: choco-install
      chocolatey.chocolatey.win_chocolatey:
        name:
          - visualstudio2026-workload-vctools
          - weasel
          - winfsp # rclone
          - steam
          - epicgameslauncher
          - "{{ 'tailscale' if ansible_facts.nodename == 'work' else omit }}"
          - directx
        state: latest
    - name: Uninstall choco pacakges
      tags: choco-uninstall
      chocolatey.chocolatey.win_chocolatey:
        name:
          - gimp
          - gpg4win
          - firefox
          - mpvio
        state: absent
    - name: Install init packages via scoop
      tags: admin-scoop-init
      community.windows.win_scoop:
        name: "{{ item }}"
        global: false
        no_cache: true
      register: result
      retries: 3
      delay: 5
      until: result is not failed
      loop:
        - git
    - name: Add bucket
      community.windows.win_scoop_bucket:
        name: "{{ item }}"
        state: present
      loop:
        - extras
        - nerd-fonts
        - nonportable
    - name: Install nonportable packages via scoop
      tags: admin-scoop-nonportable
      community.windows.win_scoop:
        name:
          - files-np
          - virtualbox-with-extension-pack-np
        global: true
        no_cache: true
      register: result
      retries: 3
      delay: 5
      until: result is not failed
    - name: WSL
      tags: wsl
      block:
        - name: Enable Virtual Machine Platform
          ansible.windows.win_optional_feature:
            name: VirtualMachinePlatform
            state: present
          register: vmp_status
        - name: Enable hyper-v
          ansible.windows.win_shell: bcdedit /set hypersivoralaunchtype auto
          when: vmp_status is failed
        - name: Reboot for hyper-v
          ansible.windows.win_reboot:
          when: vmp_status is failed
        - name: Enable Virtual Machine Platform again
          ansible.windows.win_optional_feature:
            name: VirtualMachinePlatform
            state: present
          register: vmp_again_status
          when: vmp_status is failed
        - name: Install Microsoft Subsystem for Linux
          ansible.windows.win_optional_feature:
            name: Microsoft-Windows-Subsystem-Linux
            state: present
          register: wsl_status
        - name: Reboot if installing Linux Subsytem as feature requires it
          ansible.windows.win_reboot:
          when: >
            (wsl_status.reboot_required is defined and wsl_status.reboot_required) or
            (vmp_status.reboot_required is defined and vmp_status.reboot_required) or
            (vmp_again_status.reboot_required is defined and vmp_again_status.reboot_required)
    - name: Hide admin account
      tags: hide-admin
      ansible.windows.win_regedit:
        path: HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon\SpecialAccounts\UserList
        type: dword
        name: Admin
        data: 0
    - name: Set user groups
      tags: user-admin
      ansible.windows.win_user:
        name: User
        state: present
        groups:
          - Users
    - name: Disable ssh-agent service
      tags: ssh-agent
      ansible.windows.win_service:
        name: ssh-agent
        state: stopped
        start_mode: disabled
    - name: Update openssh
      tags: openssh
      chocolatey.chocolatey.win_chocolatey:
        name: openssh
        state: latest
        allow_prerelease: true
        package_params: /SSHServerFeature
    - name: Optimize powershell
      tags: optimize-powershell
      ansible.windows.win_shell: |
        function Optimize-Assemblies {
            param (
                [string]$assemblyFilter = "Microsoft.PowerShell.",
                [string]$activity = "Native Image Installation"
            )

            try {
                # Get the path to the ngen executable dynamically
                $ngenPath = [System.IO.Path]::Combine([Runtime.InteropServices.RuntimeEnvironment]::GetRuntimeDirectory(), "ngen.exe")

                # Check if ngen.exe exists
                if (-Not (Test-Path $ngenPath)) {
                    Write-Host "Ngen.exe not found at $ngenPath. Make sure .NET Framework is installed."
                    return
                }

                # Get a list of loaded assemblies
                $assemblies = [AppDomain]::CurrentDomain.GetAssemblies()

                # Filter assemblies based on the provided filter
                $filteredAssemblies = $assemblies | Where-Object { $_.FullName -ilike "$assemblyFilter*" }

                if ($filteredAssemblies.Count -eq 0) {
                    Write-Host "No matching assemblies found for optimization."
                    return
                }

                foreach ($assembly in $filteredAssemblies) {
                    # Get the name of the assembly
                    $name = [System.IO.Path]::GetFileName($assembly.Location)

                    # Display progress
                    Write-Progress -Activity $activity -Status "Optimizing $name"

                    # Use Ngen to install the assembly
                    Start-Process -FilePath $ngenPath -ArgumentList "install `"$($assembly.Location)`"" -Wait -WindowStyle Hidden
                }

                Write-Host "Optimization complete."
            } catch {
                Write-Host "An error occurred: $_"
            }
        }

        # Optimize PowerShell assemblies:
        Optimize-Assemblies -assemblyFilter "Microsoft.PowerShell."
    - name: Add game user
      tags: game-user
      ansible.windows.win_user:
        name: Game
        password_expired: false
        password_never_expires: true
        state: present
        groups:
          - Users
          - Administrators
    - name: Set Developer Mode registry key
      ansible.windows.win_regedit:
        path: HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\AppModelUnlock
        name: AllowDevelopmentWithoutSponsor
        data: 1
        type: dword
        state: present
    - name: Ensure Developer Mode Group Policy is enabled
      ansible.windows.win_regedit:
        path: HKLM:\SOFTWARE\Policies\Microsoft\Windows\Appx
        name: AllowAllTrustedApps
        data: 1
        type: dword
        state: present
    - name: Set hostname
      ansible.builtin.win_hostname:
        name: nuc-windows
    - name: Install scream pre
      when: ansible_facts.nodename in ['bed', 'nuc']
      tags: scream-pre
      block:
        - name: Check scream driver file
          ansible.windows.win_stat:
            path: C:\windows\system32\drivers\scream.sys
          register: scream_driver
        - name: Scream pre
          when: scream_driver.stat.exists is false
          block:
            - name: Enable testing mode
              ansible.windows.win_command: Bcdedit.exe -set TESTSIGNING ON
            - name: Reboot
              ansible.windows.win_reboot:
            - name: Download file
              ansible.windows.win_get_url:
                url: https://github.com/duncanthrax/scream/releases/download/4.0/Scream4.0.zip
                dest: C:\Scream.zip
            - name: Unzip file
              community.windows.win_unzip:
                src: C:\Scream.zip
                dest: C:\Scream
                force: true
            - name: Run installer
              ansible.windows.win_command: C:\Scream\Install\Install-x64.bat
  handlers:
    - name: Reboot
      ansible.windows.win_reboot:
- name: Configure windows user
  hosts: windows
  remote_user: user
  ignore_unreachable: true
  tags: user
  tasks:
    - name: Gather facts
      ansible.builtin.gather_facts:
    - name: Debug variables
      ansible.builtin.debug:
        var: ansible_facts
    - name: Install aria2 and lessmsi via scoop
      community.windows.win_scoop:
        name:
          - lessmsi
          - aria2
        global: false
        no_cache: true
      register: result
      retries: 3
      delay: 5
      until: result is not failed
    - name: Update scoop config
      tags: scoop-config
      block:
        - name: Facts
          ansible.builtin.gather_facts:
          when: ansible_facts is not defined
        - name: Check scoop config file
          ansible.windows.win_stat:
            path: "{{ ansible_facts.user_dir }}\\.config\\scoop\\config.json"
          register: scoop_config_stat
        - name: Get scoop config content
          ansible.windows.slurp:
            src: "{{ ansible_facts.user_dir }}\\.config\\scoop\\config.json"
          register: scoop_config_content
          when: scoop_config_stat.stat.exists is true
        - name: Set scoop config
          vars:
            config:
              use_lessmsi: true
              aria2-enabled: true
              aria2-warning-enabled: false
              use_sqlite_cache: true
              force_update: true
              use_external_7zip: false
              gh_token: "{{ lookup('gopass', 'github/ourgal/token') | trim }}"
          ansible.windows.win_copy:
            dest: "{{ ansible_facts.user_dir }}\\.config\\scoop\\config.json"
            content: "{{ scoop_config_content.content | b64decode | from_json | combine(config) | to_json }}"
          when: scoop_config_stat.stat.exists is true
        - name: Set scoop config
          vars:
            config:
              use_lessmsi: true
              aria2-enabled: true
              aria2-warning-enabled: false
              use_sqlite_cache: true
              force_update: true
              use_external_7zip: false
              gh_token: "{{ lookup('gopass', 'github/ourgal/token') | trim }}"
          ansible.windows.win_copy:
            dest: "{{ ansible_facts.user_dir }}\\.config\\scoop\\config.json"
            content: "{{ config | to_json }}"
          when: scoop_config_stat.stat.exists is false
    - name: Install 7zip and git via scoop
