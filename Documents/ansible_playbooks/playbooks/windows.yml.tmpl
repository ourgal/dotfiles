    - name: Windows firewall rules
      tags: firewall
      block:
        - name: Facts
          ansible.builtin.gather_facts:
          when: ansible_facts.user_dir is not defined
        - name: Enable firewall for Domain, Public and Private profiles
          ansible.windows.win_firewall:
            state: enabled
            profiles:
              - Domain
              - Private
              - Public
        - name: Check current source folder
          ansible.windows.win_stat:
            path: C:\Users\User\scoop\apps\croc\current
          register: path
        - name: Croc firewall rule
          community.windows.win_firewall_rule:
            name: croc.exe
            localport: 9009-9013
            action: allow
            direction: in
            protocol: tcp
            state: "{{ 'present' if path.stat.exists is true else 'absent' }}"
            enabled: true
        - name: Croc firewall rule
          community.windows.win_firewall_rule:
            name: croc.exe udp
            localport: 9009-9013
            action: allow
            direction: in
            protocol: udp
            state: "{{ 'present' if path.stat.exists is true else 'absent' }}"
