# chezmoi:template:left-delimiter=[[ right-delimiter=]]
---
- name: Configure uos
  hosts: uos
  vars:
    user: zxc
  tasks:
    - name: Debug variables
      ansible.builtin.debug:
        var: ansible_facts
    - name: Nix
      tags:
        - pkg
        - nix
      block:
        - name: Nix folder stat
          ansible.builtin.stat:
            path: /nix
          register: nix_stat
        - name: Install nix
          become: true
          ansible.builtin.shell: curl -sSfL https://artifacts.nixos.org/nix-installer | sh -s -- install --enable-flakes --no-confirm
          when: not nix_stat.stat.exists
        - name: Add trusted-users to nix config
          become: true
          ansible.builtin.lineinfile:
            path: /etc/nix/nix.conf
            line: trusted-users = {{ user }}
        - name: Home-manager stat
          ansible.builtin.stat:
            path: "{{ ansible_facts.user_dir }}/.nix-profile/bin/home-manager
          register: home_manager_stat
        - name: Install home-manager channel
          ansible.builtin.shell: nix-channel --add https://github.com/nix-community/home-manager/archive/release-25.11.tar.gz home-manager
          when: not home_manager_stat.stat.exists
        - name: Update channels
          ansible.builtin.shell: nix-channel --update
          when: not home_manager_stat.stat.exists
        - name: Install home-manager
          ansible.builtin.shell: nix-shell '<home-manager>' -A install
          when: not home_manager_stat.stat.exists
