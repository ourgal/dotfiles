{{ if eq .chezmoi.os "windows" -}}
{{ if lookPath "firefox" -}}
Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"
$PSNativeCommandUseErrorActionPreference = $true
{{ $dir := joinPath .chezmoi.homeDir "scoop" "persist" "firefox" "profile" "chrome" -}}
{{ $theme := joinPath .chezmoi.homeDir "scoop" "persist" "firefox" .my.modules.firefox.theme "chrome" -}}
{{ template "powershell_junction" dict "source" $dir "target" $theme }}
{{ end -}}
{{ end -}}
