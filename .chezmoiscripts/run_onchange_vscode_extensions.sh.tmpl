{{ if or (eq .chezmoi.os "linux") (eq .chezmoi.os "android") -}}
{{ if or (lookPath "code") (lookPath "code-oss") -}}
#!{{lookPath "sh"}}
set -euo pipefail
{{ $code := lookPath "code" -}}
{{ if lookPath "code-oss" -}}
{{ $code = lookPath "code-oss" -}}
{{ end -}}
{{ $code }} --update-extensions
$extensions = (
    "tamasfe.even-better-toml"
    "carlos-algms.make-task-provider"
    "vscodevim.vim"
    "vspacecode.vspacecode"
    "jnoortheen.nix-ide"
    "boltex.leojs"
    "redhat.ansible"
    "ms-python.python"
    "redhat.vscode-yaml"
    "MattiasBaake.vscode-snippets-for-ansible"
    "kahole.magit"
    "PKief.material-icon-theme"
    "mark-wiemer.vscode-autohotkey-plus-plus"
    "Chouzz.vscode-better-align"
    "ms-vscode-remote.remote-wsl"
    "danprince.vsnetrw"
    "ms-playwright.playwright"
    )
for e in $extensions; do
    {{ $code }} --install-extension "$e"
done
{{ end -}}
{{ end -}}
