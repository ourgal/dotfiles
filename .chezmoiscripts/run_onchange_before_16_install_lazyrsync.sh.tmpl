{{ if eq .chezmoi.os "android" -}}
#!{{ lookPath "bash" }}

{{ $version := "0.3.0" -}}
{{ $url := printf "https://github.com/westpoint-io/lazyrsync/releases/download/v%s/lazyrsync-aarch64-unknown-linux-musl.tar.gz" $version -}}

{{ includeTemplate "download" (dict
  "url" (print .my.gh_proxy "/" $url)
  "output" (joinPath .chezmoi.homeDir ".local" "bin" | printf "%s/")
  "extract" true
  "include" "lazyrsync"
  "chezmoi" .chezmoi
)}}

{{ end -}}
