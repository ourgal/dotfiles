{{ if eq .chezmoi.os "android" -}}
#!{{ lookPath "bash" }}

{{ $crush_version := "0.95.0" -}}
{{ $crush_url := printf "https://github.com/charmbracelet/crush/releases/download/v%s/crush_%s_Android_%s.tar.gz" $crush_version $crush_version .chezmoi.arch -}}

{{ includeTemplate "download" (dict
  "url" (print .my.gh_proxy "/" $crush_url)
  "output" (joinPath .chezmoi.homeDir ".local" "bin" | printf "%s/")
  "extract" true
  "include" "*/crush"
  "chezmoi" .chezmoi
)}}

{{ end -}}
