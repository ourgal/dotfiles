{{ if eq .chezmoi.os "linux" "android" -}}
{{ $flatpak := joinPath .chezmoi.homeDir ".local" "share" "flatpak" "exports" "share" "applications" "org.fcitx.Fcitx5.desktop" -}}
{{ if or (lookPath "fcitx5") (stat $flatpak) -}}
#!{{ lookPath "bash" }}

{{ $output := joinPath .chezmoi.homeDir ".local" "share" "fcitx5" "rime" | printf "%s/" -}}
{{ if stat $flatpak -}}
{{ $output = joinPath .chezmoi.homeDir ".var" "app" "org.fcitx.Fcitx5" "data" "fcitx5" "rime" | printf "%s/" -}}
{{ end -}}

{{ includeTemplate "download" (dict
  "url" (print .my.gh_proxy "/" .my.sbsrf.url)
  "output" $output
  "extract" true
  "chezmoi" .chezmoi
)}}

{{ end -}}
{{ end -}}
