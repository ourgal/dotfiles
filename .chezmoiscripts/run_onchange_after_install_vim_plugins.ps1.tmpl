{{ if eq .chezmoi.os "windows" -}}
{{ if lookPath "vim" -}}
{{ template "checkPath" "cat" -}}
{{ $file_content := output "cat" (joinPath .chezmoi.homeDir "vimfiles" "import" "plugins.vim") | splitList "\n" -}}
{{ $sum := list -}}
{{ range $file_content -}}
{{ if hasPrefix "Plug" . -}}
{{ $sum = (. | split "'")._1 | append $sum -}}
