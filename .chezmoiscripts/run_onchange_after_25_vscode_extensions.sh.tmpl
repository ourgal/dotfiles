{{ if eq .chezmoi.os "linux" "android" -}}
{{ if or (lookPath "code") (lookPath "code-oss") -}}
#!{{lookPath "bash"}}
set -euo pipefail
{{ $code := lookPath "code" -}}
{{ if lookPath "code-oss" -}}
{{ $code = lookPath "code-oss" -}}
{{ end -}}
{{ $code }} --update-extensions
extensions=(
  # common
  "EditorConfig.EditorConfig"

  # toml
  "tamasfe.even-better-toml"

  # make
  "carlos-algms.make-task-provider"

  # vim
  "vscodevim.vim"

  # which key
  "vspacecode.vspacecode"

  # nix
  "jnoortheen.nix-ide"

  # leojs
  "boltex.leojs"

  # ansible
  "redhat.ansible"
  "MattiasBaake.vscode-snippets-for-ansible"

  # python
  "ms-python.python"
  "ms-playwright.playwright"

  # yaml
  "redhat.vscode-yaml"

  # magit
  "kahole.magit"

  # theme
  "PKief.material-icon-theme"

  # autohotkey
  "mark-wiemer.vscode-autohotkey-plus-plus"

  # align
  "Chouzz.vscode-better-align"

  # wsl
  {{ if eq .chezmoi.os "windows" -}}
  "ms-vscode-remote.remote-wsl"
  {{ end -}}

  # netrw
  "danprince.vsnetrw"
  )
for e in "${extensions[@]}"; do
    {{ $code }} --install-extension "$e"
done
{{ end -}}
{{ end -}}
