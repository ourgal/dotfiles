{{ if eq .chezmoi.os "windows" -}}

{{ $scriptPath := joinPath .chezmoi.homeDir ".local" "bin" "update-bing-wallpaper.ps1" -}}
{{ $taskName := "BingWallpaperDaily" -}}

{{ if exec "powershell" "-command" (print "Get-ScheduledTask -TaskName " $taskName) | not -}}
Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"
$PSNativeCommandUseErrorActionPreference = $true

if (-not (Test-Path -LiteralPath {{ $scriptPath | quote }})) {
    Write-Warning "Wallpaper script not found at {{ $scriptPath }}"
    exit 0
}

$existing = Get-ScheduledTask -TaskName {{ $taskName | quote }} -ErrorAction SilentlyContinue
if ($existing) {
    Write-Output "Scheduled task '{{ $taskName }}' already registered; skipping."
    exit 0
}

$action = New-ScheduledTaskAction `
    -Execute powershell `
    -Argument "-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File `"{{ $scriptPath }}`"" `
    -WorkingDirectory (Split-Path -Parent {{ $scriptPath | quote }})

$trigger = New-ScheduledTaskTrigger -Daily -At "08:00"

$principal = New-ScheduledTaskPrincipal `
    -UserId $env:USERNAME `
    -LogonType Interactive `
    -RunLevel Limited

$settings = New-ScheduledTaskSettingsSet `
    -AllowStartIfOnBatteries `
    -DontStopIfGoingOnBatteries `
    -StartWhenAvailable `
    -ExecutionTimeLimit (New-TimeSpan -Minutes 5)

try {
    Register-ScheduledTask `
        -TaskName {{ $taskName | quote }} `
        -Action $action `
        -Trigger $trigger `
        -Principal $principal `
        -Settings $settings `
        -Force `
        -ErrorAction Stop | Out-Null
    Write-Output "Registered scheduled task '{{ $taskName }}' to run daily at 08:00."
} catch {
    Write-Warning "Failed to register scheduled task '{{ $taskName }}': $_"
}
{{ end -}}

{{ end -}}
