{{ if eq .chezmoi.os "linux" "android" -}}
{{ if ne "Void" (dig "chezmoi" "osRelease" "name" "" .) -}}
#!{{ lookPath "bash" }}

{{ includeTemplate "unix_download" (dict
  "url" (print .my.gh_proxy "/" .my.font.nerdsymbols_url)
  "output" (joinPath .chezmoi.homeDir ".local" "share" "fonts" | printf "%s/")
  "extract" true
  "sub_dir" true
  "include" "*.ttf"
)}}

{{ end -}}
{{ end -}}
