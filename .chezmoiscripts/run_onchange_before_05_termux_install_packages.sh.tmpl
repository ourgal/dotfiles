{{- if eq .chezmoi.os "android" -}}
#!/data/data/com.termux/files/usr/bin/bash

# Package hash: {{ .my.termux.packages.install | join "" | sha256sum }}

echo "Updating Termux packages..."
pkg update -y

mapfile -t installed < <(dpkg-query -W -f='${binary:package}\n')
list=({{ range .my.termux.packages.install }}{{ . }} {{ end }})

for pkg in "${list[@]}"; do
  if ! grep -q "\b$pkg\b" <(echo "${installed[@]}"); then
    # pkg uninstall -y "$pkg"
    echo "install $pkg"
    pkg install -y $pkg
  fi
done

{{- end -}}
