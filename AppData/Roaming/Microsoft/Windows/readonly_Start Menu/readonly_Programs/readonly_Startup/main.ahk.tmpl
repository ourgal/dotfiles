{{ if eq .chezmoi.os "windows" -}}
RunScoop(app)
{
    appdata_dir := EnvGet("AppData")
    user_dir := EnvGet("userprofile")
    scoop_apps_dir := appdata_dir . "/Microsoft/Windows/Start Menu/Programs/Scoop Apps"
    Run(scoop_apps_dir . "/" . app . ".lnk", user_dir, "Max")
}

SetTitleMatchMode(2)
{{ if and (lookPath "glazewm") .my.modules.glazewm -}}
Run("glazewm", {{ .chezmoi.homeDir | quote }}, "Hide")
{{ end -}}
{{ if and (eq .chezmoi.hostname "nuc") (lookPath "deskflow-core") -}}
Run("deskflow-core client", , "Hide")
{{ end -}}
{{ if and (eq .chezmoi.hostname "work") (lookPath "deskflow-core") -}}
Run("deskflow-core server", , "Hide")
{{ end -}}
{{ if lookPath "aria2c" -}}
Run("{{ joinPath .chezmoi.homeDir "scoop" "apps" "aria2" "current" "aria2c.exe" }} --enable-rpc", {{ joinPath .chezmoi.homeDir "Downloads" | quote }}, "Hide")
{{ end -}}
{{ if lookPath "espansod" -}}
Run("{{ joinPath .chezmoi.homeDir "scoop" "apps" "espanso" "current" "espansod.exe" }} start", {{ .chezmoi.homeDir | quote }}, "Hide")
{{ end -}}
{{ if lookPath "alist" -}}
Run("alist start", , "Hide")
{{ end -}}
{{ if and ( lookPath "mpd" ) .my.modules.mpd -}}
Run("mpd {{ joinPath (env "appdata") "mpd" "mpd.conf"}}", {{ .chezmoi.homeDir | quote }}, "Hide")
{{ end -}}
{{ if lookPath "gpg-connect-agent" -}}
Run("gpg-connect-agent /bye", , "Hide")
{{ end -}}
{{ if lookPath "kdeconnect-cli" -}}
Run("{{ joinPath .chezmoi.homeDir "scoop" "apps" "kdeconnect" "current" "bin" "kdeconnectd.exe" }}", {{ .chezmoi.homeDir | quote }}, "Hide")
{{ end -}}
{{ if and (lookPath "wt") (lookPath "pwsh") .my.modules.wt -}}
RunScoop("Windows Terminal")
WinWait("ahk_exe WindowsTerminal.exe")
{{ end -}}
{{ if and (lookPath "wezterm") .my.modules.wezterm -}}
Run "{{ joinPath .chezmoi.homeDir "scoop" "apps" "wezterm" "current" "wezterm-gui.exe" }}"
WinWait("ahk_exe wezterm-gui.exe")
{{ end -}}
{{ if lookPath "firefox" -}}
Run("firefox", , "Max")
WinWait("ahk_exe firefox.exe")
{{ else if lookPath "brave" -}}
Run("brave", , "Max")
{{ end -}}
{{ $vscode := joinPath .chezmoi.homeDir "scoop" "apps" "vscode" "current" "Code.exe" -}}
{{ $vscodium := joinPath .chezmoi.homeDir "scoop" "apps" "vscodium" "current" "VSCodium.exe" -}}
{{ if stat $vscodium -}}
Run({{ $vscodium | quote }}, {{ .chezmoi.homeDir | quote }}, "Max")
WinWait("ahk_exe VSCodium.exe")
{{ else if stat $vscode -}}
Run({{ $vscode | quote }}, {{ .chezmoi.homeDir | quote }}, "Max")
{{ end -}}
{{ if lookPath "everything" -}}
Run("everything", , "Hide")
{{ end -}}
{{ if and ( lookPath "autohotkey" ) .my.modules.keybindings.autohotkey .my.modules.glazewm -}}
Run({{ joinPath .chezmoi.homeDir "Documents" "autohotkey" "keybindings.ahk" | quote }}, , "Hide")
{{ end -}}
{{ $powertoys := joinPath .chezmoi.homeDir "scoop" "apps" "powertoys" "current" "powertoys.exe" -}}
{{ if and ( stat $powertoys ) .my.modules.keybindings.powertoys .my.modules.glazewm -}}
Run({{ $powertoys | quote }}, {{ .chezmoi.homeDir | quote }}, "Hide")
{{ end -}}
{{ if lookPath "autohotkey" -}}
Run({{ joinPath .chezmoi.homeDir "Documents" "autohotkey" "hide_cursor.ahk" | quote }}, , "Hide")
{{ end -}}
{{ if lookPath "dufs" -}}
Run("dufs --allow-upload --allow-search --allow-symlink --allow-archive -p 6500", {{ joinPath .chezmoi.homeDir "Documents" "share" | quote }}, "Hide")
{{ end -}}
{{ if lookPath "copyparty" -}}
Run("copyparty --no-del -p 6080,6443", {{ joinPath .chezmoi.homeDir "Documents" "share" | quote }}, "Hide")
{{ end -}}
{{ if and (lookPath "altrun") .my.modules.altrun -}}
Run("altrun -StartMenu", , "Hide")
{{ end -}}
{{ if and ( lookPath "navidrome" ) .my.modules.navidrome -}}
Run({{ print "navidrome --datafolder " (joinPath (env "LOCALAPPDATA") "navidrome") | quote }}, {{ joinPath .chezmoi.homeDir | quote }}, "Hide")
{{ end -}}
{{ if lookPath "syncthing" -}}
Run("syncthing serve --no-console --no-browser", , "Hide")
{{ end -}}
{{ if and (stat (joinPath .chezmoi.homeDir "scoop" "apps" "jellyfin-mpv-shim")) (eq .chezmoi.hostname "bed") -}}
Run({{ joinPath .chezmoi.homeDir "scoop" "apps" "jellyfin-mpv-shim" "current" "run.exe" | quote }}, , "Hide")
{{ end -}}
{{ if lookPath "keepassxc" -}}
Run({{ joinPath .chezmoi.homeDir "Documents" "autohotkey" "keepassxc.ahk" | quote }}, , "Hide")
{{ end -}}
{{ if stat (joinPath .chezmoi.homeDir "scoop" "apps" "copyq" "current" "copyq.exe") -}}
Sleep 45*1000
Run("{{ joinPath .chezmoi.homeDir "scoop" "apps" "copyq" "current" "copyq.exe" }}", {{ .chezmoi.homeDir | quote }}, "Hide")
{{ end -}}
{{ end -}}
