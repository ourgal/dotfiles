[GHEGist]
  Public = false
  access_token = ""
  auto_sync = false
  base_url = ""
  file_name = ""
  gist_id = ""
  upload_url = ""

[General]
  Backend = "gist"
  {{ if eq .chezmoi.os "windows" -}}
  Cmd = ["powershell", "-c"]
  {{ else -}}
  Cmd = []
  {{ end -}}
  Color = false
  Column = 40
  Editor = "{{ template "editor" }}"
  Format = "[$description]: $command $tags"
  SelectCmd = "fzf --ansi --layout=reverse --border --height=90% --pointer=* --cycle --prompt=Snippets:"
  SnippetDirs = []
  {{ if eq .chezmoi.os "windows" -}}
  SnippetFile = {{ joinPath .chezmoi.homeDir "AppData" "Roaming" "pet" "snippet.toml" | quote }}
  {{ else -}}
  SnippetFile = ""
  {{ end -}}
  SortBy = ""

[Gist]
  Public = false
  access_token = ""
  auto_sync = false
  file_name = "pet-snippet.toml"
  gist_id = ""

[GitLab]
  ID = ""
  Url = ""
  Visibility = "private"
  access_token = ""
  auto_sync = false
  file_name = "pet-snippet.toml"
  skip_ssl = false
