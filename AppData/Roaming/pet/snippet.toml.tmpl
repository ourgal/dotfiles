{{ if eq .chezmoi.os "windows" -}}
{{ if lookPath "pet" -}}
{{ $termux := dict -}}
{{ $termux = set $termux "note20" (dict "port" 8023 "user" "u0_a664" "host" "localhost") -}}
{{ $termux = set $termux "m6" (dict "port" 8022 "user" "u0_a455" "host" "localhost") -}}
[[Snippets]]
Description = "Remove file from git history"
Output = ""
Tag = []
command = "git filter-repo --path (fzf) --invert-paths"
[[Snippets]]
Description = "Forward note20 adb port"
Output = ""
Tag = ["termux"]
command = "adb forward tcp:{{ $termux.note20.port }} tcp:8022"
[[Snippets]]
Description = "Forward m6 adb port"
Output = ""
Tag = ["termux"]
command = "adb forward tcp:{{ $termux.m6.port }} tcp:8022"
{{ end -}}
{{ end -}}
