{{ if eq .chezmoi.os "windows" -}}
{{ if lookPath "pet" -}}
{{ $termux := dict -}}
{{ $termux = set $termux "note20" (dict "port" 8022 "user" "u0_a650" "ip" (ternary "192.168.1.106" "192.168.123.232" (eq .chezmoi.hostname "work" "work2"))) -}}
{{ $termux = set $termux "note20_adb" (dict "port" 8023 "user" $termux.note20.user "ip" "localhost") -}}
{{ $termux = set $termux "m6" (dict "port" 8022 "user" "u0_a455" "ip" (ternary "192.168.1.103" "192.168.123.191" (eq .chezmoi.hostname "work" "work2"))) -}}
{{ $termux = set $termux "m6_adb" (dict "port" 8022 "user" $termux.m6.user "ip" "localhost") -}}
[[Snippets]]
Description = "Remove file from git history"
Output = ""
Tag = []
command = "git filter-repo --path (fzf) --invert-paths"
[[Snippets]]
Description = "Forward note20 adb port"
Output = ""
Tag = ["termux"]
command = "adb forward tcp:{{ $termux.note20_adb.port }} tcp:8022"
[[Snippets]]
Description = "Forward m6 adb port"
Output = ""
Tag = ["termux"]
command = "adb forward tcp:{{ $termux.m6_adb.port }} tcp:8022"
{{ end -}}
{{ end -}}
