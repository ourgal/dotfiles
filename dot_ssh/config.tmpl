{{ if eq .chezmoi.os "windows" "linux" "android" -}}
{{ if lookPath "ssh" -}}
{{ $termux := dict -}}
{{ $termux = set $termux "note20" (dict "port" 8023 "user" "u0_a664" "host" "localhost" "ip" (ternary "192.168.1.106" "192.168.123.232" (eq .chezmoi.hostname "work" "work2"))) -}}
{{ $termux = set $termux "m6" (dict "port" 8022 "user" "u0_a455" "host" "localhost" "ip" "192.168.123.191") -}}
Host soft
  Port 23231
  HostName {{ .my.ip.brix }}
Host nuc
  Port 22
  User user
  HostName 192.168.123.123
Host github.com
  HostName ssh.github.com
  Port 443
  User git
Host note20-adb
  Port {{ $termux.note20.port }}
  User {{ $termux.note20.user }}
  HostName {{ $termux.note20.host }}
Host note20
  Port 8022
  User {{ $termux.note20.user }}
  HostName {{ $termux.note20.ip }}
Host m6-adb
  Port {{ $termux.m6.port }}
  User {{ $termux.m6.user }}
  HostName {{ $termux.m6.host }}
{{ if ne .chezmoi.hostname "localhost" -}}
Host gogs-m6
  Port 23231
  User {{ $termux.m6.user }}
  HostName {{ template "ipM6" .chezmoi.hostname }}
{{ end -}}
{{ if eq .chezmoi.hostname "work" "work2" -}}
Host work2
  Port 22
  User {{ .my.name }}
  HostName 192.168.1.107
{{ end -}}
Host *
  AddKeysToAgent yes
{{ end -}}
{{ end -}}
