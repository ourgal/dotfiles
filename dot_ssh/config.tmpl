{{ if eq .chezmoi.os "windows" "linux" "android" -}}
{{ if lookPath "ssh" -}}
Host soft
  Port 23231
  HostName {{ .my.ip.brix }}
Host github.com
  HostName ssh.github.com
  Port 443
  User git
Host note20
  Port 8022
  User u0_a664
  HostName localhost
{{ if ne .chezmoi.hostname "localhost" -}}
Host gogs-m6
  Port 23231
  User {{ .my.termux.m6.username }}
  HostName {{ template "ipM6" .chezmoi.hostname }}
{{ end -}}
Host *
  AddKeysToAgent yes
{{ end -}}
{{ end -}}
