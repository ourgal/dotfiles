Host soft
  Port {{ $ip.soft.port }}
  HostName {{ $ip.soft.ip }}
Host nuc
  Port {{ $ip.nuc.port }}
  User {{ $ip.nuc.user }}
  HostName {{ $ip.nuc.ip }}
Host github.com
  HostName ssh.github.com
  Port 443
  User git
Host note20-adb
  Port {{ $termux.note20_adb.port }}
  User {{ $termux.note20_adb.user }}
  HostName {{ $termux.note20_adb.ip }}
Host note20
  Port {{ $termux.note20.port }}
  User {{ $termux.note20.user }}
  HostName {{ $termux.note20.ip }}
Host m6
  Port {{ $termux.m6.port }}
  User {{ $termux.m6.user }}
  HostName {{ $termux.m6.ip }}
Host m6-adb
  Port {{ $termux.m6_adb.port }}
