{{ if eq .chezmoi.os "windows" "linux" "android" -}}
{{ if lookPath "ssh" -}}
{{ $termux := dict -}}
{{ $termux = set $termux "note20" (dict "port" 8023 "user" "u0_a664" "host" "localhost") -}}
{{ $termux = set $termux "m6" (dict "port" 8022 "user" "u0_a455" "host" "localhost") -}}
Host soft
  Port 23231
  HostName {{ .my.ip.brix }}
Host github.com
  HostName ssh.github.com
  Port 443
  User git
Host note20
  Port {{ $termux.note20.port }}
  User {{ $termux.note20.user }}
  HostName {{ $termux.note20.host }}
Host m6
  Port {{ $termux.m6.port }}
  User {{ $termux.m6.user }}
  HostName {{ $termux.m6.host }}
{{ if ne .chezmoi.hostname "localhost" -}}
Host gogs-m6
  Port 23231
  User {{ $termux.m6.user }}
  HostName {{ template "ipM6" .chezmoi.hostname }}
{{ end -}}
Host *
  AddKeysToAgent yes
{{ end -}}
{{ end -}}
