{{ if eq . nil -}}
{{ fail "pass pathes to checkPath template" -}}
{{ end -}}
{{ if kindIs "slice" . -}}
    {{ range . -}}
    {{ template "_checkPath" . -}}
    {{ end -}}
{{ else if kindIs "string" . -}}
    {{ template "_checkPath" . -}}
{{ else -}}
{{ fail "checkPath: unsupported type" -}}
{{ end -}}
