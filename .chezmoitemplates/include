{{ if not (any (kindIs "string" .) (kindIs "slice" .)) -}}
{{ fail (print "Wrong arugment types of include")}}
{{ end -}}

{{ if kindIs "string" . -}}
    {{ if not (stat .) -}}
    {{ warnf (print "file " . " not found") }}
    {{ else -}}
    {{ include . -}}
    {{ end -}}
{{ else -}}
    {{ range . -}}
        {{ if not (stat .) -}}
        {{ warnf (print "file " . " not found") }}
        {{ else -}}
        {{ include . -}}
        {{ end -}}
    {{ end -}}
{{ end -}}
