{{ if dig "url" "" . | not -}}
{{ fail "no url found" }}
{{ end -}}

{{ $url := .url -}}
{{ $ext := osExt $url -}}
{{ $filename := osBase $url -}}
{{ $basename := splitList "." $filename | first -}}

{{ if dig "output" "" . | not -}}
{{ fail "no output found" }}
{{ end -}}

{{ $output := .output -}}
{{ $output_dir := osDir .output -}}
{{ if splitList "/" .output | last | not -}}
{{ $output = joinPath $output $filename -}}
{{ end -}}

{{ $sub_dir := dig "sub_dir" false . -}}
{{ if $sub_dir -}}
{{ $output_dir = joinPath $output_dir $basename -}}
{{ end -}}

{{ if or (eq $ext ".git") (dig "git" false .) -}}

{{ if stat .output | not -}}

  {{ if dig "clone_args" (list) . -}}
  git clone {{ join " " .clone_args }} {{ $url }} {{ .output | quote }}
  {{ else -}}
  git clone {{ $url }} {{ .output | quote }}
  {{ end -}}

{{ else if eq 0 (mod (now | date "__2") 7) -}}

  # {{ now | date "__2" }}

  git -C {{ .output | quote }} pull

{{ end -}}

{{ else if dig "extract" false . -}}

{{ if eq .chezmoi.os "windows" -}}

$TEMP_DIR = Join-Path $env:TEMP ([Guid]::NewGuid().ToString("N"))
New-Item -ItemType Directory -Path $TEMP_DIR -Force

$TargetEvent = Register-EngineEvent -SourceIdentifier PowerShell.Exiting -Action {
    if (Test-Path $Event.MessageData) {
        Remove-Item -Path $Event.MessageData -Recurse -Force -ErrorAction SilentlyContinue
    }
} -MessageData $TEMP_DIR | Out-Null

{{ else -}}

TEMP_DIR=$(mktemp -d)

cleanup() {
  # Check if the directory variable is not empty and actually exists
  if [[ -n "$TEMP_DIR" && -d "$TEMP_DIR" ]]; then
    rm -rf "$TEMP_DIR"
  fi
}

trap cleanup EXIT
{{ end -}}

echo "{{ $url }} -> {{ $output }}"
{{ if and (lookPath "aria2c") (dig "curl" false . | not) -}}
aria2c {{ $url | quote }} -d "$TEMP_DIR" -o {{ $filename | quote }}
{{ else -}}
curl -L {{ $url | quote }} -o "$TEMP_DIR/{{ $filename }}"
{{ end -}}

{{ if eq .chezmoi.os "windows" -}}
New-Item -ItemType Directory -Path {{ $output_dir | quote }} -Force
{{ else -}}
mkdir -p {{ $output_dir | quote }}
{{ end -}}

{{ if eq $ext ".xz" ".gz" -}}
  {{ if dig "include" "" . -}}
    {{ if eq .chezmoi.os "windows" -}}
    cd {{ $output_dir | quote }}
    7z x -aoa "$TEMP_DIR/{{ $filename }}"
    7z e -aoa {{ splitList "." $filename | initial | join "." }} {{ .include | quote }}
    {{ else -}}
    $(cd {{ $output_dir | quote }} && tar -xf "$TEMP_DIR/{{ $filename }}" --transform='s:.*/::' --wildcards {{ .include }})
    {{ end -}}
  {{ else -}}
    {{ if eq .chezmoi.os "windows" -}}
    cd {{ $output_dir | quote }}
    7z x -aoa "$TEMP_DIR/{{ $filename }}"
    7z e -aoa {{ splitList "." $filename | initial | join "." }}
    {{ else -}}
    tar -xf "$TEMP_DIR/{{ $filename }}" -C {{ $output_dir | quote }}
    {{ end -}}
  {{ end -}}
{{ else if eq $ext ".zip" -}}
  {{ if lookPath "7z" -}}
  7z e "$TEMP_DIR/{{ $filename }}" -aoa -o{{ $output_dir }}
  {{ else -}}
  tar -xf "$TEMP_DIR/{{ $filename }}" -C {{ $output_dir | quote }}
  {{ end -}}
{{ end -}}

{{ else -}}

{{ if eq .chezmoi.os "windows" -}}
New-Item -ItemType Directory -Path {{ $output_dir | quote }} -Force
{{ else -}}
mkdir -p {{ $output_dir | quote }}
{{ end -}}

echo "{{ $url }} -> {{ $output }}"
{{ if and (lookPath "aria2c") (dig "curl" false . | not) -}}
cd "{{ $output_dir }}"
aria2c {{ $url | quote }} -o {{ $filename | quote }}
{{ else -}}
cd "{{ $output_dir }}"
curl -L {{ $url | quote }} -o {{ $filename | quote }}
{{ end -}}

{{ end -}}
