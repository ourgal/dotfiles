{{ $os := .chezmoi.os -}}
{{ $linux := "" -}}
{{ if eq .chezmoi.os "linux" -}}
{{ $linux = .chezmoi.osRelease.id -}}
{{ end -}}

{{ $global_opt := "" -}}
{{ $host_opt := "" -}}
{{ $final_opt := "" -}}
{{ if kindIs "string" .opt -}}
{{ $global_opt = index .my.modules .opt -}}
{{ $host_opt = index .my.modules .chezmoi.hostname $os .opt -}}
{{ else if kindIs "slice" .opt -}}
{{ $global_opt = .my.modules -}}

    {{ if eq $os "linux" -}}
    {{ $host_opt = index .my.modules .chezmoi.hostname $linux -}}
    {{ else -}}
    {{ $host_opt = index .my.modules .chezmoi.hostname $os -}}
    {{ end -}}

    {{ range .opt -}}
        {{ if hasKey $global_opt . -}}
        {{ $global_opt = index $global_opt . -}}
        {{ else -}}
        {{ fail (print $global_opt " unknow opt value: " .) -}}
        {{ end -}}
        {{ if hasKey $host_opt . -}}
        {{ $host_opt = index $host_opt . -}}
        {{ else -}}
        {{ $host_opt = dict -}}
        {{ end -}}
    {{ end -}}
{{ else -}}
{{ fail (print "unknow opt value: " .) -}}
{{ end -}}

{{ if not (kindIs "bool" $host_opt) -}}
{{ $final_opt = $global_opt -}}
{{ else -}}
{{ $final_opt = $host_opt -}}
{{ end -}}

{{ $cmd := true -}}
{{ if hasKey . "cmd" -}}
    {{ if kindIs "string" .cmd -}}
    {{ $cmd = lookPath .cmd }}
    {{ else if kindIs "slice" .cmd -}}
        {{ $cmd := list -}}
        {{ range .cmd -}}
        {{ $cmd = append $cmd (lookPath .) -}}
        {{ end -}}
    {{ $cmd = all $cmd -}}
    {{ end -}}
{{ end -}}

{{ $file := true -}}
{{ if hasKey . "file" -}}
    {{ if kindIs "string" .file -}}
    {{ $file = stat .file }}
    {{ else if kindIs "slice" .file -}}
        {{ $file := list -}}
        {{ range .file -}}
        {{ $file = append $file (stat .) -}}
        {{ end -}}
    {{ $file = all $file -}}
    {{ end -}}
{{ end -}}

{{ $final_os := list -}}
{{ if kindIs "string" .os -}}
{{ $final_os = eq $os .os -}}
{{ else if kindIs "slice" .os -}}
    {{ range .os -}}
    {{ $final_os = append $final_os (eq $os .) -}}
    {{ end -}}
{{ $final_os = any $final_os -}}
{{ end -}}

{{ if and $cmd $file $final_opt $final_os -}}
1
{{- else -}}
0
{{- end -}}
