{{ $os := .chezmoi.os -}}
{{ if eq .chezmoi.os "linux" -}}
{{ $os = .chezmoi.osRelease.id -}}
{{ end -}}
{{ $global_opt := "" -}}
{{ $host_opt := "" -}}
{{ $final_opt := "" -}}
{{ if kindIs "string" .opt -}}
{{ $global_opt = index .my.modules .opt -}}
{{ $host_opt = index .my.modules .chezmoi.hostname $os .opt -}}
{{ else if kindIs "slice" .opt -}}
{{ $global_opt = .my.modules -}}
{{ $host_opt = index .my.modules .chezmoi.hostname $os -}}
    {{ range .opt -}}
        {{ if hasKey $global_opt . -}}
        {{ $global_opt = index $global_opt . -}}
        {{ else -}}
        {{ fail (print $global_opt " unknow opt value: " .) -}}
        {{ end -}}
        {{ if hasKey $host_opt . -}}
        {{ $host_opt = index $host_opt . -}}
        {{ else -}}
        {{ $host_opt = dict -}}
        {{ end -}}
    {{ end -}}
{{ else -}}
{{ fail (print "unknow opt value: " .) -}}
{{ end -}}

{{ if not (kindIs "bool" $host_opt) -}}
{{ $final_opt = $global_opt -}}
{{ else -}}
{{ $final_opt = $host_opt -}}
{{ end -}}

{{ $cmd := list -}}
{{ if kindIs "string" .cmd -}}
{{ $cmd = or (lookPath .cmd) (stat .cmd) }}
{{ else if kindIs "slice" .cmd -}}
    {{ range .cmd -}}
    {{ $cmd = append $cmd (or (lookPath .) (stat .)) -}}
    {{ end -}}
{{ $cmd = all $cmd -}}
{{ end -}}
{{ if and $cmd $final_opt (eq $os .os) -}}
1
{{- else -}}
0
{{- end -}}
