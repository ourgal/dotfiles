"{{{ options
" yank highlight plugin
packadd! hlyank

" comment plugin
packadd! comment

" editorconfig plugin
packadd! editorconfig

" file picker
import 'find.vim'

" leader key
let g:mapleader = ' '

" close other buffers
nnoremap <leader>bo <cmd>%bd\|e#\|bd#<CR>

" save all and exit
nnoremap ZX <cmd>xa!<cr>

nmap <Enter> :

" center line when searching
" nnoremap n nzzzv
" nnoremap N Nzzzv

" file picker
nnoremap <leader><space> :find<space>

set laststatus=2 " always show status line

" tab to space
set expandtab
set smarttab

" highlight search
set incsearch
set hlsearch

set autoindent " indent besed on previous line

set wrap " wrap line

" Check if environment variable PREFIX contains com.termux
let g:is_android = !empty($PREFIX) && $PREFIX =~# 'com\.termux'

if g:is_android
    set clipboard=unnamedplus
else
    set clipboard=unnamed
endif

set nowritebackup

if has('gui_running')
    " disable toolbar
    set guioptions-=T
    " disable menu bar
    set guioptions-=m
    " number of colors
    set t_Co=256
    " tab label
    set guitablabel=%M\ %t
endif

syntax enable

" ignore case when searching
set ignorecase
set smartcase

set lazyredraw
set magic

set timeoutlen=500 " time for key sequence

set wildignore=*.o,*~,*.pyc
if has('win16') || has('win32')
    set wildignore+=.git\*,.hg\*,.svn\*
else
    set wildignore+=*/.git/*,*/.hg/*,*/.svn/*,*/.DS_Store
endif

" curso sharp
let &t_SI = "\e[6 q"
let &t_EI = "\e[2 q"

set hidden " hidden buffer

set history=500 " command history

set number relativenumber " line number

filetype plugin on
filetype indent on

set updatetime=500

" mouse support
set mouse=a
set smoothscroll

" 24-bit color TUI
set termguicolors

if executable('rg')
    set grepprg=rg\ --vimgrep\ --no-hidden\ --no-heading\
endif

set foldmethod=marker

set shortmess-=S " show she search count

set gdefault " substitute all matches

