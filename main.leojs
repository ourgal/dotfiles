  "tnodes": {
    "User.20260226221459.1": "# This is an example of a macro that you might use to execute a command.\n# This will add the command to history.\nSet-PSReadLineKeyHandler -Key Ctrl+g `\n                         -BriefDescription Lazygit `\n                         -LongDescription \"Run lazygit\" `\n                         -ScriptBlock {\n    [Microsoft.PowerShell.PSConsoleReadLine]::RevertLine()\n    [Microsoft.PowerShell.PSConsoleReadLine]::Insert(\"lazygit\")\n    [Microsoft.PowerShell.PSConsoleReadLine]::AcceptLine()\n}",
    "User.20260221180517.1": "{{ if and (eq .chezmoi.hostname \"nuc\") (lookPath \"runemacs\") -}}\n; Run(\"runemacs --daemon\", EnvGet(\"userprofile\"), \"Hide\")\n{{ end -}}\n",
    "zxc.20260203193056.1": "{{ if lookPath \"mcfly\" -}}\n# mcfly\nInvoke-Expression -Command $(mcfly init powershell | out-string)\n{{ end -}}",
    "zxc.20260316152403.1": "{{ $flow := joinPath .chezmoi.homeDir \"scoop\" \"apps\" \"flow-launcher\" \"current\" \"Flow.Launcher.exe\" -}}\n{{ if stat $flow -}}\nRun({{ $flow | quote }}, {{ .chezmoi.homeDir | quote }}, \"Hide\")\n{{ end -}}",
    "zxc.20260421204007.1": "{{ if stat (joinPath .chezmoi.homeDir \"scoop\" \"apps\" \"copyq\" \"current\" \"copyq.exe\") -}}\nSleep 45*1000\nRun(\"{{ joinPath .chezmoi.homeDir \"scoop\" \"apps\" \"copyq\" \"current\" \"copyq.exe\" }}\", {{ .chezmoi.homeDir | quote }}, \"Hide\")\n{{ end -}}",
    "zxc.20260421204018.1": "{{ if lookPath \"keepassxc\" -}}\nRun({{ joinPath .chezmoi.homeDir \"Documents\" \"autohotkey\" \"keepassxc.ahk\" | quote }}, , \"Hide\")\n{{ end -}}",
    "zxc.20260125142149.1": "@tabwidth 4\nall:\n\t@others\n",
    "zxc.20260125142255.1": "yes | git magic -ap\n",
    "zxc.20260515011023.1": "# see https://github.com/sigoden/aichat/blob/main/config.example.yaml\n",
    "zxc.20260603150605.1": "model: gemini:gemini-2.5-flash\nclients:\n  - type: gemini\n    api_key: {{ gopass \"AI/gemini\" }}\n",
