nt \"filter \" (\"lfs\" | quote)) (dict \"clean\" \"git-lfs clean -- %f\" \"process\" \"git-lfs filter-process\" \"required\" true \"smudge\" \"git-lfs smudge -- %f\") -}}\n\n{{ if .my.git.sign.ssh -}}\n{{ $cfg = set $cfg \"gpg\" (dict \"format\" \"ssh\") -}}\n{{ if eq .chezmoi.os \"windows\" -}}\n{{ $cfg = set $cfg (print \"gpg \" (\"ssh\" | quote)) (dict \"program\" (lookPath \"ssh-keygen\" | replace \"\\\\\" \"\\\\\" | quote)) -}}\n{{ end -}}\n{{ end -}}\n\n{{ if .my.git.sign.gpg -}}\n{{ $cfg = set $cfg \"gpg\" (dict \"program\" (lookPath \"gpg\" | quote)) -}}\n{{ end -}}\n\n{{ $cfg = set $cfg \"help\" (dict \"autocorrect\" \"prompt\") -}}\n\n{{ $cfg = set $cfg \"init\" (dict \"defaultBranch\" \"main\") -}}\n\n{{ $cfg = set $cfg \"interactive\" (dict \"diffFilter\" \"diff-so-fancy --patch\" \"singlekey\" true) -}}\n\n{{ $cfg = set $cfg \"interactive-rebase-tool\" (dict \"inputMoveDown\" \"Down j\" \"inputMoveSelectionDown\" \"l\" \"inputMoveSelectionUp\" \"h\" \"inputMoveUp\" \"Up k\" \"inputRedo\" \"Control+r\" \"inputUndo\" \"u\") -}}\n\n{{ $cfg = set $cfg \"log\" (dict \"abbrevCommit\" true \"graphColors\" \"blue,yellow,cyan,magenta,green,red\") -}}\n\n{{ $cfg = set $cfg (print \"merge \" (\"core\" | quote)) (dict \"attributesfile\" \"~/.gitattributes\") -}}\n\n{{ $cfg = set $cfg \"pull\" (dict \"default\" \"current\" \"rebase\" true) -}}\n\n{{ $cfg = set $cfg \"push\" (dict \"autoSetupRemote\" true \"default\" \"current\" \"followTags\" true \"useForceIfIncludes\" true) -}}\n\n{{ $cfg = set $cfg \"rebase\" (dict \"autoSquash\" true \"autoStash\" true \"missingCommitsCheck\" \"warn\" \"updateRefs\" true) -}}\n\n{{ $cfg = set $cfg \"rerere\" (dict \"autoupdate\" true \"enabled\" true) -}}\n\n{{ if eq .chezmoi.os \"windows\" -}}\n{{ $cfg = set $cfg \"safe\" (dict \"directory\" \"*\") -}}\n{{ end -}}\n\n{{ $cfg = set $cfg \"sequence\" (dict \"editor\" \"interactive-rebase-tool\") -}}\n\n{{ $cfg = set $cfg \"status\" (dict \"branch\" true \"showStash\" true \"showUntrackedFiles\" \"all\") -}}\n\n{{ $cfg = set $cfg \"tag\" (dict \"sort\" \"version:refname\") -}}\n\n{{ $cfg = set $cfg (print \"url \" (\"ssh://192.168.123.206:23231/\" | quote)) (dict \"insteadOf\" \"soft:\") -}}\n\n{{ $cfg = set $cfg (print \"url \" (\"git@github.com:ourgal/\" | quote)) (dict \"insteadOf\" \"myg:\") -}}\n\n{{ $cfg = set $cfg (print \"url \" (\"git@github.com:\" | quote)) (dict \"insteadOf\" \"gh:\") -}}\n\n{{ $_ = dict -}}\n{{ $_ = set $_ \"email\" .my.git.user.email -}}\n{{ $_ = set $_ \"name\" .my.git.user.name -}}\n\t{{ if .my.git.sign.ssh -}}\n\t{{ $_ = set $_ \"signingkey\" \"~/.ssh/id_ed25519.pub\" -}}\n\t{{ else if .my.git.sign.gpg -}}\n\t{{ $_ = set $_ \"signingkey\" \"1BE4E2268D47C1D1\" -}}\n\t{{ end -}}\n{{ $cfg = set $cfg \"user\" $_ -}}\n\n{{ $cfg = set $cfg (print \"annex \" (\"security\" | quote)) (dict \"allowed-ip-addresses\" \"all\") -}}\n\n{{ $cfg = set $cfg \"git-extras\" (dict \"default-branch\" $cfg.init.defaultBranch \"get\" (dict \"clone-path\" \"~/src\")) -}}\n\n{{ $cfg = set $cfg \"merge\" (dict \"conflictstyle\" \"zdiff3\") -}}\n",
