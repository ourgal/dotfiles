    "zxc.20260201225513.1": "[core]\nscreenName=nuc\nlastVersion=1.25.0.0\ncoreMode=1\nport=24800\npreventSleep=false\nlanguage=English\nwlClipboard=false\nprocessMode=1\ncomputerName=nuc\n\n[internalConfig]\nnumColumns=5\nnumRows=3\nhasHeartbeat=false\nheartbeat=5000\nprotocol=1\nrelativeMouseMoves=false\nwin32KeepForeground=false\nhasSwitchDelay=false\nswitchDelay=250\nhasSwitchDoubleTap=false\nswitchDoubleTap=250\nswitchCornerSize=0\ndisableLockToScreen=false\nclipboardSharing=true\nclipboardSharingSize=3072\nswitchCornerArray\\1\\switchCorner=false\nswitchCornerArray\\2\\switchCorner=false\nswitchCornerArray\\3\\switchCorner=false\nswitchCornerArray\\4\\switchCorner=false\nswitchCornerArray\\size=4\nscreens\\1\\name=\nscreens\\2\\name=\nscreens\\3\\name=\nscreens\\4\\name=\nscreens\\5\\name=\nscreens\\6\\name=\nscreens\\7\\name=\nscreens\\8\\name=\nscreens\\9\\name=\nscreens\\10\\name=\nscreens\\11\\name=\nscreens\\12\\name=\nscreens\\13\\name=\nscreens\\14\\name=\nscreens\\15\\name=\nscreens\\size=15\nhotkeys\\size=0\n\n[gui]\nlogExpanded=true\nenableUpdateCheck=false\nautoHide=true\ncloseToTray=true\nsymbolicTrayIcon=true\ncloseReminder=false\n\n[log]\nlevel=4\ntoFile=false\nfile=C:/Users/User/deskflow.log\nguiDebug=false\n\n[daemon]\nelevate=false\n\n[security]\ncertificate=C:/Users/User/scoop/apps/deskflow/current/settings/tls/deskflow.pem\nkeySize=2048\ntlsEnabled=true\ncheckPeerFingerprints=true\n\n[client]\nlanguageSync=true\nremoteHost=home.local",
    "zxc.20260317083115.1": "{{ if eq .chezmoi.hostname \"work\" -}}\n@others\n{{ end -}}\n",
    "zxc.20260317082956.1": "section: screens\n\toffice2043:\n\t\thalfDuplexCapsLock = false\n\t\thalfDuplexNumLock = false\n\t\thalfDuplexScrollLock = false\n\t\txtestIsXineramaUnaware = false\n\t\tswitchCorners = none\n\t\tswitchCornerSize = 0\n\twork:\n\t\thalfDuplexCapsLock = false\n\t\thalfDuplexNumLock = false\n\t\thalfDuplexScrollLock = false\n\t\txtestIsXineramaUnaware = false\n\t\tswitchCorners = none\n\t\tswitchCornerSize = 0\nend\n\nsection: aliases\nend\n\nsection: links\n\toffice2043:\n\t\tleft = work\n\twork:\n\t\tright = office2043\nend\n\nsection: options\n\tprotocol = barrier\n\trelativeMouseMoves = false\n\twin32KeepForeground = false\n\tdefaultLockToScreenState = false\n\tdisableLockToScreen = false\n\tclipboardSharing = true\n\tclipboardSharingSize = 3072\n\tswitchCorners = none \n\tswitchCornerSize = 0\nend\n",
    "User.20260222022952.1": "[terminal]\nshell = \"pwsh\"",
    "zxc.20260130233158.1": "[window]\nopacity = 0.9",
    "zxc.20260130233313.1": "[font]\nsize = 12",
    "zxc.20260130233323.1": "[font.normal]\nfamily = {{ .my.font.monospace | quote }}\nstyle = \"Regular\"",
    "zxc.20260408012432.1": "<< dos >>\n{{ if lookPath \"wezterm\" -}}\n@others\n{{ end -}}\n{{ end -}}\n",
    "zxc.20260408012435.1": "-- Pull in the wezterm API\nlocal wezterm = require(\"wezterm\")\n\n-- This will hold the configuration.\nlocal config = wezterm.config_builder()\n\n-- This is where you actually apply your config choices.\n\n",
    "zxc.20260408102229.1": "-- For example, changing the initial geometry for new windows:\nconfig.initial_cols = 120\nconfig.initial_rows = 28\n",
    "zxc.20260408102316.1": "-- or, changing the font size and color scheme.\nconfig.font_size = 12\nconfig.font = wezterm.font '{{ .my.font.monospace }}'\n",
    "zxc.20260408102354.1": "local launch_menu = {}\n\nif wezterm.target_triple == \"x86_64-pc-windows-msvc\" then\n  table.insert(launch_menu, {\n    label = \"PowerShell\",\n    args = { \"powershell.exe\", \"-NoLogo\" },\n  })\n  table.insert(launch_menu, {\n    label = \"Powershell Core\",\n    args = { \"pwsh.exe\" },\n  })\nend\n\nconfig.launch_menu = launch_menu\n",
    "zxc.20260408102438.1": "config.window_background_opacity = 0.9\n",
    "zxc.20260408102453.1": "config.window_decorations = \"RESIZE\"\n",
    "zxc.20260409142718.1": "config.default_prog = { '{{ .my.shell.windows }}' }\n",
    "zxc.20260408102617.1": "return config\n",
    "zxc.20260201142202.1": "{\n    \"$help\": \"https://aka.ms/terminal-documentation\",\n    \"$schema\": \"https://aka.ms/terminal-profiles-schema\",\n    \"actions\": [],\n    \"copyFormatting\": \"none\",\n    \"copyOnSelect\": false,\n    \"defaultProfile\": \"{0caa0dad-35be-5f56-a8ff-afceeeaa6101}\",\n    \"keybindings\":\n    [\n        {\n            \"id\": \"Terminal.CopyToClipboard\",\n            \"keys\": \"ctrl+c\"\n        },\n        {\n            \"id\": \"Terminal.PasteFromClipboard\",\n            \"keys\": \"ctrl+v\"\n        },\n        {\n            \"id\": \"Terminal.DuplicatePaneAuto\",\n            \"keys\": \"alt+shift+d\"\n        }\n    ],\n    \"newTabMenu\":\n    [\n        {\n            \"type\": \"remainingProfiles\"\n        }\n    ],\n    \"profiles\":\n    {\n        \"defaults\": {},\n        \"list\":\n        [\n            {\n                \"guid\": \"{574e775e-4f2a-5b96-ac1e-a2962a402336}\",\n                << common >>\n                \"name\": \"PowerShell\",\n                \"source\": \"Windows.Terminal.PowershellCore\"\n            },\n            {\n                \"commandline\": \"%SystemRoot%\\\\System32\\\\cmd.exe\",\n                << common >>\n                \"guid\": \"{0caa0dad-35be-5f56-a8ff-afceeeaa6101}\",\n                \"name\": \"Command Prompt\"\n            },\n            {\n                \"commandline\": \"%SystemRoot%\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\",\n                << common >>\n                \"guid\": \"{61c54bbd-c2c6-5271-96e7-009a87ff44bf}\",\n                \"name\": \"Windows PowerShell\"\n            },\n            {\n                \"commandline\": \"%USERPROFILE%\\\\.local\\\\bin\\\\xonsh.exe\",\n                << common >>\n                \"guid\": \"{1039824d-f5da-468d-856d-d7373d40325e}\",\n                \"name\": \"Xonsh\"\n            },\n            {\n                \"commandline\": \"%USERPROFILE%\\\\scoop\\\\apps\\\\git\\\\current\\\\bin\\\\bash.exe -i -l\",\n                << common >>\n                \"guid\": \"{8f5e00bb-5ac4-4e63-8538-5bcbbf827559}\",\n                \"name\": \"Git Bash\"\n            },\n            {\n                \"commandline\": \"%USERPROFILE%\\\\scoop\\\\shims\\\\msys2.cmd -use-full-path -shell fish\",\n                << common >>\n                \"guid\": \"{f60ba69c-a957-410c-a1c6-8b7484ee591c}\",\n                \"name\": \"MSYS\"\n            },\n            {\n                \"commandline\": \"%USERPROFILE%\\\\scoop\\\\shims\\\\nu.exe\",\n                << common >>\n                \"guid\": \"{2a38cb46-e594-415f-9cce-1e3d1b313ee9}\",\n                \"name\": \"Nu shell\"\n            },\n            {\n                \"commandline\": \"%USERPROFILE%\\\\scoop\\\\shims\\\\yori.exe\",\n                << common >>\n                \"guid\": \"{90a23420-d58c-4627-9e4d-6ab897661ef7}\",\n                \"name\": \"Yori\"\n            },\n            {\n                << common >>\n                \"guid\": \"{c0d3ee5c-ec30-5776-a372-7005244e2d95}\",\n                \"name\": \"Debian\",\n                \"source\": \"Microsoft.WSL\"\n            },\n            {\n                \"guid\": \"{b453ae62-4e3d-5e58-b989-0a998ec441b8}\",\n                << common >>\n                \"name\": \"Azure Cloud Shell\",\n                \"source\": \"Windows.Terminal.Azure\"\n            }\n        ]\n    },\n    \"schemes\": [],\n    \"themes\": []\n}\n\n",
    "zxc.20260201034404.1": "\"cursorShape\": \"filledBox\",\n\"font\": \n{\n    \"face\": \"{{ .my.font.monospace }}\"\n},\n\"startingDirectory\": \"%USERPROFILE%\",\n\"opacity\": 90,\n\"hidden\": false,\n\"closeOnExit\": \"graceful\",",
    "User.20260216125349.1": "patch:\n  schema_list:\n    - schema: sbfm\n  \"switcher/hotkeys\":",
    "User.20260216125513.1": "patch:\n  switches:\n    - name: ascii_mode\n      reset: 1\n      states: [中文, 西文]\n    - name: ascii_punct\n      reset: 0\n      states: [。，, ．，]\n    - name: zh_trad\n      reset: 0\n      states: [简体, 繁体]\n    - name: is_enhanced\n      reset: 0\n      states: [常规, 增强]\n    - options: [hide, rational, irrational, both]\n      reset: 1\n      states: [隐藏, 有理, 无理, 两者]\n    # 希望在同文里用下三角来隐藏键盘的可去掉下面两行的注释\n    #- options: [_key_Hide]\n    #  states: [\"▼\"]\n    # 为了避免拥挤，不显示下面的状态\n    - name: auto_inline\n      reset: 1\n    - name: is_buffered\n      reset: 0\n    - name: single_display\n      reset: 0\n    - options: [pro_word, pro_char, delayed_pop]\n      reset: 0\n    # states: [词组, 单字, 延顶]\n    - name: show_es\n      reset: 1\n    # 不要改变下面的状态，以免穿帮\n    - name: third_pop\n      reset: 0\n    - name: fast_pop\n      reset: 0\n  key_binder:\n    import_preset: sbxlm\n    bindings:\n      - accept: Shift+space\n        toggle: ascii_mode\n        when: always\n  ascii_composer:\n    good_old_caps_lock: false\n    switch_key:\n      Caps_Lock: noop\n      Control_L: noop\n      Control_R: noop\n      Eisu_toggle: noop\n      Shift_L: noop\n      Shift_R: noop",
    "User.20260221175721.1": "- replace: '{{ `{{` }}mydate{{ `}}` }}'\n  trigger: :date\n  vars:\n  - name: mydate\n    params:\n      format: '%m/%d/%Y'\n    type: date",
    "User.20260221175729.1": "- replace: '{{ `{{` }}mydate{{ `}}` }}'\n  trigger: :time\n  vars:\n  - name: mydate\n    params:\n      format: '%H:%M'\n    type: date",
    "User.20260221175844.1": "- replace: https://github.com/{{ `{{` }}clipboard{{ `}}` }}\n  trigger: :gh\n  vars:\n  - name: clipboard\n    type: clipboard\n",
    "User.20260221175819.1": "- replace: 'git init '\n  trigger: giti.\n- replace: 'git clone '\n  trigger: gitcl.\n- replace: 'git clone --depth 1 '\n  trigger: gitcl1.\n- replace: git config --global core.autocrlf true\n  trigger: gitconfigline1.\n- replace: git config --global core.safecrlf warn\n  trigger: gitconfigline2.\n- replace: git config --global user.email \"$|$\"\n  trigger: gitemailg.\n- replace: git config --local user.email \"$|$\"\n  trigger: gitemaill.\n- replace: git config --global user.name \"$|$\"\n  trigger: gituserg.\n- replace: git config --local user.name \"$|$\"\n  trigger: gituserl.\n- replace: git status\n  trigger: gits.\n- replace: git add .\n  trigger: gita.\n- replace: git commit -m \"$|$\"\n  trigger: gitc.\n- replace: 'git add . && git commit -m \"feat: $|$\"'\n  trigger: gitcf.\n- replace: 'git add . && git commit -m \"chore: $|$\"'\n  trigger: gitcc.\n- replace: 'git add . && git commit -m \"fix: $|$\"'\n  trigger: gitcx.\n- replace: 'git add . && git commit -m \"docs: $|$\"'\n  trigger: gitcd.\n- replace: 'git add . && git commit -m \"refactor: $|$\"'\n  trigger: gitcr.\n- replace: 'git add . && git commit -m \"style: $|$\"'\n  trigger: gitcs.\n- replace: 'git add . && git commit -m \"test: $|$\"'\n  trigger: gitct.\n- replace: git commit --amend -m \"$|$\"\n  trigger: gitamc.\n- replace: git commit --amend -m \"$|$\"\n  trigger: gitcam.\n- replace: git commit --amend --no-edit\n  trigger: gitce.\n- replace: git commit --amend --author=\"$|$User Name <email@email.com>\"\n  trigger: gitama.\n- replace: '#Examples: \"2023-02-14T15:55:00\" | \"Wed Sep 9 22:00 2020 +0530\"\n\n    git commit --amend --date=\"\"'\n  trigger: gitamd.\n- replace: 'git push origin '\n  trigger: gitp.\n- replace: 'git push github '\n  trigger: gitpg.\n- replace: 'git push origin --force '\n  trigger: gitpf.\n- replace: git remote update\n  trigger: gitru.\n- replace: git fetch --all\n  trigger: gitfa.\n- replace: git push origin develop\n  trigger: gitpd.\n- replace: git push origin dev\n  trigger: gitpd1.\n- replace: git push origin develop\n  trigger: gitpd2.\n- replace: git push origin development\n  trigger: gitpd3.\n- replace: git push origin homolog\n  trigger: gitph.\n- replace: git push origin hml\n  trigger: gitph1.\n- replace: git push origin homolog\n  trigger: gitph2.\n- replace: git push origin homologation\n  trigger: gitph3.\n- replace: 'git pull origin '\n  trigger: gitu.\n- replace: git pull origin develop\n  trigger: gitud.\n- replace: git pull origin dev\n  trigger: gitud1.\n- replace: git pull origin develop\n  trigger: gitud2.\n- replace: git pull origin development\n  trigger: gitud3.\n- replace: git pull origin homolog\n  trigger: gituh.\n- replace: git pull origin hml\n  trigger: gituh1.\n- replace: git pull origin homolog\n  trigger: gituh2.\n- replace: git pull origin homologation\n  trigger: gituh3.\n- replace: git stash\n  trigger: gitst.\n- replace: git stash list\n  trigger: gitstl.\n- replace: git stash show\n  trigger: gitsts.\n- replace: git stash pop\n  trigger: gitstp.\n- replace: git stash drop\n  trigger: gitstd.\n- replace: git stash --include-untracked\n  trigger: gitstiu.\n- replace: 'git merge '\n  trigger: gitm.\n- replace: git branch -m main\n  trigger: gitbm.\n- replace: git merge develop\n  trigger: gitmd.\n- replace: git merge dev\n  trigger: gitmd1.\n- replace: git merge develop\n  trigger: gitmd2.\n- replace: git merge development\n  trigger: gitmd3.\n- replace: git merge homolog\n  trigger: gitmh.\n- replace: git merge hml\n  trigger: gitmh1.\n- replace: git merge homolog\n  trigger: gitmh2.\n- replace: git merge homologation\n  trigger: gitmh3.\n- replace: 'git checkout '\n  trigger: gitchk.\n- replace: git checkout develop\n  trigger: gitchkd.\n- replace: git checkout dev\n  trigger: gitchkd1.\n- replace: git checkout develop\n  trigger: gitchkd2.\n- replace: git checkout development\n  trigger: gitchkd3.\n- replace: git checkout homolog\n  trigger: gitchkh.\n- replace: git checkout hml\n  trigger: gitchkh1.\n- replace: git checkout homolog\n  trigger: gitchkh2.\n- replace: git checkout homologation\n  trigger: gitchkh3.\n- replace: 'git checkout -b '\n  trigger: gitchkb.\n- replace: 'git checkout -b '\n  trigger: gitnb.\n- replace: git branch\n  trigger: gitb.\n- replace: git branch -a\n  trigger: gitba.\n- replace: 'git branch -d '\n  trigger: gitbd.\n- replace: 'git branch -D '\n  trigger: gitbdf.\n- replace: 'git push origin --delete '\n  trigger: gitbdr.\n- replace: git log\n  trigger: gitl.\n- replace: git log --pretty=oneline\n  trigger: gitlp.\n- replace: git log --oneline\n  trigger: gitlo.\n- replace: git log --graph --oneline\n  trigger: gitlgo.\n- replace: git log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short\n  trigger: gitlpf.\n- replace: git rebase main\n  trigger: gitrb.\n- replace: git rebase -i --autosquash main\n  trigger: gitrba.\n- replace: git reset\n  trigger: gitrs.\n- replace: 'git reset --hard '\n  trigger: gitrsh.\n- replace: git reset --hard HEAD\n  trigger: gitrshh.\n- replace: git reset --hard HEAD~1\n  trigger: gitrshh1.\n- replace: 'git reset --soft '\n  trigger: gitrss.\n- replace: git reset --soft HEAD\n  trigger: gitrssh.\n- replace: git reset --soft HEAD~1\n  trigger: gitrssh1.\n- replace: git revert HEAD\n  trigger: gitrv.\n- replace: git revert HEAD --no-edit\n  trigger: gitrvne.\n- replace: 'git tag '\n  trigger: gittg.\n- replace: 'git tag -d '\n  trigger: gittgd.\n- replace: git mv file.ext dir_name\n  trigger: gitmv.\n- replace: 'git cherry-pick '\n  trigger: gitcyp.\n- replace: git restore .\n  trigger: gitrt.\n- replace: git clean -f\n  trigger: gitcln.\n- replace: 'git switch '\n  trigger: gitsw.\n- replace: git switch main\n  trigger: gitswm.",
    "User.20260222165839.1": "- replace: 'git annex sync '\n  trigger: gitas.\n- replace: 'git annex add '\n  trigger: gitaa.\n- replace: 'git annex get '\n  trigger: gitag.\n- replace: 'git annex drop '\n  trigger: gitad.\n- replace: 'git annex move '\n  trigger: gitam.\n- replace: 'git annex copy '\n  trigger: gitac.\n- replace: 'git annex fsck '\n  trigger: gitaf.\n- replace: 'git annex whereis '\n  trigger: gitaw.",
    "User.20260221175941.1": "- force_clipboard: true\n  label: Markdown - Code block\n  replace: '```$|$\n\n    ```'\n  trigger: ':block:'\n- force_clipboard: false\n  label: Markdown - Inline code\n  replace: '`$|$`'\n  trigger: ':code:'\n- label: Markdown - Header1\n  replace: '#'\n  trigger: ':h1:'\n- label: Markdown - Header2\n  replace: '##'\n  trigger: ':h2:'\n- label: Markdown - Header3\n  replace: '###'\n  trigger: ':h3:'\n- label: Markdown - Header4\n  replace: '####'\n  trigger: ':h4:'\n- label: Markdown - Header5\n  replace: '#####'\n  trigger: ':h5:'\n- label: Markdown - Header6\n  replace: '######'\n  trigger: ':h6:'\n- label: Markdown - Bold\n  replace: '**$|$**'\n  trigger: ':bold:'\n- label: Markdown - Italic\n  replace: '*$|$*'\n  trigger: ':italic:'\n- label: Markdown - Strikethrough\n  replace: ~~$|$~~\n  trigger: ':strike:'\n- label: Markdown - URL\n  replace: '[$|$]()'\n  trigger: ':url:'\n- label: Markdown - Image\n  replace: '![]($|$)'\n  trigger: ':img:'\n- label: Markdown - Horizontal line\n  replace: ___\n  trigger: ':horizontal:'\n- label: Markdown - Task\n  replace: '- [ ] '\n  trigger: ':task:'\n- label: Markdown - Task completed\n  replace: '- [x] '\n  trigger: ':taskdone:'\n- force_clipboard: true\n  label: Markdown - Collapse block\n  replace: '<details>\n\n    <summary></summary>\n\n    $|$\n\n    </details>'\n  trigger: ':collapse:'\n- force_clipboard: true\n  label: Markdown - Comment\n  replace: <!--- $|$ -->\n  trigger: ':comment:'",
    "User.20260223181103.1": "{{ template \"espanso_email.key\" }}",
    "User.20260301202336.1": "<< dos >>\n@language yaml\n@tabwidth -2\n{{ if lookPath \"glazewm\" -}}\n@others\n{{ end -}}\n{{ end -}}\n",
    "User.20260301203034.1": "general:\n  # Commands to run when the WM has started. This is useful for running a\n  # script or launching another application.\n  # Example: The below command launches Zebar.\n  startup_commands: []\n  # Commands to run just before the WM is shutdown.\n  # Example: The below command kills Zebar.\n  shutdown_commands: []\n  # Commands to run after the WM config is reloaded.\n  config_reload_commands: []\n  # Whether to automatically focus windows underneath the cursor.\n  focus_follows_cursor: false\n  # Whether to switch back and forth between the previously focused\n  # workspace when focusing the current workspace.\n  toggle_workspace_on_refocus: false\n  cursor_jump:\n    # Whether to automatically move the cursor on the specified trigger.\n    enabled: true\n    # Trigger for cursor jump:\n    # - 'monitor_focus': Jump when focus changes between monitors.\n    # - 'window_focus': Jump when focus changes between windows.\n    trigger: 'monitor_focus'\n  # How windows should be hidden when switching workspaces.\n  # - 'cloak': Recommended. Hides windows with no animation.\n  # - 'hide': Legacy method (v3.5 and earlier) that has a brief animation,\n  # but has stability issues with some apps.\n  hide_method: 'cloak'\n  # Affects which windows get shown in the native Windows taskbar. Has no\n  # effect if `hide_method: 'hide'`.\n  # - 'true': Show all windows (regardless of workspace).\n  # - 'false': Only show windows from the currently shown workspaces.\n  show_all_in_taskbar: false\n",
    "User.20260301203056.1": "gaps:\n  # Whether to scale the gaps with the DPI of the monitor.\n  scale_with_dpi: true\n  # Gap between adjacent windows.\n  inner_gap: '0px'\n  # Gap between windows and the screen edge.\n  outer_gap:\n    top: '2px'\n    right: '2px'\n    bottom: '2px'\n    left: '2px'\n",
    "User.20260301203247.1": "window_effects:\n  # Visual effects to apply to the focused window.\n  focused_window:\n    # Highlight the window with a colored border.\n    # ** Exclusive to Windows 11 due to API limitations.\n    border:\n      enabled: true\n      color: '#8dbcff'\n    # Remove the title bar from the window's frame. Note that this can\n    # cause rendering issues for some applications.\n    hide_title_bar:\n      enabled: false\n    # Change the corner style of the window's frame.\n    # ** Exclusive to Windows 11 due to API limitations.\n    corner_style:\n      enabled: false\n      # Allowed values: 'square', 'rounded', 'small_rounded'.\n\n      style: 'square'\n    # Change the transparency of the window.\n    transparency:\n      enabled: false\n      # Can be something like '95%' or '0.95' for slightly transparent windows.\n\n      # '0' or '0%' is fully transparent (and, by consequence, unfocusable).\n      opacity: '95%'\n  # Visual effects to apply to non-focused windows.\n  other_windows:\n    border:\n      enabled: true\n      color: '#a1a1a1'\n    hide_title_bar:\n      enabled: false\n    corner_style:\n      enabled: false\n      style: 'square'\n    transparency:\n      enabled: false\n      opacity: '0%'\n",
    "User.20260301203431.1": "window_behavior:\n  # New windows are created in this state whenever possible.\n  # Allowed values: 'tiling', 'floating'.\n  initial_state: 'tiling'\n  # Sets the default options for when a new window is created. This also\n  # changes the defaults for when the state change commands, like\n  # `set-floating`, are used without any flags.\n  state_defaults:\n    floating:\n      # Whether to center floating windows by default.\n      centered: true\n      # Whether to show floating windows as always on top.\n      shown_on_top: false\n    fullscreen:\n      # Maximize the window if possible. If the window doesn't have a\n      # maximize button, then it'll be fullscreen'ed normally instead.\n      maximized: false\n      # Whether to show fullscreen windows as always on top.\n      shown_on_top: false\n",
    "User.20260301203458.1": "workspaces:\n  - name: '1'\n  - name: '2'\n  - name: '3'\n  - name: '4'\n  - name: '5'\n  - name: '6'\n  - name: '7'\n  - name: '8'\n  - name: '9'\n",
    "User.20260301203526.1": "window_rules:\n  @others",
    "User.20260301211002.1": "@others",
    "zxc.20260514061140.1": "@\n- commands: [\"move --workspace 1\"]\n  match:\n    - window_process: { regex: \"WindowsTerminal\" }\n    - window_process: { regex: \"wt\" }\n    - window_process: { regex: \"wezterm-gui\" }\n@c\n",
    "zxc.20260514061122.1": "@\n- commands: [\"move --workspace 2\"]\n  match:\n    - window_process: { regex: \"firefox\" }\n- commands: [\"move --workspace 2\"]\n  match:\n    - window_process: { regex: \"brave\" }\n@c\n",
    "zxc.20260601141629.1": "@\n- commands: [\"move --workspace 3\"]\n  match:\n    - window_process: { regex: \"emacs\" }\n@c\n",
    "zxc.20260502020122.1": "{{ if includeTemplate \"opt\" (dict \"chezmoi\" .chezmoi \"my\" .my \"cmd\" \"vscodium\" \"opt\" (list \"windows\" \"startup\" \"vscodium\" \"enable\") \"os\" \"windows\") | trim | atoi -}}\n@\n- commands: [\"move --workspace 3\"]\n  match:\n    - window_process: { regex: \"VSCodium\" }\n@c\n{{ end -}}\n",
    "zxc.20260502020009.1": "{{ if includeTemplate \"opt\" (dict \"chezmoi\" .chezmoi \"my\" .my \"cmd\" \"code\" \"opt\" (list \"windows\" \"startup\" \"vscode\" \"enable\") \"os\" \"windows\") | trim | atoi -}}\n@\n- commands: [\"move --workspace 3\"]\n  match:\n    - window_process: { regex: \"Code\" }\n@c\n{{ end -}}\n",
    "zxc.20260502020153.1": "{{ if includeTemplate \"opt\" (dict \"chezmoi\" .chezmoi \"my\" .my \"cmd\" \"leo\" \"opt\" (list \"windows\" \"startup\" \"leo\" \"enable\") \"os\" \"windows\") | trim | atoi -}}\n@\n- commands: [\"move --workspace 3\"]\n  match:\n    - window_process: { regex: \"leo\" }\n@c\n{{ end -}}\n",
    "zxc.20260514061202.1": "- commands: [\"move --workspace 9\"]\n  match:\n    - window_process: { regex: \"KeePassXC\" }",
    "User.20260301210952.1": "- commands: ['ignore']\n  match:\n    # Ignores any Zebar windows.\n    - window_process: {equals: 'zebar'}\n    # Ignores picture-in-picture windows for browsers.\n    - window_title: {regex: '[Pp]icture.in.[Pp]icture'}\n      window_class: {regex: 'Chrome_WidgetWin_1|MozillaDialogClass'}\n    # Ignore rules for various 3rd-party apps.\n    - window_process: {equals: 'PowerToys'}\n      window_class: {regex: 'HwndWrapper\\[PowerToys\\.PowerAccent.*?\\]'}\n    - window_process: {equals: 'PowerToys'}\n      window_title: {regex: '.*? - Peek'}\n    - window_process: {equals: 'Lively'}\n      window_class: {regex: 'HwndWrapper'}\n    - window_process: {equals: 'EXCEL'}\n      window_class: {not_regex: 'XLMAIN'}\n    - window_process: {equals: 'WINWORD'}\n      window_class: {not_regex: 'OpusApp'}\n    - window_process: {equals: 'POWERPNT'}\n      window_class: {not_regex: 'PPTFrameClass'}\n",
    "User.20260301222626.1": "- commands: [\"set-floating\"]\n  match:\n    - window_process: { equals: \"Flow.Launcher\" }\n      window_title: { equals: \"Settings\" }",
    "User.20260301203613.1": "binding_modes:\n  # When enabled, the focused window can be resized via arrow keys or HJKL.\n  - name: 'resize'\n    keybindings:\n      - commands: ['resize --width -2%']\n        bindings: ['h', 'left']\n      - commands: ['resize --width +2%']\n        bindings: ['l', 'right']\n      - commands: ['resize --height +2%']\n        bindings: ['k', 'up']\n      - commands: ['resize --height -2%']\n        bindings: ['j', 'down']\n      - commands: ['wm-disable-binding-mode --name resize']\n        # Press enter/escape to return to default keybindings.\n        bindings: ['escape', 'enter']\n",
    "User.20260301203644.1": "keybindings:\n  # Shift focus in a given direction.\n  - commands: ['focus --direction left']\n    bindings: ['f24+h', 'f24+left']\n  - commands: ['focus --direction right']\n    bindings: ['f24+l', 'f24+right']\n  - commands: ['focus --direction up']\n    bindings: ['f24+k', 'f24+up']\n  - commands: ['focus --direction down']\n    bindings: ['f24+j', 'f24+down']\n  # Move focused window in a given direction.\n  - commands: ['move --direction left']\n    bindings: ['f24+shift+h', 'f24+shift+left']\n  - commands: ['move --direction right']\n    bindings: ['f24+shift+l', 'f24+shift+right']\n  - commands: ['move --direction up']\n    bindings: ['f24+shift+k', 'f24+shift+up']\n  - commands: ['move --direction down']\n    bindings: ['f24+shift+j', 'f24+shift+down']\n  # Resize focused window by a percentage or pixel amount.\n  - commands: ['resize --width -2%']\n    bindings: ['f24+u']\n  - commands: ['resize --width +2%']\n    bindings: ['f24+p']\n  - commands: ['resize --height +2%']\n    bindings: ['f24+o']\n  - commands: ['resize --height -2%']\n    bindings: ['f24+i']\n  # As an f24ernative to the resize keybindings above, resize mode enables\n  # resizing via arrow keys or HJKL. The binding mode is defined above with\n  # the name 'resize'.\n  - commands: ['wm-enable-binding-mode --name resize']\n    bindings: ['f24+r']\n  # Disables window management and all other keybindings until f24+shift+p\n  # is pressed again.\n  - commands: ['wm-toggle-pause']\n    bindings: ['f24+shift+p']\n  # Change tiling direction. This determines where new tiling windows will\n  # be inserted.\n  - commands: ['toggle-tiling-direction']\n    bindings: ['f24+v']\n  # Change focus from tiling windows -> floating -> fullscreen.\n  - commands: ['wm-cycle-focus']\n    bindings: ['f24+space']\n  # Change the focused window to be floating.\n  - commands: ['toggle-floating --centered']\n    bindings: ['f24+shift+space']\n  # Change the focused window to be tiling.\n  - commands: ['toggle-tiling']\n    bindings: ['f24+t']\n  # Change the focused window to be fullscreen.\n  - commands: ['toggle-fullscreen']\n    bindings: ['f24+f']\n  # Minimize focused window.\n  - commands: ['toggle-minimized']\n    bindings: ['f24+m']\n  # Close focused window.\n  - commands: ['close']\n    bindings: ['f24+shift+c']\n  # Kill GlazeWM process safely.\n  - commands: ['wm-exit']\n    bindings: ['f24+shift+e']\n  # Re-evaluate configuration file.\n  - commands: ['wm-reload-config']\n    bindings: ['f24+shift+r']\n  # Redraw all windows.\n  - commands: ['wm-redraw']\n    bindings: ['f24+shift+w']\n  - commands: ['shell-exec {{ if lookPath \"flameshot\" }}flameshot gui{{ else }}explorer ms-screenclip:{{ end }}']\n    bindings: ['f24+q']\n  # Launch CMD terminal. natively, use `shell-exec wt` or\n  # `shell-exec %ProgramFiles%/Git/git-bash.exe` to start Windows\n  # Terminal and Git Bash respectively.\n  - commands: ['shell-exec {{ if eq .my.terminal.windows \"wezterm\" }}{{ joinPath .chezmoi.homeDir \"scoop\" \"apps\" \"wezterm\" \"current\" \"wezterm-gui.exe\" }}{{ else if eq .my.terminal.windows \"wt\" }}{{ joinPath .chezmoi.homeDir \"scoop\" \"apps\" \"windows-terminal\" \"current\" \"wt.exe\" }}{{ else }}{{ .my.terminal.windows }}{{ end }}']\n    bindings: ['f24+enter']\n  # Focus the next/previous active workspace defined in `workspaces` config.\n  # - commands: ['focus --next-active-workspace']\n  - commands: ['focus --next-active-workspace']\n    bindings: ['f24+s']\n  - commands: ['focus --prev-active-workspace']\n    bindings: ['f24+a']\n  # Focus the workspace that last had focus.\n  - commands: ['shell-exec {{ if includeTemplate \"opt\" (dict \"chezmoi\" .chezmoi \"my\" .my \"cmd\" \"altrun\" \"opt\" (list \"windows\" \"startup\" \"altrun\" \"enable\") \"os\" \"windows\") | atoi -}}\n  {{ joinPath .chezmoi.homeDir \"scoop\" \"apps\" \"altrun\" \"current\" \"altrun.exe\" }}\n  {{- else -}}\n  nircmd sendkey rwin press\n  {{- end }}']\n    bindings: ['f24+d']\n  # Change focus to a workspace defined in `workspaces` config.\n  - commands: ['focus --workspace 1']\n    bindings: ['f24+1']\n  - commands: ['focus --workspace 2']\n    bindings: ['f24+2']\n  - commands: ['focus --workspace 3']\n    bindings: ['f24+3']\n  - commands: ['focus --workspace 4']\n    bindings: ['f24+4']\n  - commands: ['focus --workspace 5']\n    bindings: ['f24+5']\n  - commands: ['focus --workspace 6']\n    bindings: ['f24+6']\n  - commands: ['focus --workspace 7']\n    bindings: ['f24+7']\n  - commands: ['focus --workspace 8']\n    bindings: ['f24+8']\n  - commands: ['focus --workspace 9']\n    bindings: ['f24+9']\n  # Move the focused window's parent workspace to a monitor in a given\n  # direction.\n  - commands: ['move-workspace --direction left']\n    bindings: ['f24+shift+a']\n  - commands: ['move-workspace --direction right']\n    bindings: ['f24+shift+f']\n  - commands: ['move-workspace --direction up']\n    bindings: ['f24+shift+d']\n  - commands: ['move-workspace --direction down']\n    bindings: ['f24+shift+s']\n  # Move focused window to a workspace defined in `workspaces` config.\n  - commands: ['move --workspace 1', 'focus --workspace 1']\n    bindings: ['f24+shift+1']\n  - commands: ['move --workspace 2', 'focus --workspace 2']\n    bindings: ['f24+shift+2']\n  - commands: ['move --workspace 3', 'focus --workspace 3']\n    bindings: ['f24+shift+3']\n  - commands: ['move --workspace 4', 'focus --workspace 4']\n    bindings: ['f24+shift+4']\n  - commands: ['move --workspace 5', 'focus --workspace 5']\n    bindings: ['f24+shift+5']\n  - commands: ['move --workspace 6', 'focus --workspace 6']\n    bindings: ['f24+shift+6']\n  - commands: ['move --workspace 7', 'focus --workspace 7']\n    bindings: ['f24+shift+7']\n  - commands: ['move --workspace 8', 'focus --workspace 8']\n    bindings: ['f24+shift+8']\n  - commands: ['move --workspace 9', 'focus --workspace 9']\n    bindings: ['f24+shift+9']\n",
    "zxc.20260401221341.1": "[General]\ncheckForUpdates=false",
    "zxc.20260329012020.1": "{{- /* chezmoi:modify-template */ -}}\n{{ $origin := fromIni .chezmoi.stdin -}}\n{{ $origin = $origin | setValueAtPath \"GUI.CheckForUpdates\" false -}}\n{{ $origin = $origin | setValueAtPath \"GUI.MinimizeOnStartup\" false -}}\n{{ $origin = $origin | setValueAtPath \"GUI.ShowTrayIcon\" false -}}\n{{ $origin = $origin | setValueAtPath \"GUI.MinimizeToTray\" false -}}\n{{ $origin = $origin | setValueAtPath \"GUI.MinimizeOnClose\" false -}}\n{{ $origin = $origin | setValueAtPath \"GUI.TrayIconAppearance\" \"monochrome\" -}}\n{{ $origin = $origin | setValueAtPath \"Browser.Enabled\" true -}}\n{{ $origin = $origin | setValueAtPath \"General.MinimizeAfterUnlock\" false -}}\n{{ $origin = $origin | setValueAtPath \"General.AutoGeneratePasswordForNewEntries\" true -}}\n{{ $origin = $origin | setValueAtPath \"General.GlobalAutoTypeKey\" \"65\" -}}\n{{ $origin = $origin | setValueAtPath \"General.GlobalAutoTypeModifiers\" \"234881024\" -}}\n{{ $origin = $origin | setValueAtPath \"SSHAgent.Enabled\" false -}}\n{{ $origin = $origin | setValueAtPath \"SSHAgent.UseOpenSSH\" true -}}\n{{ $origin = $origin | setValueAtPath \"SSHAgent.UsePageant\" false -}}\n{{ $origin = $origin | setValueAtPath \"Security.AutotypeAsk\" false -}}\n{{ $origin | toIni -}}",
    "zxc.20260411192514.3": "{{- /* chezmoi:modify-template */ -}}\n{{ $origin := fromIni .chezmoi.stdin -}}\n{{ $origin = $origin | setValueAtPath \"Security.QuickUnlock\" true -}}\n{{ $origin = $origin | setValueAtPath \"General.LastActiveDatabase\" (joinPath .chezmoi.homeDir \"syncthing\" \"keepassxc\" \"main.kdbx\") -}}\n{{ $origin = $origin | setValueAtPath \"General.LastDatabases\" (joinPath .chezmoi.homeDir \"syncthing\" \"keepassxc\" \"main.kdbx\") -}}\n{{ $origin = $origin | setValueAtPath \"General.LastOpenedDatabases\" (joinPath .chezmoi.homeDir \"syncthing\" \"keepassxc\" \"main.kdbx\") -}}\n{{ $origin = $origin | setValueAtPath \"General.LastChallengeResponse\" \"\" -}}\n{{ $origin = $origin | setValueAtPath \"General.LastKeyFiles\" \"\" -}}\n{{ $origin = $origin | setValueAtPath \"GUI.ListViewState\" \"\" -}}\n{{ $origin = $origin | setValueAtPath \"GUI.MainWindowGeometry\" \"\" -}}\n{{ $origin = $origin | setValueAtPath \"GUI.MainWindowState\" \"\" -}}\n{{ $origin = $origin | setValueAtPath \"GUI.SearchViewState\" \"\" -}}\n{{ $origin | toIni -}}\n",
