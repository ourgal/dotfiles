    "User.20260221194603.1": "<< dos >>\n{{ $win_gpg_agent := joinPath .chezmoi.homeDir \"scoop\" \"apps\" \"win-gpg-agent\" \"current\" \"agent-gui.exe\" }}\n{{ if stat $win_gpg_agent -}}\n@others\n{{ end -}}\n{{ end -}}",
    "User.20260221194708.1": "{{ $gpg := joinPath .chezmoi.homeDir \"scoop\" \"apps\" \"gpg\" \"current\" -}}\n{{ $gpg_home := joinPath $gpg \"home\" -}}\n{{ $gpg_sock := joinPath $gpg \"gnupg\" -}}\ngpg:\n  install_path: {{ $gpg | quote }}\n  # Before gnupg 2.3.2 release home directory could be properly link-ed\n  #   homedir: {{ $gpg_home | quote }}\n  # With gnupg 2.3.3 release (due to the changes in T5537) use this instead\n  #   homedir: {{ $gpg_home | quote }}\n  #   socketdir: \"\"\n  # After gnupg 2.3.4 release we have to switch to\n  homedir: {{ $gpg_home | quote }}\n  socketdir: {{ $gpg_sock | quote }}\ngui:\n  debug: false\n  setenv: true\n  # Use line below to enable SSH_AUTH_SOCK to point to cygwin socket\n  #   openssh: cygwin",
    "User.20260222211658.1": "<< dos >>\n{{ if lookPath \"rclone\" -}}\n@others\n{{ end -}}\n{{ end -}}",
    "User.20260222211658.2": "{{- /* chezmoi:modify-template */ -}}\n{{ $origin := fromIni .chezmoi.stdin -}}\n{{ $origin = $origin | setValueAtPath \"mega_a.type\" \"mega\" -}}\n{{ $origin = $origin | setValueAtPath \"mega_a.user\" (gopass \"rclone/mega_a/user\") -}}\n{{ $origin = $origin | setValueAtPath \"mega_a.pass\" (gopass \"rclone/mega_a/pass\") -}}\n{{ $origin = $origin | setValueAtPath \"mega_a.session_id\" (gopass \"rclone/mega_a/session_id\") -}}\n{{ $origin = $origin | setValueAtPath \"mega_a.master_key\" (gopass \"rclone/mega_a/master_key\") -}}\n{{ $origin = $origin | setValueAtPath \"alist.type\" \"webdav\" -}}\n{{ $origin = $origin | setValueAtPath \"alist.url\" \"http://localhost:5244/dav/\" -}}\n{{ $origin = $origin | setValueAtPath \"alist.vendor\" \"other\" -}}\n{{ $origin = $origin | setValueAtPath \"alist.user\" \"admin\" -}}\n{{ $origin = $origin | setValueAtPath \"alist.pass\" (gopass \"rclone/alist/local\" | output \"rclone\" \"obscure\" | trim ) -}}\n{{ $origin | toIni -}}",
    "zxc.20260201203241.1": "<< dos >>\n{{ if lookPath \"gpg\" -}}\n@others\n{{ end -}}\n{{ end -}}",
