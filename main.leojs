    "zxc.20260329195706.1": "{{- /* chezmoi:modify-template */ -}}\n{{ $origin := .chezmoi.stdin | trim | splitList \"\\n\" -}}\n{{ range .my.ssh.known_hosts -}}\n    {{ if not (has . $origin) -}}\n    {{ $origin = append $origin . -}}\n    {{ end -}}\n{{ end -}}\n{{ $origin | compact | join \"\\n\" -}}",
    "User.20260220010313.1": "<< dos >>\n{{ if lookPath \"ssh\" -}}\n@others\n{{ end -}}\n{{ end -}}",
