    "zxc.20260501132138.1": "<< delimiter >>\n@language yaml\n@tabwidth -2\n---\n- name: Install void linux\n  hosts: void-live\n  vars:\n    << vars >>\n  tasks:\n    @others\n",
    "zxc.20260501154924.1": "xbps_mirror: https://mirror.nju.edu.cn/voidlinux/current\nxbps_nonfree_mirror: https://mirror.nju.edu.cn/voidlinux/current/nonfree\nhostname: surface",
    "zxc.20260501135630.1": "- name: Debug variables\n  ansible.builtin.debug:\n    var: ansible_facts\n",
    "zxc.20260501140144.1": "- name: Install parted\n  become: true\n  community.general.xbps:\n    name: \"{{ item }}\"\n    repositories:\n      - \"{{ xbps_mirror }}\"\n      - \"{{ xbps_nonfree_mirror }}\"\n  loop:\n    - parted\n",
    "zxc.20260501190027.1": "# Example on how to read info and reuse it in subsequent task\n- name: Read device information (always use unit when probing)\n  become: true\n  community.general.parted: device=/dev/nvme0n1 unit=MiB\n  register: nvme0n1_info\n  \n- name: Remove all partitions from disk\n  become: true\n  community.general.parted:\n    device: /dev/nvme0n1\n    number: '{{ item.num }}'\n    state: absent\n  loop: '{{ nvme0n1_info.partitions }}'\n",
    "zxc.20260501140222.1": "- name: Add partitions\n  become: true\n  vars:\n    device: /dev/nvme0n1\n  block:\n    @others\n",
    "zxc.20260501140324.1": "- name: Boot partition\n  community.general.parted:\n    device: \"{{ device }}\"\n    number: 1\n    fs_type: fat32\n    label: gpt\n    name: boot\n    part_start: \"{{ 2 }}MiB\"\n    part_end: \"{{ 2 + 512 }}MiB\"\n    state: present\n",
    "zxc.20260501140444.1": "- name: Swap partition\n  community.general.parted:\n    device: \"{{ device }}\"\n    number: 2\n    label: gpt\n    name: swap\n    fs_type: linux-swap\n    part_start: \"{{ 2 + 512 }}MiB\"\n    part_end: \"{{ 2 + 512 + 1024 * 4 }}MiB\"\n    state: present\n",
    "zxc.20260501140503.1": "- name: Root partition\n  community.general.parted:\n    device: \"{{ device }}\"\n    number: 3\n    label: gpt\n    name: void_root\n    fs_type: btrfs\n    part_start: \"{{ 2 + 512 + 1024 * 4 }}MiB\"\n    part_end: \"100%\"\n    state: present\n",
    "zxc.20260501140626.1": "- name: Format file systems\n  become: true\n  vars:\n    device: /dev/nvme0n1\n  block:\n    - name: Format boot\n      community.general.filesystem:\n        dev: \"{{ device }}p1\"\n        fstype: vfat\n    - name: Format swap\n      community.general.filesystem:\n        dev: \"{{ device }}p2\"\n        fstype: swap\n    - name: Format root\n      community.general.filesystem:\n        dev: \"{{ device }}p3\"\n        fstype: btrfs\n        force: true\n",
    "zxc.20260501140723.1": "- name: Mount other partitions\n  become: true\n  block:\n    @others",
    "zxc.20260501140739.1": "- name: Mount root\n  ansible.posix.mount:\n    src: /dev/nvme0n1p3\n    path: /mnt\n    opts: rw,noatime,compress=zstd:3,ssd,discard=async,space_cache=v2,subvol=/\n    fstype: btrfs\n    state: ephemeral\n- name: Save root to fstab\n  ansible.posix.mount:\n    src: /dev/nvme0n1p3\n    path: /\n    opts: rw,noatime,compress=zstd:3,ssd,discard=async,space_cache=v2,subvol=/\n    fstype: btrfs\n    state: present\n    fstab: /mnt/etc/fstab\n",
    "zxc.20260501140812.1": "- name: Mount boot\n  ansible.posix.mount:\n    src: /dev/nvme0n1p1\n    path: /mnt/boot/efi\n    opts: rw,fmask=0022,dmask=0022,codepage=437,iocharset=iso8859-1,shortname=mixed,utf8,errors=remount-ro\n    fstype: vfat\n    state: ephemeral\n    passno: 2\n- name: Write boot to fstab\n  ansible.posix.mount:\n    src: /dev/nvme0n1p1\n    path: /boot/efi\n    opts: rw,fmask=0022,dmask=0022,codepage=437,iocharset=iso8859-1,shortname=mixed,utf8,errors=remount-ro\n    fstype: vfat\n    state: present\n    fstab: /mnt/etc/fstab\n    passno: 2\n",
    "zxc.20260501140831.1": "- name: Write swap to fstab\n  ansible.posix.mount:\n    src: /dev/nvme0n1p2\n    path: none\n    opts: defaults\n    fstype: swap\n    state: present\n    fstab: /mnt/etc/fstab\n- name: Write tmp to fstab\n  ansible.posix.mount:\n    src: tmpfs\n    path: /tmp\n    opts: defaults,nosuid,nodev\n    fstype: tmpfs\n    state: present\n    fstab: /mnt/etc/fstab\n",
    "zxc.20260501141201.1": "- name: Find repository keys to install into a new void system on a mounted partition\n  block:\n    - name: Search key files\n      ansible.builtin.find:\n        path: /var/db/xbps/keys\n        pattern: \"*.plist\"\n      register: chroot_void_xbps_keys_files\n    - name: Create folder\n      become: true\n      ansible.builtin.file:\n        path: /mnt/var/db/xbps/keys\n        state: directory\n        mode: \"0755\"\n        owner: root\n        group: root\n    - name: Copy repository keys to into a new void system on a mounted partition\n      become: true\n      ansible.builtin.copy:\n        remote_src: true\n        src: \"{{ item }}\"\n        dest: \"/mnt{{ item }}\"\n        owner: root\n        group: root\n        mode: \"0644\"\n      when: chroot_void_xbps_keys_files.matched > 0\n      loop: \"{{ chroot_void_xbps_keys_files.files | map(attribute='path') }}\"\n",
    "zxc.20260501141247.1": "- name: Install packages in mnt\n  become: true\n  environment:\n    XBPS_ARCH: \"{{ ansible_facts.machine }}\"\n  community.general.xbps:\n    name:\n      @others\n    root: /mnt\n    repositories:\n      - \"{{ xbps_mirror }}\"\n      - \"{{ xbps_nonfree_mirror }}\"\n",
    "zxc.20260501211824.1": "- base-system\n- python3",
    "zxc.20260501211935.1": "- alsa-utils",
    "zxc.20260501211850.1": "- grub-x86_64-efi\n- os-prober",
    "zxc.20260501211916.1": "- avahi\n- nss-mdns\n",
    "zxc.20260501212009.1": "- NetworkManager",
    "zxc.20260501211957.1": "- chrony",
    "zxc.20260501141321.1": "- name: Set timezone\n  become: true\n  ansible.builtin.file:\n    src: /usr/share/zoneinfo/Hongkong\n    dest: /mnt/etc/localtime\n    state: link\n    force: true\n",
    "zxc.20260501141336.1": "- name: Enable services\n  become: true\n  ansible.builtin.file:\n    src: \"/etc/sv/{{ item }}\"\n    dest: \"/mnt/etc/runit/runsvdir/default/{{ item }}\"\n    state: link\n    force: true\n  loop:\n    - NetworkManager\n    - sshd\n    - dbus\n    - alsa\n    - avahi-daemon\n    - chronyd",
    "zxc.20260501141412.1": "- name: Set hostname\n  become: true\n  ansible.builtin.copy:\n    dest: /mnt/etc/hostname\n    content: |\n      {{ hostname }}\n    mode: \"0644\"\n",
    "zxc.20260501141441.1": "- name: Set NetworkManager rc-manager\n  become: true\n  community.general.ini_file:\n    path: /mnt/etc/NetworkManager/NetworkManager.conf\n    section: main\n    option: rc-manager\n    value: resolvconf\n    mode: \"0644\"\n",
    "zxc.20260501141550.1": "- name: Xbps settings\n  become: true\n  block:\n    - name: Set xbps mirror\n      ansible.builtin.copy:\n        dest: /mnt/etc/xbps.d/00-repository-main.conf\n        content: |\n          repository={{ xbps_mirror }}\n        mode: \"0644\"\n    - name: Set xbps nonfree mirror\n      ansible.builtin.copy:\n        dest: /mnt/etc/xbps.d/01-repository-nonfree.conf\n        content: |\n          repository={{ xbps_nonfree_mirror }}\n        mode: \"0644\"\n",
    "zxc.20260501141911.1": "- name: Config file\n  become: true\n  block:\n    @others\n",
    "zxc.20260501141939.1": "- name: Set /etc/rc.conf\n  ansible.builtin.lineinfile:\n    path: /mnt/etc/rc.conf\n    line: KEYMAP=us\n",
    "zxc.20260501142006.1": "- name: Set locale\n  ansible.builtin.lineinfile:\n    path: /mnt/etc/default/libc-locales\n    line: en_US.UTF-8 UTF-8\n",
    "zxc.20260501142020.1": "- name: Set sudoers\n  ansible.builtin.lineinfile:\n    path: /mnt/etc/sudoers\n    line: \"%wheel ALL=(ALL:ALL) ALL\"\n",
    "zxc.20260501142035.1": "- name: Enable os-prober\n  ansible.builtin.lineinfile:\n    path: /mnt/etc/default/grub\n    line: GRUB_DISABLE_OS_PROBER=false\n",
    "zxc.20260501142726.1": "- name: Chroot script\n  become: true\n  block:\n    @others\n",
    "zxc.20260501142914.1": "- name: Create chroot script\n  vars:\n    xchroot_script_content: |\n      set -euo pipefail\n      xbps-reconfigure -f glibc-locales\n      grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=\"Void\"\n      xbps-reconfigure -fa\n      useradd -m zxc\n      usermod -aG wheel zxc\n      usermod -aG audio zxc\n  ansible.builtin.copy:\n    dest: \"{{ xchroot_script_root | default('/mnt') }}/script\"\n    content: |\n      {{ xchroot_script_content }}\n    mode: \"0644\"\n",
    "zxc.20260501142941.1": "- name: Run chroot script\n  environment:\n    LANG: C.UTF-8\n  ansible.builtin.command:\n    cmd: \"xchroot {{ xchroot_script_root | default('/mnt') }} /bin/bash /script\"\n  changed_when: true\n",
    "zxc.20260501143016.1": "- name: Remove script\n  ansible.builtin.file:\n    path: \"{{ xchroot_script_root | default('/mnt') }}/script\"\n    state: absent\n",
    "zxc.20260501143142.1": "- name: Chroot script\n  become: true\n  block:\n    @others\n",
    "zxc.20260501143142.2": "- name: Create chroot script\n  vars:\n    xchroot_script_content: |\n      yes {{ lookup('gopass', 'password/linux/root') | trim }} | passwd root\n      yes {{ lookup('gopass', 'password/linux/user') | trim }} | passwd zxc\n  ansible.builtin.copy:\n    dest: \"{{ xchroot_script_root | default('/mnt') }}/script\"\n    content: |\n      {{ xchroot_script_content }}\n    mode: \"0644\"\n",
    "zxc.20260501143142.3": "- name: Run chroot script\n  environment:\n    LANG: C.UTF-8\n  ansible.builtin.command:\n    cmd: \"xchroot {{ xchroot_script_root | default('/mnt') }} /bin/bash /script\"\n  changed_when: true\n",
    "zxc.20260501143142.4": "- name: Remove script\n  ansible.builtin.file:\n    path: \"{{ xchroot_script_root | default('/mnt') }}/script\"\n    state: absent\n",
    "zxc.20260501143257.1": "- name: Set root ssh authorized keys\n  become: true\n  block:\n    - name: Create ssh authorized keys folder\n      ansible.builtin.file:\n        path: \"{{ chroot_sshd_authorized_keys_root | default('/mnt') }}/root/.ssh\"\n        state: directory\n        mode: \"0700\"\n        owner: root\n        group: root\n    - name: Copy ssh root authorized keys\n      ansible.builtin.get_url:\n        url: https://github.com/ourgal.keys\n        dest: \"{{ chroot_sshd_authorized_keys_root | default('/mnt') }}/root/.ssh/authorized_keys\"\n        mode: \"0600\"\n\n- name: Set user ssh authorized keys\n  block:\n    - name: Create ssh authorized keys folder\n      ansible.builtin.file:\n        path: \"{{ chroot_sshd_authorized_keys_root | default('/mnt') }}/home/zxc/.ssh\"\n        state: directory\n        mode: \"0700\"\n    - name: Copy ssh authorized keys\n      ansible.builtin.get_url:\n        url: https://github.com/ourgal.keys\n        dest: \"{{ chroot_sshd_authorized_keys_root | default('/mnt') }}/home/zxc/.ssh/authorized_keys\"\n        mode: \"0600\"",
    "zxc.20260501143352.1": "- name: Remove chroot resolv.conf\n  become: true\n  ansible.builtin.file:\n    path: /mnt/etc/resolv.conf\n    state: absent",
    "zxc.20260501215954.1": "- name: Reboot\n  become: true\n  ansible.builtin.reboot:",
