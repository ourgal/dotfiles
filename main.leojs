    "zxc.20260501142020.1": "- name: Set sudoers\n  ansible.builtin.lineinfile:\n    path: /mnt/etc/sudoers\n    line: \"%wheel ALL=(ALL:ALL) ALL\"\n",
    "zxc.20260501142035.1": "- name: Enable os-prober\n  ansible.builtin.lineinfile:\n    path: /mnt/etc/default/grub\n    line: GRUB_DISABLE_OS_PROBER=false\n",
    "zxc.20260501142726.1": "- name: Chroot script\n  become: true\n  block:\n    @others\n",
    "zxc.20260501142914.1": "- name: Create chroot script\n  vars:\n    xchroot_script_content: |\n      set -euo pipefail\n      xbps-reconfigure -f glibc-locales\n      grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=\"Void\"\n      xbps-reconfigure -fa\n      useradd -m zxc\n      usermod -aG wheel zxc\n      usermod -aG audio zxc\n  ansible.builtin.copy:\n    dest: \"{{ xchroot_script_root | default('/mnt') }}/script\"\n    content: |\n      {{ xchroot_script_content }}\n    mode: \"0644\"\n",
    "zxc.20260501142941.1": "- name: Run chroot script\n  environment:\n    LANG: C.UTF-8\n  ansible.builtin.command:\n    cmd: \"xchroot {{ xchroot_script_root | default('/mnt') }} /bin/bash /script\"\n  changed_when: true\n",
    "zxc.20260501143016.1": "- name: Remove script\n  ansible.builtin.file:\n    path: \"{{ xchroot_script_root | default('/mnt') }}/script\"\n    state: absent\n",
    "zxc.20260501143142.1": "- name: Chroot script\n  become: true\n  block:\n    @others\n",
    "zxc.20260501143142.2": "- name: Create chroot script\n  vars:\n    xchroot_script_content: |\n      yes {{ lookup('gopass', 'password/linux/root') | trim }} | passwd root\n      yes {{ lookup('gopass', 'password/linux/user') | trim }} | passwd zxc\n  ansible.builtin.copy:\n    dest: \"{{ xchroot_script_root | default('/mnt') }}/script\"\n    content: |\n      {{ xchroot_script_content }}\n    mode: \"0644\"\n",
    "zxc.20260501143142.3": "- name: Run chroot script\n  environment:\n    LANG: C.UTF-8\n  ansible.builtin.command:\n    cmd: \"xchroot {{ xchroot_script_root | default('/mnt') }} /bin/bash /script\"\n  changed_when: true\n",
