    "zxc.20260417220440.1": "#:schema https://docs.jj-vcs.dev/latest/config-schema.json\n\n@others",
    "zxc.20260417220745.1": "[revset-aliases]\n\"closest_pushable(to)\" = \"\"\"\nheads(::to & mutable() & ~description(exact:\"\") & (~empty() | merges()))\n\"\"\"\n\"default()\" = \"\"\"\ncoalesce(trunk(),root())::present(@) | ancestors(visible_heads() & recent(), 5)\n\"\"\"\n\"recent()\" = \"\"\"\ncommitter_date(after:\"1 month ago\")\n\"\"\"",
    "zxc.20260417220802.1": "[ui]\ndefault-command = \"log-recent\"",
    "zxc.20260417220651.1": "[user]\nname = \"{{ .my.git.user.name }}\"\nemail = \"{{ .my.git.user.email }}\"\n",
    "zxc.20260417220716.1": "[aliases]\nlog-recent = [ \"log\", \"-r\", \"default() & recent()\" ]\ntug = [\n    \"bookmark\",\n    \"move\",\n    \"--from\",\n    \"heads(::@ & bookmarks())\",\n    \"--to\",\n    \"closest_pushable(@)\",\n]"
  },
