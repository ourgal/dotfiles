    "zxc.20260423143729.226": "- ffmpeg-progress-yield\n",
    "zxc.20260428002443.1": "- vim-vint --preinstall \"setuptools<81\"\n",
    "zxc.20260423143729.251": "- name: Remove pip config\n  ansible.windows.win_file:\n    path: \"{{ ansible_facts.env.APPDATA }}\\\\.pip\\\\pip.ini\"\n    state: absent\n",
    "zxc.20260423143729.229": "- name: Add cargo bin path to PATH\n  tags: path\n  ansible.windows.win_path:\n    state: present\n    scope: user\n    elements: '%userprofile%\\.cargo\\bin'\n",
    "zxc.20260423143729.230": "- name: Create .cargo folder\n  ansible.windows.win_file:\n    dest: \"{{ ansible_facts.user_dir }}\\\\.cargo\"\n    state: directory\n- name: Set cargo config\n  ansible.windows.win_copy:\n    dest: \"{{ ansible_facts.user_dir }}\\\\.cargo\\\\config.toml\"\n    content: |\n      [source.crates-io]\n      replace-with = 'mirror'\n\n      [source.mirror]\n      registry = \"sparse+https://mirrors.cernet.edu.cn/crates.io-index/\"\n\n      [registries.mirror]\n      index = \"sparse+https://mirrors.cernet.edu.cn/crates.io-index/\"\n",
    "zxc.20260423143729.231": "- name: Install cargo packages\n  tags: cargo-install\n  ansible.windows.win_shell: \"cargo install --locked --git {{ item }}\"\n  loop:\n    @others\n",
    "zxc.20260423143729.232": "- https://github.com/estin/simple-completion-language-server.git\n",
    "zxc.20260423143729.233": "- name: Remove cargo config\n  ansible.windows.win_file:\n    path: \"{{ ansible_facts.user_dir }}\\\\.cargo\\\\config.toml\"\n    state: absent\n",
    "zxc.20260423143729.234": "- name: Npm\n  tags: npm\n  block:\n    @others\n",
    "zxc.20260423143729.235": "- name: Set npm config\n  ansible.windows.win_copy:\n    dest: \"{{ ansible_facts.user_dir }}\\\\.npmrc\"\n    content: |\n      registry = https://registry.npmmirror.com\n",
    "zxc.20260423143729.236": "- name: Install npm packages\n  ansible.windows.win_shell: npm install -g \"{{ item }}\"\n  loop:\n    @others\n",
    "zxc.20260423143729.237": "- prettier\n",
    "zxc.20260423143729.238": "- vscode-langservers-extracted\n",
    "zxc.20260423143729.239": "- yaml-language-server\n",
