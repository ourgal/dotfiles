    "zxc.20260503225154.1": "exec gpg-agent --homedir {{ joinPath .chezmoi.homeDir \".gnupg\" }} --use-standard-socket --daemon --no-detach\n",
    "zxc.20260503224914.1": "#!/bin/sh\n",
    "zxc.20260504133030.1": "{{ if lookPath \"syncthing\" -}}\n<< shebang >>\n@others\n{{ end -}}",
    "zxc.20260504133119.1": "exec syncthing serve --no-browser",
    "zxc.20260503215955.1": "{{ if lookPath \"kmonad\" -}}\n<< shebang >>\n@others\n{{ end -}}\n",
    "zxc.20260503220138.1": "exec kmonad $HOME/.config/kmonad/miryoku.kbd\n",
    "zxc.20260505104942.1": "<< unix >>\n{{ if lookPath \"code-oss\" -}}\n{\n    << code-oss >>\n    @others\n}\n{{ end -}}\n{{ end -}}",
    "zxc.20260505105120.1": "\"extensions.verifySignature\": false,\n\"magit.code-path\": \"code-oss\",",
    "zxc.20260505105255.1": "<< unix >>\n{{ if lookPath \"code-oss\" -}}\n[\n    @others\n]\n{{ end -}}\n{{ end -}}",
    "zxc.20260507000814.1": "{{ if not (lookPath \"fcitx5\") -}}\n{{ joinPath .chezmoi.homeDir \".local\" \"share\" \"flatpak\" \"exports\" \"share\" \"applications\" \"org.fcitx.Fcitx5.desktop\" }}\n{{ end -}}",
    "zxc.20260508000348.1": "{{ if lookPath \"gpg-agent\" -}}\n@others\n{{ end -}}",
    "zxc.20260508000437.1": "[Desktop Entry]\nEncoding=UTF-8\nVersion=0.9.4\nType=Application\nName=gpg-agent\nComment=\nExec=gpg-connect-agent /bye\nOnlyShowIn=XFCE;\nRunHook=0\nStartupNotify=false\nTerminal=false\nHidden=true",
    "zxc.20260502183455.1": "<< unix >>\n{{ if lookPath \"gpg\" -}}\n@others\n{{ end -}}\n{{ end -}}",
    "zxc.20260502183056.1": "<< unix >>\n{{ if lookPath \"gpg-agent\" -}}\n@others\n{{ end -}}\n{{ end -}}\n",
    "zxc.20260502183253.1": "<< unix >>\n{{ if lookPath \"gpg\" -}}\n{{ if .my.git.sign.gpg -}}\nC92C2BCD646A0DE6A60E1C5397CA97FDBE330909\n{{ end -}}\n{{ end -}}\n{{ end -}}\n",
    "zxc.20260505181144.1": "<< unix >>\n@others\n{{ end -}}",
    "zxc.20260505181312.2": "{{ if stat \"/home/linuxbrew/.linuxbrew\" -}}\neval \"$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)\"\nexport HOMEBREW_BREW_GIT_REMOTE=\"https://mirror.nju.edu.cn/git/homebrew/brew.git\"\n{{ end -}}",
    "zxc.20260505181312.3": "export EDITOR={{ template \"editor\" }}\n",
