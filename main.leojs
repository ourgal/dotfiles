    "zxc.20260423143729.212": "- name: Pipx\n  tags: pipx\n  block:\n    @others\n",
    "zxc.20260423143729.213": "- name: Add pipx bin path to PATH\n  ansible.windows.win_path:\n    state: present\n    scope: user\n    elements: '%userprofile%\\.local\\bin'\n",
    "zxc.20260423143729.248": "- name: Create .pip folder\n  ansible.windows.win_file:\n    dest: \"{{ ansible_facts.env.APPDATA }}\\\\.pip\"\n    state: directory\n- name: Set pip config\n  ansible.windows.win_copy:\n    dest: \"{{ ansible_facts.env.APPDATA }}\\\\.pip\\\\pip.ini\"\n    content: |\n      [global]\n      index-url = https://mirrors.cernet.edu.cn/pypi/web/simple/\n      [install]\n      trusted-host = mirrors.cernet.edu.cn\n",
    "zxc.20260423143729.215": "- name: Install pipx packages\n  tags: pipx-install\n  ansible.windows.win_shell: \"pipx install {{ item }}\"\n  loop:\n    @others\n",
