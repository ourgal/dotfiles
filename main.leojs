    "User.20260302135935.1": "{{ if includeTemplate \"opt\" (dict \"chezmoi\" .chezmoi \"my\" .my \"cmd\" (list \"wt\" \"pwsh\") \"opt\" (list \"windows\" \"startup\" \"wt\" \"enable\") \"os\" \"windows\") | trim | atoi -}}\nRun {{ joinPath .chezmoi.homeDir \"scoop\" \"apps\" \"windows-terminal\" \"current\" \"wt.exe\" | quote }}\nWinWait \"ahk_exe WindowsTerminal.exe\"\n{{ if lookPath \"glazewm\" -}}\nWinActivate \"ahk_exe WindowsTerminal.exe\"\nRun \"glazewm command move --workspace 1\", ,\"Hide\"\n{{ end -}}\n{{ end -}}\n",
