    "zxc.20260427221817.1": "\" let lspOpts = #{autoHighlightDiags: v:true}\n\" autocmd User LspSetup call LspOptionsSet(lspOpts)\n\" \n\" let lspServers = [#{\n\" \t\\\t  name: 'yaml-language-server',\n\" \t\\\t  filetype: ['yaml'],\n\" \t\\\t  path: '{{ lookPath \"yaml-language-server\" }}',\n\" \t\\\t  args: ['--stdio']\n\" \t\\ }]\n\" autocmd User LspSetup call LspAddServer(lspServers)",
