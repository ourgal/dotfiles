    "zxc.20260125212135.1": "{{ if includeTemplate \"opt\" (dict \"chezmoi\" .chezmoi \"my\" .my \"cmd\" \"sfsu\" \"opt\" (list \"shell\" \"pwsh\" \"sfsu\" \"enable\") \"os\" \"windows\") | atoi -}}\n@others\n{{ end -}}\n",
