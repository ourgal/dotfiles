    "zxc.20260625191053.1": "{{ $cfg := dict -}}\n{{ $_ := dict -}}\n{{ $cfg = set $cfg \"advice\" (dict \"addEmptyPathspec\" false \"pushNonFastForward\" false \"statusHints\" false) -}}\n\n{{ $_ = set $_ \"sync\" (printf \"!%s/scoop/apps/legit/current/legit.exe sync\" .chezmoi.homeDir) -}}\n{{ $_ = set $_ \"publish\" (printf \"!%s/scoop/apps/legit/current/legit.exe publish\" .chezmoi.homeDir) -}}\n{{ $_ = set $_ \"unpublish\" (printf \"!%s/scoop/apps/legit/current/legit.exe unpublish\" .chezmoi.homeDir) -}}\n{{ $_ = set $_ \"undo\" (printf \"!%s/scoop/apps/legit/current/legit.exe undo\" .chezmoi.homeDir) -}}\n{{ $_ = set $_ \"branches\" (printf \"!%s/scoop/apps/legit/current/legit.exe branches\" .chezmoi.homeDir) -}}\n{{ $cfg = set $cfg \"alias\" $_ -}}\n\n{{ $cfg = set $cfg \"branch\" (dict \"sort\" \"-committerdate\") -}}\n\n{{ $cfg = set $cfg (print \"color \" (\"decorate\" | quote)) (dict \"HEAD\" \"red\" \"branch\" \"blue\" \"remoteBranch\" \"magenta\" \"tag\" \"yellow\") -}}\n{{ $cfg = set $cfg (print \"color \" (\"diff\" | quote)) (dict \"context\" \"white\" \"frag\" \"magenta\" \"meta\" \"blue bold\" \"old\" \"red\" \"whitespace\" \"yellow reverse\") -}}\n{{ $cfg = set $cfg (print \"color \" (\"branch\" | quote)) (dict \"current\" \"magenta\" \"local\" \"default\" \"plain\" \"blue\" \"remote\" \"yellow\" \"upstream\" \"green\") -}}\n\n{{ $cfg = set $cfg \"column\" (dict \"ui\" \"auto\") -}}\n{{ $cfg = set $cfg \"commit\" (dict \"template\" \"~/.config/git/template\" \"gpgsign\" true \"verbose\" true) -}}\n\n{{ $_ = dict -}}\n{{ $_ = set $_ \"compression\" 9 -}}\n{{ $_ = set $_ \"editor\" \"hx\" -}}\n{{ $_ = set $_ \"excludesfile\" \"~/.gitignore\" -}}\n{{ $_ = set $_ \"fsmonitor\" false -}}\n\t{{- if lookPath \"delta\" -}}\n\t{{ $_ = set $_ \"paper\" \"delta\" -}}\n\t{{- else if lookPath \"diff-so-fancy\" -}}\n\t{{ $_ = set $_ \"paper\" \"diff-so-fancy | less '--tabs=4' -RFX\" -}}\n\t{{- end }}\n{{ $_ = set $_ \"preloadindex\" true -}}\n{{ $_ = set $_ \"un