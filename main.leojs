    "zxc.20260329023750.1": "{{ if includeTemplate \"opt\" (dict \"chezmoi\" .chezmoi \"my\" .my \"cmd\" \"gpg-connect-agent\" \"opt\" (list \"windows\" \"startup\" \"gpg_agent\" \"enable\") \"os\" \"windows\") | trim | atoi -}}\nRun \"gpg-connect-agent /bye\", , \"Hide\"\n{{ end -}}\n",
