    "zxc.20260423143729.4": "- name: Configure windows admin\n  hosts: windows\n  remote_user: admin\n  ignore_unreachable: true\n  tags: admin\n  tasks:\n    @others\n  handlers:\n    << handlers >>\n",
    "zxc.20260423143729.276": "- name: Gather facts\n  ansible.builtin.gather_facts:\n- name: Debug variables\n  ansible.builtin.debug:\n    var: ansible_facts\n",
    "zxc.20260423143729.7": "- name: Install choco pacakges\n  tags: choco-install\n  chocolatey.chocolatey.win_chocolatey:\n    name:\n      @others\n    state: latest\n",
    "zxc.20260423143729.8": "- visualstudio2026-workload-vctools\n- weasel\n- winfsp # rclone\n- steam\n- epicgameslauncher\n- \"{{ 'tailscale' if ansible_facts.nodename == 'work' else omit }}\"\n- directx",
    "zxc.20260423143729.9": "- name: Uninstall choco pacakges\n  tags: choco-uninstall\n  chocolatey.chocolatey.win_chocolatey:\n    name:\n      @others\n    state: absent\n",
    "zxc.20260423143729.10": "- gimp\n- gpg4win\n- firefox\n- mpvio\n",
    "zxc.20260423143729.12": "- name: Install init packages via scoop\n  tags: admin-scoop-init\n  community.windows.win_scoop:\n    name: \"{{ item }}\"\n    global: false\n    no_cache: true\n  register: result\n  retries: 3\n  delay: 5\n  until: result is not failed\n  loop:\n    - git\n",
    "zxc.20260423143729.269": "- name: Add bucket\n  community.windows.win_scoop_bucket:\n    name: \"{{ item }}\"\n    state: present\n  loop:\n    - extras\n    - nerd-fonts\n    - nonportable\n",
    "zxc.20260423143729.14": "- name: Install nonportable packages via scoop\n  tags: admin-scoop-nonportable\n  community.windows.win_scoop:\n    name:\n      @others\n    global: true\n    no_cache: true\n  register: result\n  retries: 3\n  delay: 5\n  until: result is not failed\n",
    "zxc.20260423143729.15": "- files-np\n",
    "zxc.20260423143729.16": "- virtualbox-with-extension-pack-np\n",
    "zxc.20260423143729.17": "- name: WSL\n  tags: wsl\n  block:\n    @others\n",
    "zxc.20260423143729.18": "- name: Enable Virtual Machine Platform\n  ansible.windows.win_optional_feature:\n    name: VirtualMachinePlatform\n    state: present\n  register: vmp_status\n- name: Enable hyper-v\n  ansible.windows.win_shell: bcdedit /set hypersivoralaunchtype auto\n  when: vmp_status is failed\n- name: Reboot for hyper-v\n  ansible.windows.win_reboot:\n  when: vmp_status is failed\n- name: Enable Virtual Machine Platform again\n  ansible.windows.win_optional_feature:\n    name: VirtualMachinePlatform\n    state: present\n  register: vmp_again_status\n  when: vmp_status is failed\n- name: Install Microsoft Subsystem for Linux\n  ansible.windows.win_optional_feature:\n    name: Microsoft-Windows-Subsystem-Linux\n    state: present\n  register: wsl_status\n",
    "zxc.20260423143729.19": "- name: Reboot if installing Linux Subsytem as feature requires it\n  ansible.windows.win_reboot:\n  when: >\n    (wsl_status.reboot_required is defined and wsl_status.reboot_required) or\n    (vmp_status.reboot_required is defined and vmp_status.reboot_required) or\n    (vmp_again_status.reboot_required is defined and vmp_again_status.reboot_required)\n",
    "zxc.20260423143729.20": "- name: Hide admin account\n  tags: hide-admin\n  ansible.windows.win_regedit:\n    path: HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon\\SpecialAccounts\\UserList\n    type: dword\n    name: Admin\n    data: 0\n",
    "zxc.20260423143729.21": "- name: Set user groups\n  tags: user-admin\n  ansible.windows.win_user:\n    name: User\n    state: present\n    groups:\n      - Users\n",
    "zxc.20260423143729.22": "- name: Disable ssh-agent service\n  tags: ssh-agent\n  ansible.windows.win_service:\n    name: ssh-agent\n    state: stopped\n    start_mode: disabled\n",
    "zxc.20260423143729.23": "- name: Update openssh\n  tags: openssh\n  chocolatey.chocolatey.win_chocolatey:\n    name: openssh\n    state: latest\n    allow_prerelease: true\n    package_params: /SSHServerFeature\n",
    "zxc.20260423143729.24": "- name: Optimize powershell\n  tags: optimize-powershell\n  ansible.windows.win_shell: |\n    function Optimize-Assemblies {\n        param (\n            [string]$assemblyFilter = \"Microsoft.PowerShell.\",\n            [string]$activity = \"Native Image Installation\"\n        )\n\n        try {\n            # Get the path to the ngen executable dynamically\n            $ngenPath = [System.IO.Path]::Combine([Runtime.InteropServices.RuntimeEnvironment]::GetRuntimeDirectory(), \"ngen.exe\")\n\n            # Check if ngen.exe exists\n            if (-Not (Test-Path $ngenPath)) {\n                Write-Host \"Ngen.exe not found at $ngenPath. Make sure .NET Framework is installed.\"\n                return\n            }\n\n            # Get a list of loaded assemblies\n            $assemblies = [AppDomain]::CurrentDomain.GetAssemblies()\n\n            # Filter assemblies based on the provided filter\n            $filteredAssemblies = $assemblies | Where-Object { $_.FullName -ilike \"$assemblyFilter*\" }\n\n            if ($filteredAssemblies.Count -eq 0) {\n                Write-Host \"No matching assemblies found for optimization.\"\n                return\n            }\n\n            foreach ($assembly in $filteredAssemblies) {\n                # Get the name of the assembly\n                $name = [System.IO.Path]::GetFileName($assembly.Location)\n\n                # Display progress\n                Write-Progress -Activity $activity -Status \"Optimizing $name\"\n\n                # Use Ngen to install the assembly\n                Start-Process -FilePath $ngenPath -ArgumentList \"install `\"$($assembly.Location)`\"\" -Wait -WindowStyle Hidden\n            }\n\n            Write-Host \"Optimization complete.\"\n        } catch {\n            Write-Host \"An error occurred: $_\"\n        }\n    }\n\n    # Optimize PowerShell assemblies:\n    Optimize-Assemblies -assemblyFilter \"Microsoft.PowerShell.\"\n",
    "zxc.20260423143729.25": "- name: Add game user\n  tags: game-user\n  ansible.windows.win_user:\n    name: Game\n    password_expired: false\n    password_never_expires: true\n    state: present\n    groups:\n      - Users\n      - Administrators\n",
    "zxc.20260516120159.1": "- name: Set Developer Mode registry key\n  ansible.windows.win_regedit:\n    path: HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\AppModelUnlock\n    name: AllowDevelopmentWithoutSponsor\n    data: 1\n    type: dword\n    state: present\n- name: Ensure Developer Mode Group Policy is enabled\n  ansible.windows.win_regedit:\n    path: HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Appx\n    name: AllowAllTrustedApps\n    data: 1\n    type: dword\n    state: present\n",
    "zxc.20260503115039.1": "- name: Set hostname\n  ansible.builtin.win_hostname:\n    name: nuc-windows\n",
    "zxc.20260423143729.26": "- name: Install scream pre\n  when: ansible_facts.nodename in ['bed', 'nuc']\n  tags: scream-pre\n  block:\n    @others\n",
    "zxc.20260423143729.27": "- name: Check scream driver file\n  ansible.windows.win_stat:\n    path: C:\\windows\\system32\\drivers\\scream.sys\n  register: scream_driver\n",
    "zxc.20260423143729.28": "- name: Scream pre\n  when: scream_driver.stat.exists is false\n  block:\n    @others\n",
    "zxc.20260423143729.29": "- name: Enable testing mode\n  ansible.windows.win_command: Bcdedit.exe -set TESTSIGNING ON\n- name: Reboot\n  ansible.windows.win_reboot:\n",
    "zxc.20260423143729.30": "- name: Download file\n  ansible.windows.win_get_url:\n    url: https://github.com/duncanthrax/scream/releases/download/4.0/Scream4.0.zip\n    dest: C:\\Scream.zip\n- name: Unzip file\n  community.windows.win_unzip:\n    src: C:\\Scream.zip\n    dest: C:\\Scream\n    force: true\n- name: Run installer\n  ansible.windows.win_command: C:\\Scream\\Install\\Install-x64.bat\n",
    "zxc.20260423143729.301": "- name: Reboot\n  ansible.windows.win_reboot:\n",
    "zxc.20260423143729.32": "- name: Configure windows user\n  hosts: windows\n  remote_user: user\n  ignore_unreachable: true\n  tags: user\n  tasks:\n    @others\n  handlers:\n    << handlers >>\n",
    "zxc.20260423143729.261": "- name: Install aria2 and lessmsi via scoop\n  community.windows.win_scoop:\n    name:\n      - lessmsi\n      - aria2\n    global: false\n    no_cache: true\n  register: result\n  retries: 3\n  delay: 5\n  until: result is not failed\n",
    "zxc.20260423143729.262": "- name: Update scoop config\n  tags: scoop-config\n  block:\n    - name: Facts\n      ansible.builtin.gather_facts:\n      when: ansible_facts is not defined\n    - name: Check scoop config file\n      ansible.windows.win_stat:\n        path: \"{{ ansible_facts.user_dir }}\\\\.config\\\\scoop\\\\config.json\"\n      register: scoop_config_stat\n    - name: Get scoop config content\n      ansible.windows.slurp:\n        src: \"{{ ansible_facts.user_dir }}\\\\.config\\\\scoop\\\\config.json\"\n      register: scoop_config_content\n      when: scoop_config_stat.stat.exists is true\n    - name: Set scoop config\n      vars:\n        << config >>\n      ansible.windows.win_copy:\n        dest: \"{{ ansible_facts.user_dir }}\\\\.config\\\\scoop\\\\config.json\"\n        content: \"{{ scoop_config_content.content | b64decode | from_json | combine(config) | to_json }}\"\n      when: scoop_config_stat.stat.exists is true\n    - name: Set scoop config\n      vars:\n        << config >>\n      ansible.windows.win_copy:\n        dest: \"{{ ansible_facts.user_dir }}\\\\.config\\\\scoop\\\\config.json\"\n        content: \"{{ config | to_json }}\"\n      when: scoop_config_stat.stat.exists is false\n",
    "zxc.20260423143729.264": "config:\n  use_lessmsi: true\n  aria2-enabled: true\n  aria2-warning-enabled: false\n  use_sqlite_cache: true\n  force_update: true\n  use_external_7zip: false\n  gh_token: \"{{ lookup('gopass', 'github/ourgal/token') | trim }}\"\n",
    "zxc.20260423143729.265": "- name: Install 7zip and git via scoop\n  community.windows.win_scoop:\n    name:\n      - 7zip\n      - git\n    global: false\n    no_cache: true\n  register: result\n  retries: 3\n  delay: 5\n  until: result is not failed\n",
    "zxc.20260423143729.266": "- name: Using external 7zip\n  tags: scoop-config\n  block:\n    - name: Facts\n      ansible.builtin.gather_facts:\n      when: ansible_facts is not defined\n    - name: Check scoop config file\n      ansible.windows.win_stat:\n        path: \"{{ ansible_facts.user_dir }}\\\\.config\\\\scoop\\\\config.json\"\n      register: scoop_config_stat\n    - name: Get scoop config content\n      ansible.windows.slurp:\n        src: \"{{ ansible_facts.user_dir }}\\\\.config\\\\scoop\\\\config.json\"\n      register: scoop_config_content\n      when: scoop_config_stat.stat.exists is true\n    - name: Set scoop config\n      vars:\n        << config >>\n      ansible.windows.win_copy:\n        dest: \"{{ ansible_facts.user_dir }}\\\\.config\\\\scoop\\\\config.json\"\n        content: \"{{ scoop_config_content.content | b64decode | from_json | combine(config) | to_json }}\"\n      when: scoop_config_stat.stat.exists is true\n    - name: Set scoop config\n      vars:\n        << config >>\n      ansible.windows.win_copy:\n        dest: \"{{ ansible_facts.user_dir }}\\\\.config\\\\scoop\\\\config.json\"\n        content: \"{{ config | to_json }}\"\n      when: scoop_config_stat.stat.exists is false\n",
    "zxc.20260423143729.268": "config:\n  use_external_7zip: true\n",
    "zxc.20260423143729.45": "- name: Update scoop\n  tags: scoop-update\n  block:\n    - name: Facts\n      ansible.builtin.gather_facts:\n      when: ansible_facts is not defined\n    - name: Update scoop\n      ansible.windows.win_shell: \"{{ ansible_facts.user_dir }}/scoop/apps/scoop/current/bin/scoop.ps1 update\"\n    - name: Update scoop packages\n      ansible.windows.win_shell: \"{{ ansible_facts.user_dir }}/scoop/apps/scoop/current/bin/scoop.ps1 update --all\"\n    - name: Remove scoop cache\n      ansible.windows.win_shell: \"{{ ansible_facts.user_dir }}/scoop/apps/scoop/current/bin/scoop.ps1 cache remove *\"\n    - name: Clean up scoop packages\n      ansible.windows.win_shell: \"{{ ansible_facts.user_dir }}/scoop/apps/scoop/current/bin/scoop.ps1 cleanup --all\"\n",
