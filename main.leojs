    "zxc.20260502144817.1": "- name: Setup pip mirror\n  block:\n    - name: Create .pip folder\n      ansible.builtin.file:\n        dest: \"{{ ansible_facts.user_dir }}/.pip\"\n        state: directory\n    - name: Set pip config\n      ansible.builtin.copy:\n        dest: \"{{ ansible_facts.user_dir }}/.pip/pip.ini\"\n        content: |\n          [global]\n          index-url = https://mirrors.nju.edu.cn/pypi/web/simple/\n          [install]\n          trusted-host = mirrors.nju.edu.cn\n",
    "zxc.20260501214336.1": "- name: Install pipx packages\n  tags: pipx\n  community.general.pipx:\n    name: \"{{ item }}\"\n  loop:\n    @others",
    "zxc.20260501214336.2": "- jellyfin-mpv-shim",
    "zxc.20260502142949.1": "- leo",
    "zxc.20260502182120.1": "- advance-touch",
    "zxc.20260506221714.1": "- name: Flatpak\n  tags:\n    - flatpak\n  block:\n    @others",
    "zxc.20260506221718.1": "- name: Add the flathub flatpak repository remote to the user installation\n  become: true\n  community.general.flatpak_remote:\n    name: flathub\n    state: present\n    flatpakrepo_url: https://dl.flathub.org/repo/flathub.flatpakrepo\n    method: system\n- name: Set mirror\n  become: true\n  ansible.builtin.command: flatpak remote-modify flathub --url=https://mirror.sjtu.edu.cn/flathub",
    "zxc.20260506222621.1": "- name: Install flatpak packages\n  become: true\n  community.general.flatpak:\n    name:\n      @others\n    state: present\n    method: system",
    "zxc.20260506222704.1": "- org.fcitx.Fcitx5\n- org.fcitx.Fcitx5.Addon.Rime",
    "zxc.20260503181421.1": "- name: Services\n  become: true\n  block:\n    @others",
    "zxc.20260503181445.1": "- name: Create per user service folder\n  ansible.builtin.file:\n    dest: \"/etc/sv/runsvdir-{{ username }}\"\n    state: directory\n    mode: \"0755\"\n- name: Create run script\n  ansible.builtin.copy:\n    dest: \"/etc/sv/runsvdir-{{ username }}/run\"\n    mode: \"0755\"\n    content: |\n      #!/bin/sh\n\n      export USER=\"{{ username }}\"\n      export HOME=\"/home/{{ username }}\"\n\n      groups=\"$(id -Gn \"$USER\" | tr ' ' ':')\"\n      svdir=\"$HOME/service\"\n\n      exec chpst -u \"$USER:$groups\" runsvdir \"$svdir\"\n",
    "zxc.20260505164157.1": "- name: Create lemurs service folder\n  ansible.builtin.file:\n    dest: /etc/sv/lemurs\n    state: directory\n    mode: \"0755\"\n- name: Create run script\n  ansible.builtin.copy:\n    dest: /etc/sv/lemurs/run\n    mode: \"0755\"\n    content: |\n      #!/bin/sh\n      # /etc/sv/lemurs/run\n      # Start Lemurs on tty7 (via agetty) and, best-effort, switch to tty7 during boot.\n\n      # If we're on a real virtual terminal (VT) console: switch to tty7 so Lemurs is visible immediately.\n      if command -v fgconsole >/dev/null 2>&1 && command -v chvt >/dev/null 2>&1; then\n        cur=\"$(fgconsole 2>/dev/null || echo \"\")\"\n        if [ -n \"$cur\" ] && [ \"$cur\" != \"serial\" ] && [ \"$cur\" != \"7\" ]; then\n          chvt 7 2>/dev/null || true\n        fi\n      fi\n\n      # Protect tty7 from kernel printk messages so they don't overwrite Lemurs' TUI.\n      TERM=linux setterm --msg off </dev/tty7 >/dev/tty7 2>/dev/null || true\n\n      # Optional: clear tty7 once so old screen contents don't \"shine through\" into the UI.\n      TERM=linux setterm --clear=all </dev/tty7 >/dev/tty7 2>/dev/null || true\n\n      # Runit expects this script to exec a single foreground process.\n      # agetty attaches to /dev/tty7, sets TERM=linux, and starts Lemurs as the login program.\n      exec agetty --noissue --skip-login --login-program /usr/bin/lemurs tty7 linux",
    "zxc.20260502191418.1": "- name: Enable services\n  become: true\n  ansible.builtin.file:\n    src: \"/etc/sv/{{ item }}\"\n    dest: \"/var/service/{{ item }}\"\n    state: link\n  loop:\n    @others",
    "zxc.20260503182010.1": "- \"runsvdir-{{ username }}\"\n",
    "zxc.20260505171841.1": "- lightdm",
    "zxc.20260505171719.1": "- name: Disable services\n  become: true\n  ansible.builtin.file:\n    path: \"/var/service/{{ item }}\"\n    state: absent\n  loop:\n    @others\n",
    "zxc.20260502191430.1": "- lemurs",
    "zxc.20260505164627.1": "- name: Create pam lemurs\n  become: true\n  ansible.builtin.copy:\n    dest: /etc/pam.d/lemurs\n    mode: \"0644\"\n    content: |\n      #%PAM-1.0\n      auth        include    login\n      account     include    login\n      session     include    login\n      password    include    login",
    "zxc.20260505165225.1": "- name: Set lemurs config\n  become: true\n  ansible.builtin.lineinfile:\n    path: /etc/lemurs/config.toml\n    regexp: '^tty ='\n    line: tty = 7",
    "zxc.20260504220005.1": "- name: LinuxBrew\n  tags:\n    - pkg\n    - brew\n  environment:\n    PATH: \"/home/linuxbrew/.linuxbrew/bin:{{ ansible_env.PATH }}\"\n    HOMEBREW_BREW_GIT_REMOTE: \"https://mirror.nju.edu.cn/git/homebrew/brew.git\"\n  block:\n    @others",
    "zxc.20260504220009.1": "- name: Check if Homebrew is installed\n  ansible.builtin.stat:\n    path: \"/home/linuxbrew/.linuxbrew/bin/brew\"\n  register: brew_stat\n- name: Create Homebrew directory\n  ansible.builtin.file:\n    path: \"/home/linuxbrew/.linuxbrew\"\n    state: directory\n    owner: \"{{ ansible_env.USER }}\"\n    group: \"{{ ansible_env.USER }}\"\n    mode: '0755'\n  become: true\n  when: not brew_stat.stat.exists\n- name: Install Homebrew\n  ansible.builtin.shell: |\n    curl -fsSL https://github.com/Homebrew/brew/tarball/master | tar xz --strip 1 -C /home/linuxbrew/.linuxbrew\n  when: not brew_stat.stat.exists",
    "zxc.20260512230229.1": "- name: Install linuxbrew packages\n  tags:\n    - pkg\n    - linuxbrew\n    - homebrew\n  community.general.homebrew:\n    name:\n      @others\n    state: latest\n    update_homebrew: true\n    upgrade: true",
    "zxc.20260513224314.1": "- mani",
    "zxc.20260512231154.1": "- ansible-language-server\n- ansible-lint",
    "zxc.20260512230236.1": "- mcfly",
    "zxc.20260504195440.1": "- name: Set the system hostname\n  become: true\n  ansible.builtin.hostname:\n    name: \"{{ hostname }}\"",
    "zxc.20260503212032.1": "- name: Set user groups\n  become: true\n  ansible.builtin.user:\n    name: \"{{ username }}\"\n    groups:\n      - '{{ \"input\" if ansible_facts.os_family == \"Void\" else omit }}'\n    append: true",
    "zxc.20260501214447.1": "- name: Regenerate initramfs\n  become: true\n  ansible.builtin.command:\n    cmd: \"xbps-reconfigure --force linux{{ ansible_facts.kernel | regex_search('\\\\d+\\\\.\\\\d+') }}\"\n  changed_when: true\n",
    "zxc.20260501214541.1": "- name: Download xlocate data\n  changed_when: true\n  ansible.builtin.command:\n    cmd: xlocate -S\n",
    "zxc.20260423143848.2": "@others\n",
    "zxc.20260423143848.3": "[defaults]\n@others",
    "zxc.20260423143848.4": "gathering = smart\n",
    "zxc.20260423143848.5": "fact_caching = jsonfile\nfact_caching_connection = ~/.cache/ansible/facts\n",
    "zxc.20260423143848.6": "inventory = inventory\n",
