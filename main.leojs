    "User.20260217022114.1": "<< dos >>\n{{ if eq .chezmoi.hostname \"nuc\" \"work\" -}}\n{{ gopassRaw (printf \"deskflow/%s/cert\" .chezmoi.hostname) -}}\n{{ end -}}\n{{ end -}}",
    "User.20260215182818.1": "<< dos >>\n{{ if eq .chezmoi.hostname \"nuc\" -}}\n@others\n{{ end -}}\n{{ end -}}",
