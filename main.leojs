    "zxc.20260423143729.467": "- visual-studio-code\n- vscodium\n- emacs-app",
    "zxc.20260423143729.468": "- firefox\n- brave-browser\n",
    "zxc.20260423143729.469": "- kitty\n- ghostty\n- wezterm",
    "zxc.20260423143729.470": "- name: Install pipx packages\n  tags: pipx\n  community.general.pipx:\n    name: \"{{ item }}\"\n    executable: /opt/homebrew/bin/pipx\n  loop:\n    @others",
    "zxc.20260423143729.471": "- copyparty",
