    "User.20260217202404.1": "{{ if stat (joinPath .chezmoi.homeDir \".config\" \"doom\" \"config.el\") -}}\n{{ $sum := list }}\n{{ $homeDir := .chezmoi.homeDir -}}\n{{ range (list \"config\" \"packages\" \"init\") -}}\n{{ $sum = include (joinPath $homeDir \".config\" \"doom\" (print . \".el\")) | append $sum -}}\n{{ end -}}\n# {{ $sum | join \"\" | sha256sum }}\n# {{ output \"git\" \"-C\" (print .chezmoi.homeDir \"/.emacs.d\") \"rev-parse\" \"HEAD\" }}\n# {{ output \"emacs\" \"--version\" | trim | splitList \"\\n\" | first }}\n{{ (joinPath .chezmoi.homeDir \".emacs.d\" \"bin\" \"doom.ps1\" ) }} sync\n{{ end -}}\n",
