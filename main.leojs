    "zxc.20260505184823.1": "- name: Uninstall packages\n  tags:\n    - pkg\n    - xbps\n  become: true\n  environment:\n    XBPS_ARCH: \"{{ ansible_facts.machine }}\"\n  community.general.xbps:\n    state: absent\n    name:\n      @others",
    "zxc.20260506210845.1": "@\nsbsrf not working\n@c\n- fcitxs\n- fcitx5-rime\n- fcitx5-lua\n- fcitx5-configtool",
    "zxc.20260505184847.1": "- dot-xsession",
    "zxc.20260512231138.1": "- ansible-language-server\n- python3-ansible-lint",
    "zxc.20260502144817.1": "- name: Setup pip mirror\n  block:\n    - name: Create .pip folder\n      ansible.builtin.file:\n        dest: \"{{ ansible_facts.user_dir }}/.pip\"\n        state: directory\n    - name: Set pip config\n      ansible.builtin.copy:\n        dest: \"{{ ansible_facts.user_dir }}/.pip/pip.ini\"\n        content: |\n          [global]\n          index-url = https://mirrors.nju.edu.cn/pypi/web/simple/\n          [install]\n          trusted-host = mirrors.nju.edu.cn\n",
    "zxc.20260501214336.1": "- name: Install pipx packages\n  tags: pipx\n  community.general.pipx:\n    name: \"{{ item }}\"\n  loop:\n    @others",
    "zxc.20260501214336.2": "- jellyfin-mpv-shim",
    "zxc.20260502142949.1": "- leo",
