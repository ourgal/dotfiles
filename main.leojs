    "zxc.20260505221436.1": "{{ $flatpak := joinPath .chezmoi.homeDir \".local\" \"share\" \"flatpak\" \"exports\" \"share\" \"applications\" \"org.fcitx.Fcitx5.desktop\" -}}\n{{ template \"checkPath\" (list \"curl\" \"unzip\") -}}\n{{ if or (lookPath \"fcitx5\") (stat $flatpak) }}\nurl=\"{{ .my.sbsrf.url }}\"\n{{ if lookPath \"fcitx5\" -}}\ndir=~/.local/share/fcitx5/rime\n{{ else if stat $flatpak -}}\ndir=~/.var/app/org.fcitx.Fcitx5/data/fcitx5/rime\n{{ else -}}\n{{ fail \"unknown fcitx5\" -}}\n{{ end -}}\ntmp=/tmp/sbsrf.zip\n[ ! -d \"$dir\" ] && mkdir -p \"$dir\"\ncurl -L -o \"$tmp\" \"$url\"\nunzip \"$tmp\" -o -d \"$dir\"\n[ -e \"$tmp\" ] && rm \"$tmp\"\n{{ end -}}",
    "zxc.20260202203521.14": "<< dos >>\n{{ if lookPath \"clink\" -}}\n<< strict >>\n@others\n{{ end -}}\n{{ end -}}\n",
    "zxc.20260202203521.15": "# 定义要设置的注册表路径和键名\n$RegistryPath = \"HKCU:\\Software\\Microsoft\\Command Processor\"\n$RegistryValueName = \"AutoRun\"\n\n# 定义您想要设置的命令字符串\n# 注意：这里使用了字符串拼接，以确保路径和命令的正确性。\n# 对于包含空格的路径，最好用引号括起来。\n# PowerShell 会自动处理 %LOCALAPPDATA% 等环境变量。\n$CommandToRun = \"`\"{{ joinPath .chezmoi.homeDir \"scoop\" \"apps\" \"clink\" \"current\" \"clink.bat\" }}`\" inject --autorun --profile `\"$env:LOCALAPPDATA\\clink`\" && doskey.exe /macrofile=`\"$env:LOCALAPPDATA\\clink\\aliases`\"\"\n\n# 检查注册表路径是否存在，如果不存在则创建\nif (-not (Test-Path $RegistryPath)) {\n    New-Item -Path $RegistryPath -Force | Out-Null\n    Write-Host \"已创建注册表路径: $RegistryPath\"\n}\n\n# 设置 AutoRun 注册表值\ntry {\n    Set-ItemProperty -Path $RegistryPath -Name $RegistryValueName -Value $CommandToRun -Force\n    Write-Host \"成功设置 '$RegistryValueName' 的值为: $CommandToRun\"\n    Write-Host \"下次启动命令提示符 (cmd.exe) 时，Clink 应该会自动加载。\"\n} catch {\n    Write-Error \"设置注册表值时发生错误: $($_.Exception.Message)\"\n}\n\n# 您也可以选择性地显示当前设置的值来验证\n# Get-ItemProperty -Path $RegistryPath -Name $RegistryValueName\n\n{{ if stat (joinPath (env \"appdata\") \"clink\" \"clink-gizmos\") -}}\nclink installscripts {{ joinPath (env \"appdata\") \"clink\" \"clink-gizmos\" | quote }}\n{{ end -}}\n\n{{ if stat (joinPath (env \"appdata\") \"clink\" \"clink-completions\") -}}\nclink installscripts {{ joinPath (env \"appdata\") \"clink\" \"clink-completions\" | quote }}\n{{ end -}}",
    "zxc.20260202203521.3": "<< dos >>\n{{ if lookPath \"codium\" -}}\n<< strict >>\n@others\n{{ end -}}\n{{ end -}}\n",
