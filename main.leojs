    "zxc.20260429111940.1": "<< unix >>\n{{ if lookPath \"vim\" -}}\n@others\n{{ end -}}\n{{ end -}}",
    "zxc.20260429144755.1": "if !has('vim9script')\n    finish\nendif\nvim9script",
    "zxc.20260429144738.1": "class Session\n    const sep: string = has(\"win32\") ? \"\\\\\" : \"/\"\n    const fileName: string = getcwd()->substitute(this.sep, \"%\", \"g\")->substitute(\":\", \"%\", \"g\")\n    const folder: string = get(g:, \"my_session_folder\", ($MYVIMRC->fnamemodify(\":p:h\") .. this.sep .. \"sessions\")->simplify())\n    const fullPath: string = this.folder .. this.sep .. this.fileName\n\n    def new()\n        if !isdirectory(this.folder)\n            mkdir(this.folder, \"p\")\n        endif\n    enddef\n\n    def Save(): void\n        this.fullPath->escape(\"%\")->printf(\"mksession! %s\")->execute()\n    enddef\n\n    def Load(): void\n        if !filereadable(this.fullPath)\n            return\n        endif\n\n        this.fullPath->escape(\"%\")->printf(\"source %s\")->execute()\n    enddef\n\nendclass\n",
    "zxc.20260429144851.1": "if len(v:argv) == 1\n    g:my_session = Session.new()\n\n    augroup MySession\n        au! VimEnter * ++nested g:my_session.Load()\n        au! VimLeave * g:my_session.Save()\n    augroup END\nendif",
    "zxc.20260429145437.1": "<< unix >>\n{{ if lookPath \"vim\" -}}\n@others\n{{ end -}}\n{{ end -}}",
    "zxc.20260429112205.1": "vim9script\n\ng:my_temp_body = false\n\n# channel data callback function. Called for every received line.\ndef Chan_data_cb(ch: channel, msg: string)\n  # add(g:rcvd_data, msg)\n  if msg == \"<body>\"\n    g:my_temp_body = true\n  endif\n\n  if g:my_temp_body\n    :echom msg\n  endif\nenddef\n\n# channel close callback function.\ndef Chan_close_cb(ch: channel)\n  :echom g:rcvd_data[0]\nenddef\n\ndef Display_Page()\n  var addr = \"www.baidu.com:443\"\n  var ch_opt = {}\n  # data received is processed one line at a time\n  ch_opt.mode = 'nl'\n  ch_opt.waittime = -1\n  ch_opt.drop = \"never\"\n  ch_opt.callback = function('Chan_data_cb')\n  # ch_opt.close_cb = function('Chan_close_cb')\n  # open the channel\n  var ch = ch_open(addr, ch_opt)\n  if ch_status(ch) != \"open\"\n    echomsg $\"Failed to open channel, status = {ch_status(ch)}\"\n    return\n  endif\n  # send a http request\n  ch_sendraw(ch, \"GET / HTTP/1.0\\nHost: www.baidu.com\\n\\n\")\nenddef\n\nDisplay_Page()",
    "zxc.20260427000037.1": "<< unix >>\n{{ if lookPath \"vim\" -}}\n@others\n{{ end -}}\n{{ end -}}",
