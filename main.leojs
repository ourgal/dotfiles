    "zxc.20260328210902.1": "<folder id=\"d69wv-ll51l\" label=\"note20-document\" path=\"~\\Syncthing\\note20-document\" type=\"sendreceive\" rescanIntervalS=\"3600\" fsWatcherEnabled=\"true\" fsWatcherDelayS=\"10\" fsWatcherTimeoutS=\"0\" ignorePerms=\"false\" autoNormalize=\"true\">\n    <filesystemType>basic</filesystemType>\n    <device id=\"{{ gopass \"syncthing/nuc/id\" }}\" introducedBy=\"\">\n        <encryptionPassword></encryptionPassword>\n    </device>\n    <device id=\"{{ gopass \"syncthing/bed/id\" }}\" introducedBy=\"\">\n        <encryptionPassword></encryptionPassword>\n    </device>\n    <device id=\"{{ gopass \"syncthing/note20/id\" }}\" introducedBy=\"\">\n        <encryptionPassword></encryptionPassword>\n    </device>\n    <minDiskFree unit=\"%\">1</minDiskFree>\n    <versioning>\n        <cleanupIntervalS>3600</cleanupIntervalS>\n        <fsPath></fsPath>\n        <fsType>basic</fsType>\n    </versioning>\n    <copiers>0</copiers>\n    <pullerMaxPendingKiB>0</pullerMaxPendingKiB>\n    <hashers>0</hashers>\n    <order>random</order>\n    <ignoreDelete>false</ignoreDelete>\n    <scanProgressIntervalS>0</scanProgressIntervalS>\n    <pullerPauseS>0</pullerPauseS>\n    <pullerDelayS>1</pullerDelayS>\n    <maxConflicts>10</maxConflicts>\n    <disableSparseFiles>false</disableSparseFiles>\n    <paused>false</paused>\n    <markerName>.stfolder</markerName>\n    <copyOwnershipFromParent>false</copyOwnershipFromParent>\n    <modTimeWindowS>0</modTimeWindowS>\n    <maxConcurrentWrites>16</maxConcurrentWrites>\n    <disableFsync>false</disableFsync>\n    <blockPullOrder>standard</blockPullOrder>\n    <copyRangeMethod>standard</copyRangeMethod>\n    <caseSensitiveFS>false</caseSensitiveFS>\n    <junctionsAsDirs>false</junctionsAsDirs>\n    <syncOwnership>false</syncOwnership>\n    <sendOwnership>false</sendOwnership>\n    <syncXattrs>false</syncXattrs>\n    <sendXattrs>false</sendXattrs>\n    <xattrFilter>\n        <maxSingleEntrySize>1024</maxSingleEntryS