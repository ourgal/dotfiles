    "zxc.20260423143729.252": "- name: WSL\n  tags: wsl\n  when: ansible_facts.nodename == 'work'\n  block:\n    @others\n",
    "zxc.20260423143729.253": "- name: Update wsl\n  ansible.windows.win_command: wsl --update\n",
    "zxc.20260423143729.254": "- name: Set WSL default version to 2\n  ansible.windows.win_command: wsl --set-default-version 2\n",
    "zxc.20260423143729.255": "- name: Install arch linux\n  ansible.windows.win_command: wsl --install archlinux --no-launch\n",
