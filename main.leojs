    "zxc.20260613223245.1": "{{ $os := .chezmoi.os -}}\n{{ $linux := \"\" -}}\n{{ if eq .chezmoi.os \"linux\" -}}\n{{ $linux = .chezmoi.osRelease.id -}}\n{{ end -}}\n\n{{ $global_opt := \"\" -}}\n{{ $host_opt := \"\" -}}\n{{ $final_opt := \"\" -}}\n{{ if kindIs \"string\" .opt -}}\n{{ $global_opt = index .my.modules .opt -}}\n{{ $host_opt = index .my.modules .chezmoi.hostname $os .opt -}}\n{{ else if kindIs \"slice\" .opt -}}\n{{ $global_opt = .my.modules -}}\n\n    {{ if eq $os \"linux\" -}}\n    {{ $host_opt = index .my.modules .chezmoi.hostname $linux -}}\n    {{ else -}}\n    {{ $host_opt = index .my.modules .chezmoi.hostname $os -}}\n    {{ end -}}\n\n    {{ range .opt -}}\n        {{ if hasKey $global_opt . -}}\n        {{ $global_opt = index $global_opt . -}}\n        {{ else -}}\n        {{ fail (print $global_opt \" unknow opt value: \" .) -}}\n        {{ end -}}\n        {{ if hasKey $host_opt . -}}\n        {{ $host_opt = index $host_opt . -}}\n        {{ else -}}\n        {{ $host_opt = dict -}}\n        {{ end -}}\n    {{ end -}}\n{{ else -}}\n{{ fail (print \"unknow opt value: \" .) -}}\n{{ end -}}\n\n{{ if not (kindIs \"bool\" $host_opt) -}}\n{{ $final_opt = $global_opt -}}\n{{ else -}}\n{{ $final_opt = $host_opt -}}\n{{ end -}}\n\n{{ $cmd := true -}}\n{{ if hasKey . \"cmd\" -}}\n    {{ if kindIs \"string\" .cmd -}}\n    {{ $cmd = lookPath .cmd }}\n    {{ else if kindIs \"slice\" .cmd -}}\n        {{ $cmd := list -}}\n        {{ range .cmd -}}\n        {{ $cmd = append $cmd (lookPath .) -}}\n        {{ end -}}\n    {{ $cmd = all $cmd -}}\n    {{ end -}}\n{{ end -}}\n\n{{ $file := true -}}\n{{ if hasKey . \"file\" -}}\n    {{ if kindIs \"string\" .file -}}\n    {{ $file = stat .file }}\n    {{ else if kindIs \"slice\" .file -}}\n        {{ $file := list -}}\n        {{ range .file -}}\n        {{ $file = append $file (stat .) -}}\n        {{ end -}}\n    {{ $file = all $file -}}\n    {{ end -}}\n{{ end -}}\n\n{{ $final_os := list -}}\n{{ if kindIs \"string\" .os -}}\n{{ $final_os = eq $os .os -}}\n{{ else if kindIs \"slice\" .os -}}\n    {{ range .os -}}\n    {{ $final_os = append $final_os (eq $os .) -}}\n    {{ end -}}\n{{ $final_os = any $final_os -}}\n{{ end -}}\n\n{{ if and $cmd $file $final_opt $final_os -}}\n1\n{{- else -}}\n0\n{{- end -}}\n",
    "zxc.20260615175522.1": "{{ if not (hasKey . \"source\") -}}\n{{ fail (print \"There is not a source key in the arguments of powershell_junction template\")}}\n{{ end -}}\n{{ if not (hasKey . \"target\") -}}\n{{ fail (print \"There is not a target key in the arguments of powershell_junction template\")}}\n{{ end -}}\n\n{{ if not (any (and (kindIs \"string\" .source) (kindIs \"string\" .target)) (and (kindIs \"slice\" .source) (kindIs \"slice\" .target))) }}\n{{ fail (print \"Wrong arugment types of powershell_junction\")}}\n{{ end -}}\n\n{{ if kindIs \"string\" .source -}}\n$source = \"{{ .source }}\"\n$target = \"{{ .target }}\"\nif (! (Test-Path -Path $source)) {\n    << link >>\n} elseif ((Get-Item -Path $source -Force).LinkType -ne \"Junction\") {\n    << rm >>\n    << link >>\n} elseif ((Get-Item -Path $source -Force).Target -ne $target) {\n    << rm >>\n    << link >>\n}\n{{ else if kindIs \"slice\" .source -}}\n    {{ if ne (len .source) (len .target) -}}\n    {{ fail (print \"powershell_junction sources and targets not match\") -}}\n    {{ end -}}\n{{ $targets := .target -}}\n    {{ range $i, $s := .source -}}\n    $source = \"{{ $s }}\"\n    $target = \"{{ index $targets $i }}\"\n    if (! (Test-Path -Path $source)) {\n        << link >>\n    } elseif ((Get-Item -Path $source -Force).LinkType -ne \"Junction\") {\n        << rm >>\n        << link >>\n    } elseif ((Get-Item -Path $source -Force).Target -ne $target) {\n        << rm >>\n        << link >>\n    }\n    {{ end -}}\n{{ end -}}\n",
