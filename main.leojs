    "zxc.20260323201237.1": "Set-StrictMode -Version Latest\n$ErrorActionPreference = \"Stop\"\n$PSNativeCommandUseErrorActionPreference = $true\n",
    "zxc.20260202203521.18": "# {{ output \"dirhash\" (joinPath .chezmoi.homeDir \".local\" \"share\" \"repos\" \"uosc\" \"src\" \"ziggy\") \"-quiet\" \"-nowait\" }}\ncd ~/.local/share/repos/uosc\n./tools/build.ps1 ziggy placeholder\n\n{{ $sources := list (joinPath .chezmoi.homeDir \"scoop\" \"persist\" \"mpv\" \"portable_config\" \"scripts\" \"uosc\") (joinPath .chezmoi.homeDir \"scoop\" \"persist\" \"mpv\" \"portable_config\" \"fonts\") -}}\n{{ $targets := list (joinPath .chezmoi.homeDir \".local\" \"share\" \"repos\" \"uosc\" \"src\" \"uosc\") (joinPath .chezmoi.homeDir \".local\" \"share\" \"repos\" \"uosc\" \"src\" \"fonts\") -}}\n{{ template \"powershell_junction\" dict \"source\" $sources \"target\" $targets }}\n",
    "User.20260220233639.1": "<< unix >>\n{{ if lookPath \"mpv\" -}}\n@others\n{{ end -}}\n{{ end -}}\n",
    "User.20260220233712.1": "#!{{lookPath \"bash\"}}\n{{ template \"checkPath\" (list \"bash\" \"curl\" \"unzip\") -}}\n{{ if and (lookPath \"bash\") (lookPath \"curl\") (lookPath \"unzip\") -}}\n/bin/bash -c \"$(curl -fsSL https://raw.githubusercontent.com/tomasklaen/uosc/HEAD/installers/unix.sh)\"\n{{ end -}}",
    "zxc.20260202203521.20": "<< dos >>\n@others\n{{ end -}}\n",
    "zxc.20260202203521.22": "function New-LayoutModificationXml {\n    [CmdletBinding()]\n    param (\n        [string[]] $LnkPaths,\n        [string] $OutputPath = $env:USERPROFILE + \"\\AppData\\Local\\Microsoft\\Windows\\Shell\\LayoutModification.xml\",\n        [ValidateSet(\"Append\", \"Replace\")]\n        [string] $PinListPlacement = \"Replace\"\n    )\n\n    $xml = New-Object System.Xml.XmlDocument\n    $root = $xml.CreateElement(\"LayoutModificationTemplate\", \"http://schemas.microsoft.com/Start/2014/LayoutModification\")\n    $xml.AppendChild($root) | Out-Null\n    $root.SetAttribute(\"xmlns:defaultlayout\", \"http://schemas.microsoft.com/Start/2014/FullDefaultLayout\")\n    $root.SetAttribute(\"xmlns:taskbar\", \"http://schemas.microsoft.com/Start/2014/TaskbarLayout\")\n    $root.SetAttribute(\"Version\", \"1\")\n    $collection = $xml.CreateElement(\"CustomTaskbarLayoutCollection\", $root.NamespaceURI)\n    $collection.SetAttribute(\"PinListPlacement\", $PinListPlacement)\n    $root.AppendChild($collection) | Out-Null\n    $layout = $xml.CreateElement(\"defaultlayout:TaskbarLayout\", $root.GetAttribute(\"xmlns:defaultlayout\"))\n    $collection.AppendChild($layout) | Out-Null\n    $pinList = $xml.CreateElement(\"taskbar:TaskbarPinList\", $root.GetAttribute(\"xmlns:taskbar\"))\n    $layout.AppendChild($pinList) | Out-Null\n    foreach ($lnk in $LnkPaths) {\n        $desktopApp = $xml.CreateElement(\"taskbar:DesktopApp\", $root.GetAttribute(\"xmlns:taskbar\"))\n        $desktopApp.SetAttribute(\"DesktopApplicationLinkPath\", $lnk)\n        $pinList.AppendChild($desktopApp) | Out-Null\n    }\n    $xml.Save($OutputPath)\n}\n",
    "zxc.20260202203521.23": "function Reset-TaskbarLayout {\n    Get-Process explorer | Stop-Process -Force\n    Remove-Item \"$Env:AppData\\Microsoft\\Internet Explorer\\Quick Launch\\User Pinned\\TaskBar\\*\" -Force -ErrorAction SilentlyContinue\n    Remove-Item \"$Env:AppData\\Microsoft\\Windows\\Shell\\*.dat\" -Force -ErrorAction SilentlyContinue\n    Remove-Item \"$Env:AppData\\Microsoft\\Windows\\Shell\\LayoutModification.xml\" -Force -ErrorAction SilentlyContinue\n    Remove-Item -Path \"HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Taskband\" -Recurse -ErrorAction SilentlyContinue\n    Remove-ItemProperty -Path \"HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\TrayNotify\" -Name \"IconStreams\" -ErrorAction SilentlyContinue\n    Remove-ItemProperty -Path \"HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\TrayNotify\" -Name \"PastIconsStream\" -ErrorAction SilentlyContinue\n}",
    "zxc.20260202203521.24": "$LnkPaths = @()\nNew-LayoutModificationXml -LnkPaths $LnkPaths -PinListPlacement \"Replace\"\nReset-TaskbarLayout",
    "User.20260216114746.1": "<< dos >>\n{{ if stat \"C:/Program Files/Rime\" -}}\n@others\n{{ end -}}\n{{ end -}}\n",
    "User.20260216114815.1": "# --- Configuration ---\n\n# 1. Define the source URL\n$DownloadUrl = \"{{ .my.sbsrf.url }}\"\n\n# 2. Define the target directory using the built-in environment variable $env:APPDATA\n# Note: $env:APPDATA resolves to C:\\Users\\<Username>\\AppData\\Roaming\n$TargetFolder = Join-Path -Path $env:APPDATA -ChildPath \"rime\"\n\n# 3. Define a temporary path for the downloaded file\n$TempZipPath = Join-Path -Path $env:TEMP -ChildPath \"sbsrf_download.zip\"\n\n# --- Execution ---\n\nWrite-Host \"Starting download and extraction process...\"\n\n# 1. Ensure the target directory exists\nif (-not (Test-Path -Path $TargetFolder)) {\n    Write-Host \"Creating target directory: $TargetFolder\"\n    New-Item -Path $TargetFolder -ItemType Directory | Out-Null\n} else {\n    Write-Host \"Target directory already exists: $TargetFolder\"\n}\n\n# 2. Download the file\nWrite-Host \"Downloading file from $DownloadUrl to $TempZipPath...\"\ntry {\n    # Use Invoke-WebRequest (iwr) for downloading files\n    Invoke-WebRequest -Uri $DownloadUrl -OutFile $TempZipPath -UseBasicParsing\n    Write-Host \"Download complete.\"\n}\ncatch {\n    Write-Error \"Failed to download the file. Error: $($_.Exception.Message)\"\n    exit 1\n}\n\n# 3. Extract the contents of the ZIP file\nWrite-Host \"Extracting contents to $TargetFolder...\"\ntry {\n    # Load the necessary .NET assembly for ZIP operations (often loaded automatically, but good practice to ensure)\n    Add-Type -AssemblyName System.IO.Compression.FileSystem\n\n    # Use Expand-Archive (available in PS 5.0+)\n    # -Force overwrites existing files in the destination folder without prompting\n    Expand-Archive -Path $TempZipPath -DestinationPath $TargetFolder -Force\n    \n    Write-Host \"Extraction complete. Files are now in: $TargetFolder\"\n}\ncatch {\n    Write-Error \"Failed to extract the ZIP file. Error: $($_.Exception.Message)\"\n    exit 1\n}\nfinally {\n    # 4. Clean up the temporary ZIP file\n    if (Test-Path -Path $TempZipPath) {\n        Remove-Item -Path $TempZipPath -Force\n        Write-Host \"Cleaned up temporary file: $TempZipPath\"\n    }\n}",
    "zxc.20260505221318.1": "<< unix >>\n{{ if lookPath \"fcitx5\" -}}\n@others\n{{ end -}}\n{{ end -}}",
    "User.20260221011837.1": "#!{{lookPath \"bash\"}}\n",
    "zxc.20260505102603.1": "set -euo pipefail",
    "zxc.20260505221436.1": "{{ $flatpak := joinPath .chezmoi.homeDir \".local\" \"share\" \"flatpak\" \"exports\" \"share\" \"applications\" \"org.fcitx.Fcitx5.desktop\" -}}\n{{ template \"checkPath\" (list \"curl\" \"unzip\") -}}\n{{ if or (lookPath \"fcitx5\") (stat $flatpak) }}\nurl=\"{{ .my.sbsrf.url }}\"\n{{ if lookPath \"fcitx5\" -}}\ndir=~/.local/share/fcitx5/rime\n{{ else if stat $flatpak -}}\ndir=~/.var/app/org.fcitx.Fcitx5/data/fcitx5/rime\n{{ else -}}\n{{ fail \"unknown fcitx5\" -}}\n{{ end -}}\ntmp=/tmp/sbsrf.zip\n[ ! -d \"$dir\" ] && mkdir -p \"$dir\"\ncurl -L -o \"$tmp\" \"$url\"\nunzip \"$tmp\" -o -d \"$dir\"\n[ -e \"$tmp\" ] && rm \"$tmp\"\n{{ end -}}",
    "zxc.20260202203521.14": "<< dos >>\n{{ if lookPath \"clink\" -}}\n@others\n{{ end -}}\n{{ end -}}\n",
    "zxc.20260202203521.15": "# 定义要设置的注册表路径和键名\n$RegistryPath = \"HKCU:\\Software\\Microsoft\\Command Processor\"\n$RegistryValueName = \"AutoRun\"\n\n# 定义您想要设置的命令字符串\n# 注意：这里使用了字符串拼接，以确保路径和命令的正确性。\n# 对于包含空格的路径，最好用引号括起来。\n# PowerShell 会自动处理 %LOCALAPPDATA% 等环境变量。\n$CommandToRun = \"`\"{{ joinPath .chezmoi.homeDir \"scoop\" \"apps\" \"clink\" \"current\" \"clink.bat\" }}`\" inject --autorun --profile `\"$env:LOCALAPPDATA\\clink`\" && doskey.exe /macrofile=`\"$env:LOCALAPPDATA\\clink\\aliases`\"\"\n\n# 检查注册表路径是否存在，如果不存在则创建\nif (-not (Test-Path $RegistryPath)) {\n    New-Item -Path $RegistryPath -Force | Out-Null\n    Write-Host \"已创建注册表路径: $RegistryPath\"\n}\n\n# 设置 AutoRun 注册表值\ntry {\n    Set-ItemProperty -Path $RegistryPath -Name $RegistryValueName -Value $CommandToRun -Force\n    Write-Host \"成功设置 '$RegistryValueName' 的值为: $CommandToRun\"\n    Write-Host \"下次启动命令提示符 (cmd.exe) 时，Clink 应该会自动加载。\"\n} catch {\n    Write-Error \"设置注册表值时发生错误: $($_.Exception.Message)\"\n}\n\n# 您也可以选择性地显示当前设置的值来验证\n# Get-ItemProperty -Path $RegistryPath -Name $RegistryValueName\n\n{{ if stat (joinPath (env \"appdata\") \"clink\" \"clink-gizmos\") -}}\nclink installscripts {{ joinPath (env \"appdata\") \"clink\" \"clink-gizmos\" | quote }}\n{{ end -}}\n\n{{ if stat (joinPath (env \"appdata\") \"clink\" \"clink-completions\") -}}\nclink installscripts {{ joinPath (env \"appdata\") \"clink\" \"clink-completions\" | quote }}\n{{ end -}}",
    "zxc.20260202203521.3": "<< dos >>\n{{ if lookPath \"codium\" -}}\n@others\n{{ end -}}\n{{ end -}}\n",
