    "zxc.20260317085321.1": "{{ $scoop_persist := joinPath .chezmoi.homeDir \"scoop\" \"persist\" \"deskflow\" -}}\n{{ $conf := joinPath $scoop_persist \"settings\" \"deskflow-server.conf\" -}}\n{{ $cert := joinPath $scoop_persist \"settings\" \"tls\" \"deskflow.pem\" -}}\n{{ $trusted := joinPath $scoop_persist \"settings\" \"tls\" \"trusted-client\" -}}\n\n# {{ include $conf | sha256sum }}\n# {{ include $cert | sha256sum }}\n# {{ include $trusted | sha256sum }}\n\nmkdir \"C:/ProgramData/Deskflow/tls\" -ErrorAction SilentlyContinue\ncp {{ $conf }} \"C:/ProgramData/Deskflow/\"\ncp {{ $cert }} \"C:/ProgramData/Deskflow/tls/\"\ncp {{ $trusted }} \"C:/ProgramData/Deskflow/tls/\"\n",
