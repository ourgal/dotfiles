    "zxc.20260428002132.1": "- vim-language-server\n",
    "zxc.20260423143729.241": "- name: Remove npm config\n  ansible.windows.win_file:\n    path: \"{{ ansible_facts.user_dir }}\\\\.npmrc\"\n    state: absent\n",
    "zxc.20260423143729.242": "- name: Facts\n  tags: user-env\n  ansible.builtin.gather_facts:\n  when: ansible_facts.user_dir is not defined\n",
    "zxc.20260423143729.243": "- name: Set home environment variable\n  tags: user-env\n  ansible.windows.win_environment:\n    state: present\n    name: HOME\n    value: \"{{ ansible_facts.user_dir }}\"\n    level: user\n",
    "zxc.20260423143729.244": "- name: Add doom bin path to PATH\n  tags:\n    - user-env\n    - path\n  ansible.windows.win_path:\n    state: present\n    scope: user\n    elements: '%userprofile%\\.emacs.d\\bin'\n",
    "zxc.20260615201044.1": "- name: Set go environment variable\n  tags: user-env\n  ansible.windows.win_environment:\n    state: present\n    name: \"{{ .name }}\"\n    value: \"{{ .value }}\"\n    level: user\n  loop:\n    - name: GO111MODULE\n      value: on\n    - name: GOPROXY\n      value: https://goproxy.cn\n",
    "zxc.20260423143729.245": "- name: Set rime as default input method\n  ansible.windows.win_regedit:\n    path: HKCU:\\Keyboard Layout\\Preload\n    name: 1\n    data: 00000804\n- name: Set en as second input method\n  ansible.windows.win_regedit:\n    path: HKCU:\\Keyboard Layout\\Preload\n    name: 2\n    data: 00000409\n",
    "zxc.20260423143729.246": "- name: Add msys bin path to PATH\n  tags: path\n  ansible.windows.win_path:\n    state: present\n    scope: user\n    elements: '%userprofile%\\scoop\\apps\\msys2\\current\\mingw64\\bin'\n",
    "zxc.20260423143729.247": "- name: Pip\n  tags: pip\n  block:\n    @others\n\n",
    "zxc.20260423143729.249": "- name: Install pip packages\n  tags: pip-install\n  ansible.windows.win_shell: \"pip install --user {{ item }}\"\n  loop:\n    @others\n",
