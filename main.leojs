    "zxc.20260423143729.426": "<< delimiter >>\n@language yaml\n@tabwidth -2\n---\n@\ndisable power saving\nenable password ssh login and start ssh\nchange uos password, current password is emtpy\nssh-copy-id\n@c\n- name: Install uos\n  hosts: uos-live\n  vars:\n    << vars >>\n  tasks:\n    @others",
    "zxc.20260423143729.427": "user: zxc\ndufs_url: http://192.168.1.110:6500",
    "zxc.20260423143729.428": "- name: Debug variables\n  ansible.builtin.debug:\n    var: ansible_facts",
    "zxc.20260423143729.429": "- name: Enable developer mode\n  become: true\n  block:\n    @others",
    "zxc.20260423143729.430": "- name: Create folder\n  ansible.builtin.file:\n    path: /target/var/lib/deepin/developer-mode\n    state: directory\n    mode: \"0755\"",
    "zxc.20260423143729.431": "- name: Create enabled file\n  ansible.builtin.copy:\n    dest: /target/var/lib/deepin/developer-mode/enabled\n    content: 1\n    mode: \"0644\"\n",
    "zxc.20260423143729.432": "- name: Copy resolv.conf\n  become: true\n  ansible.builtin.copy:\n    src: /etc/resolv.conf\n    dest: /target/etc/resolv.conf\n    remote_src: true",
    "zxc.20260423143729.433": "- name: Copy apt auth file\n  become: true\n  ansible.builtin.copy:\n    src: /etc/apt/auth.conf.d/uos.conf\n    dest: /target/etc/apt/auth.conf.d/uos.conf\n    remote_src: true",
    "zxc.20260423143729.434": "- name: Add linglong repo\n  become: true\n  ansible.builtin.copy:\n    dest: /target/etc/apt/sources.list.d/linglong.list\n    content: deb [trusted=yes] https://ci.deepin.com/repo/obs/linglong:/CI:/release/uos_1070/ ./ ",
    "zxc.20260423143729.435": "- name: Download wps 365\n  become: true\n  ansible.builtin.get_url:\n    url: https://pubwps-wps365-obs.wpscdn.cn/download/Linux/24730/wps-office_12.1.2.24730.AK.preread.sw_644358_arm64.deb\n    dest: /target/tmp/wps.deb\n    mode: \"0644\"",
    "zxc.20260423143729.436": "- name: Download windows fonts\n  become: true\n  ansible.builtin.unarchive:\n    src: \"{{ dufs_url }}/fonts/windows.zip\"\n    dest: /target/usr/share/fonts/\n    remote_src: yes",
    "zxc.20260423143729.437": "- name: Copy apt auth file\n  become: true\n  block:\n    @others",
    "zxc.20260423143729.438": "- name: Create .ssh folder\n  ansible.builtin.file:\n    path: \"/target/home/{{ user }}/.ssh\"\n    state: directory\n    mode: \"0755\"\n",
    "zxc.20260423143729.439": "- name: Copy authorized_keys\n  ansible.builtin.copy:\n    src: /home/uos/.ssh/authorized_keys\n    dest: \"/target/home/{{ user }}/.ssh/authorized_keys\"\n    mode: \"0644\"\n    remote_src: true\n",
    "zxc.20260423143729.440": "- name: Chroot\n  tags: chroot\n  become: true\n  block:\n    @others",
    "zxc.20260423143729.441": "- name: Create chroot script\n  ansible.builtin.copy:\n    dest: /target/script\n    content: |\n      set -euo pipefail\n      @others\n    mode: \"0644\"\n",
    "zxc.20260423143729.442": "apt update\n",
    "zxc.20260423143729.444": "apt install -y com.zjd.gov\n",
    "zxc.20260423143729.445": "apt install -y com.tencent.wechat\n",
    "zxc.20260423143729.446": "apt install -y com.360.browser-stable\n",
    "zxc.20260423143729.447": "apt install -y linglong-bin linglong-installer\n",
    "zxc.20260423143729.448": "apt install -y /tmp/wps.deb",
    "zxc.20260506150100.1": "apt install -y awesome",
    "zxc.20260423143729.449": "systemctl enable ssh\nchown -R {{ user }}:{{ user }} /home/{{ user }}/.ssh",
    "zxc.20260423143729.450": "- name: Run chroot script\n  environment:\n    LANG: C.UTF-8\n  ansible.builtin.shell:\n    cmd: |\n      fail() {\n              printf '%s\\n' \"$1\" >&2\n              exit 1\n      }\n\n      CHROOT=/target\n\n      [ -d \"$CHROOT\" ] || fail 'not a directory'\n      [ -d \"$CHROOT/dev\" ] || fail 'no /dev in chroot'\n      [ -d \"$CHROOT/proc\" ] || fail 'no /proc in chroot'\n      [ -d \"$CHROOT/sys\" ] || fail 'no /sys in chroot'\n\n      for _fs in dev proc sys; do\n              mount --rbind \"/$_fs\" \"$CHROOT/$_fs\"\n              mount --make-rslave \"$CHROOT/$_fs\"\n      done\n\n      cleanup() {\n              umount -R \"$CHROOT/dev\" \"$CHROOT/proc\" \"$CHROOT/sys\"\n      }\n\n      trap cleanup EXIT INT\n\n      chroot \"$CHROOT\" /bin/bash /script\n  changed_when: true\n",
    "zxc.20260423143729.451": "- name: Remove script\n  ansible.builtin.file:\n    path: /target/script\n    state: absent\n",
    "zxc.20260507153544.1": "<< delimiter >>\n@language yaml\n@tabwidth -2\n---\n- name: Configure uos\n  hosts: uos\n  vars:\n    << vars >>\n  tasks:\n    @others\n",
    "zxc.20260507153731.1": "user: zxc",
    "zxc.20260507153832.1": "- name: Debug variables\n  ansible.builtin.debug:\n    var: ansible_facts",
    "zxc.20260507153845.1": "- name: Nix\n  tags:\n    - pkg\n    - nix\n  block:\n    @others",
    "zxc.20260507153959.1": "- name: Nix folder stat\n  ansible.builtin.stat:\n    path: /nix\n  register: nix_stat\n- name: Install nix\n  become: true\n  ansible.builtin.shell: curl -sSfL https://artifacts.nixos.org/nix-installer | sh -s -- install --enable-flakes --no-confirm\n  when: not nix_stat.stat.exists\n- name: Add trusted-users to nix config\n  become: true\n  ansible.builtin.lineinfile:\n    path: /etc/nix/nix.conf\n    line: trusted-users = {{ user }}",
    "zxc.20260507163506.1": "- name: Home-manager stat\n  ansible.builtin.stat:\n    path: \"{{ ansible_facts.user_dir }}/.nix-profile/bin/home-manager\"\n  register: home_manager_stat\n- name: Install home-manager channel\n  ansible.builtin.shell: nix-channel --add https://github.com/nix-community/home-manager/archive/release-25.11.tar.gz home-manager\n  when: not home_manager_stat.stat.exists\n- name: Update channels\n  ansible.builtin.shell: nix-channel --update\n  when: not home_manager_stat.stat.exists\n- name: Install home-manager\n  ansible.builtin.shell: nix-shell '<home-manager>' -A install\n  when: not home_manager_stat.stat.exists",
    "zxc.20260511160409.1": "- name: Fix etc profile PATH\n  become: true\n  ansible.builtin.template:\n    src: templates/uos_etc_profile.j2\n    dest: /etc/profile\n    owner: root\n    group: root\n    mode: \"0644\"",
    "zxc.20260514112740.1": "# /etc/profile: system-wide .profile file for the Bourne shell (sh(1))\n# and Bourne compatible shells (bash(1), ksh(1), ash(1), ...).\n\nif [ \"`id -u`\" -eq 0 ]; then\n  PATH=\"/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH\"\nelse\n  PATH=\"/usr/local/bin:/usr/bin:/bin:/usr/local/games:/usr/games:/sbin:/usr/sbin:$PATH\"\nfi\nexport PATH\n\nif [ \"$PS1\" ]; then\n  if [ \"$BASH\" ] && [ \"$BASH\" != \"/bin/sh\" ]; then\n    # The file bash.bashrc already sets the default PS1.\n    # PS1='\\h:\\w\\$ '\n    if [ -f /etc/bash.bashrc ]; then\n      . /etc/bash.bashrc\n    fi\n  else\n    if [ \"`id -u`\" -eq 0 ]; then\n      PS1='# '\n    else\n      PS1='$ '\n    fi\n  fi\nfi\n\nif [ -d /etc/profile.d ]; then\n  for i in /etc/profile.d/*.sh; do\n    if [ -r $i ]; then\n      . $i\n    fi\n  done\n  unset i\nfi\n\nalias sort=\"LC_ALL=C sort\"\n\ntty | egrep -q tty[1-6] && export TMOUT=900",
    "zxc.20260423143729.453": "<< delimiter >>\n@language yaml\n@tabwidth -2\n---\n- name: Configure macos\n  hosts: macos\n  roles:\n    << homebrew >>\n  tasks:\n    @others",
    "zxc.20260423143729.454": "- name: Debug variables\n  ansible.builtin.debug:\n    var: ansible_facts",
    "zxc.20260423143729.455": "- role: geerlingguy.mac.homebrew\n  vars:\n    homebrew_installed_packages:\n      << packages >>\n    homebrew_cask_apps:\n      << cask >>\n",
    "zxc.20260423143729.456": "@others",
    "zxc.20260423143729.457": "- git\n- gopass\n- gh",
    "zxc.20260423143729.458": "- mpv",
    "zxc.20260423143729.459": "- dufs\n- syncthing",
    "zxc.20260423143729.460": "- wget\n- pipx\n- duf\n- btop\n- htop",
    "zxc.20260423143729.461": "- emacs\n- helix",
    "zxc.20260423143729.462": "- fish",
    "zxc.20260423143729.463": "- mcfly",
    "zxc.20260423143729.464": "- chezmoi",
