    "zxc.20260619161512.1": "#! /usr/bin/env nix-shell\n#! nix-shell -i python3 -p python3Packages.pandas\n\nimport sqlite3\nfrom enum import Enum\n\nimport pandas as pd\n\n\nclass Waiting_Status(Enum):\n    WAITING = 1\n    DONE = 2\n    NOT_PACKAGED = 3\n    REMOVED = 4\n\n\nclass Types(Enum):\n    PACKAGE = 1\n    MODULE = 2\n\n\nclass Categories(Enum):\n    MUSIC = 1\n    NIX = 2\n    SHELL = 3\n    DEV = 4\n    SYSTEM = 5\n    GIT = 6\n    WEB = 7\n    NETWORK = 8\n    DOCKER = 9\n    AUDIO = 10\n    SHARE = 11\n    DOC = 12\n    IMAGE = 13\n    ENCRYPT = 14\n    FONT = 15\n    GAME = 16\n    VIDEO = 17\n    DOWNLOAD = 18\n    PROXY = 19\n    FUN = 20\n    BOOK = 21\n    TYPING = 22\n    BACKUP = 23\n    WORK = 24\n    FINANCE = 25\n    CHAT = 26\n    AI = 27\n    RSS = 28\n    LIFE = 29\n    MATH = 30\n    PHONE = 31\n    SECURITY = 32\n    MAIL = 32\n\n\nwith sqlite3.connect(\"waiting.db\") as conn:\n    cursor = conn.cursor()\n    cursor.execute(\n        \"\"\"\n        pragma foreign_keys\n        = on\n        ;\n    \"\"\"\n    )\n\n    cursor.execute(\n        \"\"\"\n        CREATE TABLE waiting_status (\n            id integer PRIMARY KEY,\n            name text NOT NULL\n        );\n    \"\"\"\n    )\n\n    cursor.execute(\n        \"\"\"\n        CREATE TABLE categories (\n            id integer PRIMARY KEY,\n            name text NOT NULL\n        );\n    \"\"\"\n    )\n\n    cursor.execute(\n        \"\"\"\n        CREATE TABLE types (\n            id integer PRIMARY KEY,\n            name text NOT NULL\n        );\n    \"\"\"\n    )\n\n    cursor.execute(\n        \"\"\"\n        CREATE TABLE packages (\n            id integer PRIMARY KEY,\n            name text NOT NULL UNIQUE,\n            description text NOT NULL,\n            url text NOT NULL,\n            categories integer NOT NULL,\n            waiting_status integer NOT NULL,\n            added_date text NOT NULL,\n            finished_date text,\n            type integer NOT NULL DEFAULT 1,\n            FOREIGN KEY (waiting_status)\n            REFERENCES waiting_status (id)\n            ON UPDATE RESTRICT\n            ON DELETE RESTRICT\n            FOREIGN KEY (categories)\n            REFERENCES categories (id)\n            ON UPDATE RESTRICT\n            ON DELETE RESTRICT\n            FOREIGN KEY (type)\n            REFERENCES types (id)\n            ON UPDATE RESTRICT\n            ON DELETE RESTRICT\n        );\n    \"\"\"\n    )\n\n    cursor.execute(\n        f\"\"\"\n        CREATE VIEW v_packages\n        AS\n        SELECT '[[' || url || '][' || name || ']]' AS package, description FROM packages WHERE waiting_status = {Waiting_Status.WAITING.value} ORDER BY added_date;\n    \"\"\"\n    )\n\n    cursor.execute(\n        f\"\"\"\n        CREATE VIEW v_need_packaging\n        AS\n        SELECT '[[' || url || '][' || name || ']]' AS package, description FROM packages WHERE waiting_status = {Waiting_Status.NOT_PACKAGED.value} ORDER BY added_date;\n    \"\"\"\n    )\n\n    cursor.execute(\n        f\"\"\"\n        INSERT INTO waiting_status  VALUES ({Waiting_Status.WAITING.value},'{Waiting_Status.WAITING.name}'), ({Waiting_Status.DONE.value},'{Waiting_Status.DONE.name}'), ({Waiting_Status.NOT_PACKAGED.value}, '{Waiting_Status.NOT_PACKAGED.name}'), ({Waiting_Status.REMOVED.value}, '{Waiting_Status.REMOVED.name}');\n    \"\"\"\n    )\n\n    cursor.execute(\n        f\"\"\"\n        INSERT INTO types VALUES ({Types.PACKAGE.value},'{Types.PACKAGE.name}'), ({Types.MODULE.value},'{Types.MODULE.name}');\n    \"\"\"\n    )\n\n    cursor.execute(\n        f\"\"\"\n        INSERT INTO categories VALUES\n        ({Categories.MUSIC.value},'{Categories.MUSIC.name}'),\n        ({Categories.NIX.value},'{Categories.NIX.name}'),\n        ({Categories.SHELL.value},'{Categories.SHELL.name}'),\n        ({Categories.DEV.value},'{Categories.DEV.name}'),\n        ({Categories.SYSTEM.value},'{Categories.SYSTEM.name}'),\n        ({Categories.GIT.value},'{Categories.GIT.name}'),\n        ({Categories.WEB.value},'{Categories.WEB.name}'),\n        ({Categories.NETWORK.value},'{Categories.NETWORK.name}'),\n        ({Categories.DOCKER.value},'{Categories.DOCKER.name}'),\n        ({Categories.AUDIO.value},'{Categories.AUDIO.name}'),\n        ({Categories.SHARE.value},'{Categories.SHARE.name}'),\n        ({Categories.DOC.value},'{Categories.DOC.name}'),\n        ({Categories.IMAGE.value},'{Categories.IMAGE.name}'),\n        ({Categories.ENCRYPT.value},'{Categories.ENCRYPT.name}'),\n        ({Categories.FONT.value},'{Categories.FONT.name}'),\n        ({Categories.GAME.value},'{Categories.GAME.name}'),\n        ({Categories.VIDEO.value},'{Categories.VIDEO.name}'),\n        ({Categories.DOWNLOAD.value},'{Categories.DOWNLOAD.name}'),\n        ({Categories.PROXY.value},'{Categories.PROXY.name}');\n    \"\"\"\n    )\n\n\nwith sqlite3.connect(\"waiting.db\") as conn:\n    df = pd.DataFrame(\n        [\n            [\n                \"id3\",\n                \"ID3 mass tagger\",\n                \"https://github.com/squell/id3\",\n                Categories.MUSIC,\n                \"05/17/2025\",\n                None,\n                Waiting_Status.DONE,\n                Types.PACKAGE,\n            ],\n            [\n                \"nix-editor\",\n                \"A simple rust program to edit NixOS configuration files with just a command\",\n                \"https://github.com/snowfallorg/nix-editor\",\n                Categories.NIX,\n                \"05/17/2025\",\n                None,\n                Waiting_Status.DONE,\n                Types.PACKAGE,\n            ],\n            [\n                \"jumper\",\n                \"Accurate and fast files/directories jumper\",\n                \"https://github.com/homerours/jumper\",\n                Categories.SHELL,\n                \"05/17/2025\",\n                None,\n                Waiting_Status.DONE,\n                Types.PACKAGE,\n            ],\n            [\n                \"schemat\",\n                \"Code formatter for Scheme, Lisp, and any S-expressions\",\n                \"https://github.com/raviqqe/schemat\",\n                Categories.DEV,\n                \"05/17/2025\",\n                None,\n                Waiting_Status.WAITING,\n                Types.PACKAGE,\n            ],\n            [\n                \"keyviz\",\n                \"Keyviz is a free and open-source tool to visualize your keystrokes ⌨️ and 🖱️ mouse actions in real-time.\",\n                \"https://github.com/mulaRahul/keyviz\",\n                Categories.SYSTEM,\n                \"05/17/2025\",\n                None,\n                Waiting_Status.WAITING,\n                Types.PACKAGE,\n            ],\n            [\n                \"git-pr\",\n                \"the easiest git collaboration tool\",\n                \"https://github.com/picosh/git-pr\",\n                Categories.GIT,\n                \"05/17/2025\",\n                None,\n                Waiting_Status.WAITING,\n                Types.PACKAGE,\n            ],\n            [\n                \"cvtek\",\n                \"📄 Craft your Resume/CV using TOML\",\n                \"https://github.com/varbhat/cvtek\",\n                Categories.WEB,\n                \"05/17/2025\",\n                None,\n                Waiting_Status.WAITING,\n                Types.PACKAGE,\n            ],\n            [\n                \"aicommit2\",\n                \"A Reactive CLI that generates git commit messages with Ollama, ChatGPT, Gemini, Claude, Mistral and other AI\",\n                \"https://github.com/tak-bro/aicommit2\",\n                Categories.GIT,\n                \"05/17/2025\",\n                None,\n                Waiting_Status.DONE,\n                Types.PACKAGE,\n            ],\n            [\n                \"AngryOxide\",\n                \"802.11 Attack Tool\",\n                \"https://github.com/Ragnt/AngryOxide\",\n                Categories.N