    "zxc.20260502020122.1": "{{ $opt := \"vscodium\" -}}\n<< check opt >>\n- commands: [\"move --workspace 3\"]\n  match:\n    - window_process: { regex: \"VSCodium\" }\n{{ end -}}\n",
    "zxc.20260502020153.1": "{{ $opt := \"leo\" -}}\n<< check opt >>\n- commands: [\"move --workspace 3\"]\n  match:\n    - window_process: { regex: \"leo\" }\n{{ end -}}\n",
    "User.20260301210952.1": "- commands: ['ignore']\n  match:\n    # Ignores any Zebar windows.\n    - window_process: {equals: 'zebar'}\n    # Ignores picture-in-picture windows for browsers.\n    - window_title: {regex: '[Pp]icture.in.[Pp]icture'}\n      window_class: {regex: 'Chrome_WidgetWin_1|MozillaDialogClass'}\n    # Ignore rules for various 3rd-party apps.\n    - window_process: {equals: 'PowerToys'}\n      window_class: {regex: 'HwndWrapper\\[PowerToys\\.PowerAccent.*?\\]'}\n    - window_process: {equals: 'PowerToys'}\n      window_title: {regex: '.*? - Peek'}\n    - window_process: {equals: 'Lively'}\n      window_class: {regex: 'HwndWrapper'}\n    - window_process: {equals: 'EXCEL'}\n      window_class: {not_regex: 'XLMAIN'}\n    - window_process: {equals: 'WINWORD'}\n      window_class: {not_regex: 'OpusApp'}\n    - window_process: {equals: 'POWERPNT'}\n      window_class: {not_regex: 'PPTFrameClass'}\n",
    "User.20260301222626.1": "- commands: [\"set-floating\"]\n  match:\n    - window_process: { equals: \"Flow.Launcher\" }\n      window_title: { equals: \"Settings\" }",
    "User.20260301203613.1": "binding_modes:\n  # When enabled, the focused window can be resized via arrow keys or HJKL.\n  - name: 'resize'\n    keybindings:\n      - commands: ['resize --width -2%']\n        bindings: ['h', 'left']\n      - commands: ['resize --width +2%']\n        bindings: ['l', 'right']\n      - commands: ['resize --height +2%']\n        bindings: ['k', 'up']\n      - commands: ['resize --height -2%']\n        bindings: ['j', 'down']\n      - commands: ['wm-disable-binding-mode --name resize']\n        # Press enter/escape to return to default keybindings.\n        bindings: ['escape', 'enter']\n",
    "User.20260301203644.1": "keybindings:\n  # Shift focus in a given direction.\n  - commands: ['focus --direction left']\n    bindings: ['f24+h', 'f24+left']\n  - commands: ['focus --direction right']\n    bindings: ['f24+l', 'f24+right']\n  - commands: ['focus --direction up']\n    bindings: ['f24+k', 'f24+up']\n  - commands: ['focus --direction down']\n    bindings: ['f24+j', 'f24+down']\n  # Move focused window in a given direction.\n  - commands: ['move --direction left']\n    bindings: ['f24+shift+h', 'f24+shift+left']\n  - commands: ['move --direction right']\n    bindings: ['f24+shift+l', 'f24+shift+right']\n  - commands: ['move --direction up']\n    bindings: ['f24+shift+k', 'f24+shift+up']\n  - commands: ['move --direction down']\n    bindings: ['f24+shift+j', 'f24+shift+down']\n  # Resize focused window by a percentage or pixel amount.\n  - commands: ['resize --width -2%']\n    bindings: ['f24+u']\n  - commands: ['resize --width +2%']\n    bindings: ['f24+p']\n  - commands: ['resize --height +2%']\n    bindings: ['f24+o']\n  - commands: ['resize --height -2%']\n    bindings: ['f24+i']\n  # As an f24ernative to the resize keybindings above, resize mode enables\n  # resizing via arrow keys or HJKL. The binding mode is defined above with\n  # the name 'resize'.\n  - commands: ['wm-enable-binding-mode --name resize']\n    bindings: ['f24+r']\n  # Disables window management and all other keybindings until f24+shift+p\n  # is pressed again.\n  - commands: ['wm-toggle-pause']\n    bindings: ['f24+shift+p']\n  # Change tiling direction. This determines where new tiling windows will\n  # be inserted.\n  - commands: ['toggle-tiling-direction']\n    bindings: ['f24+v']\n  # Change focus from tiling windows -> floating -> fullscreen.\n  - commands: ['wm-cycle-focus']\n    bindings: ['f24+space']\n  # Change the focused window to be floating.\n  - commands: ['toggle-floating --centered']\n    bindings: ['f24+shift+space']\n  # Change the focused window to be tiling.\n  - commands: ['toggle-tiling']\n    bindings: ['f24+t']\n  # Change the focused window to be fullscreen.\n  - commands: ['toggle-fullscreen']\n    bindings: ['f24+f']\n  # Minimize focused window.\n  - commands: ['toggle-minimized']\n    bindings: ['f24+m']\n  # Close focused window.\n  - commands: ['close']\n    bindings: ['f24+shift+c']\n  # Kill GlazeWM process safely.\n  - commands: ['wm-exit']\n    bindings: ['f24+shift+e']\n  # Re-evaluate configuration file.\n  - commands: ['wm-reload-config']\n    bindings: ['f24+shift+r']\n  # Redraw all windows.\n  - commands: ['wm-redraw']\n    bindings: ['f24+shift+w']\n  # Launch CMD terminal. natively, use `shell-exec wt` or\n  # `shell-exec %ProgramFiles%/Git/git-bash.exe` to start Windows\n  # Terminal and Git Bash respectively.\n  - commands: ['shell-exec {{ if eq .my.terminal.windows \"wezterm\" }}{{ joinPath .chezmoi.homeDir \"scoop\" \"apps\" \"wezterm\" \"current\" \"wezterm-gui.exe\" }}{{ else if eq .my.terminal.windows \"wt\" }}{{ joinPath .chezmoi.homeDir \"scoop\" \"apps\" \"windows-terminal\" \"current\" \"wt.exe\" }}{{ else }}{{ .my.terminal.windows }}{{ end }}']\n    bindings: ['f24+enter']\n  # Focus the next/previous active workspace defined in `workspaces` config.\n  # - commands: ['focus --next-active-workspace']\n  - commands: ['shell-exec {{ if lookPath \"flameshot\" }}flameshot gui{{ else }}explorer ms-screenclip:{{ end }}']\n    bindings: ['f24+s']\n  - commands: ['focus --prev-active-workspace']\n    bindings: ['f24+a']\n  # Focus the workspace that last had focus.\n  - commands: ['shell-exec {{ if .my.modules.altrun }}{{ joinPath .chezmoi.homeDir \"scoop\" \"apps\" \"altrun\" \"current\" \"altrun.exe\" }}{{ else }}nircmd sendkey rwin press{{ end }}']\n    bindings: ['f24+d']\n  # Change focus to a workspace defined in `workspaces` config.\n  - commands: ['focus --workspace 1']\n    bindings: ['f24+1']\n  - commands: ['focus --workspace 2']\n    bindings: ['f24+2']\n  - commands: ['focus --workspace 3']\n    bindings: ['f24+3']\n  - commands: ['focus --workspace 4']\n    bindings: ['f24+4']\n  - commands: ['focus --workspace 5']\n    bindings: ['f24+5']\n  - commands: ['focus --workspace 6']\n    bindings: ['f24+6']\n  - commands: ['focus --workspace 7']\n    bindings: ['f24+7']\n  - commands: ['focus --workspace 8']\n    bindings: ['f24+8']\n  - commands: ['focus --workspace 9']\n    bindings: ['f24+9']\n  # Move the focused window's parent workspace to a monitor in a given\n  # direction.\n  - commands: ['move-workspace --direction left']\n    bindings: ['f24+shift+a']\n  - commands: ['move-workspace --direction right']\n    bindings: ['f24+shift+f']\n  - commands: ['move-workspace --direction up']\n    bindings: ['f24+shift+d']\n  - commands: ['move-workspace --direction down']\n    bindings: ['f24+shift+s']\n  # Move focused window to a workspace defined in `workspaces` config.\n  - commands: ['move --workspace 1', 'focus --workspace 1']\n    bindings: ['f24+shift+1']\n  - commands: ['move --workspace 2', 'focus --workspace 2']\n    bindings: ['f24+shift+2']\n  - commands: ['move --workspace 3', 'focus --workspace 3']\n    bindings: ['f24+shift+3']\n  - commands: ['move --workspace 4', 'focus --workspace 4']\n    bindings: ['f24+shift+4']\n  - commands: ['move --workspace 5', 'focus --workspace 5']\n    bindings: ['f24+shift+5']\n  - commands: ['move --workspace 6', 'focus --workspace 6']\n    bindings: ['f24+shift+6']\n  - commands: ['move --workspace 7', 'focus --workspace 7']\n    bindings: ['f24+shift+7']\n  - commands: ['move --workspace 8', 'focus --workspace 8']\n    bindings: ['f24+shift+8']\n  - commands: ['move --workspace 9', 'focus --workspace 9']\n    bindings: ['f24+shift+9']\n",
    "zxc.20260401221341.1": "[General]\ncheckForUpdates=false",
    "zxc.20260329012020.1": "{{- /* chezmoi:modify-template */ -}}\n{{ $origin := fromIni .chezmoi.stdin -}}\n{{ $origin = $origin | setValueAtPath \"GUI.CheckForUpdates\" false -}}\n{{ $origin = $origin | setValueAtPath \"GUI.MinimizeOnStartup\" false -}}\n{{ $origin = $origin | setValueAtPath \"GUI.ShowTrayIcon\" false -}}\n{{ $origin = $origin | setValueAtPath \"GUI.MinimizeToTray\" false -}}\n{{ $origin = $origin | setValueAtPath \"GUI.MinimizeOnClose\" false -}}\n{{ $origin = $origin | setValueAtPath \"GUI.TrayIconAppearance\" \"monochrome\" -}}\n{{ $origin = $origin | setValueAtPath \"Browser.Enabled\" true -}}\n{{ $origin = $origin | setValueAtPath \"General.MinimizeAfterUnlock\" false -}}\n{{ $origin = $origin | setValueAtPath \"General.AutoGeneratePasswordForNewEntries\" true -}}\n{{ $origin = $origin | setValueAtPath \"General.GlobalAutoTypeKey\" \"65\" -}}\n{{ $origin = $origin | setValueAtPath \"General.GlobalAutoTypeModifiers\" \"234881024\" -}}\n{{ $origin = $origin | setValueAtPath \"SSHAgent.Enabled\" false -}}\n{{ $origin = $origin | setValueAtPath \"SSHAgent.UseOpenSSH\" true -}}\n{{ $origin = $origin | setValueAtPath \"SSHAgent.UsePageant\" false -}}\n{{ $origin = $origin | setValueAtPath \"Security.AutotypeAsk\" false -}}\n{{ $origin | toIni -}}",
    "zxc.20260411192514.3": "{{- /* chezmoi:modify-template */ -}}\n{{ $origin := fromIni .chezmoi.stdin -}}\n{{ $origin = $origin | setValueAtPath \"Security.QuickUnlock\" true -}}\n{{ $origin = $origin | setValueAtPath \"General.LastActiveDatabase\" (joinPath .chezmoi.homeDir \"syncthing\" \"keepassxc\" \"main.kdbx\") -}}\n{{ $origin = $origin | setValueAtPath \"General.LastDatabases\" (joinPath .chezmoi.homeDir \"syncthing\" \"keepassxc\" \"main.kdbx\") -}}\n{{ $origin = $origin | setValueAtPath \"General.LastOpenedDatabases\" (joinPath .chezmoi.homeDir \"syncthing\" \"keepassxc\" \"main.kdbx\") -}}\n{{ $origin = $origin | setValueAtPath \"GUI.ListViewState\" \"\" -}}\n{{ $origin = $origin | setValueAtPath \"GUI.MainWindowGeometry\" \"\" -}}\n{{ $origin = $origin | setValueAtPath \"GUI.MainWindowState\" \"\" -}}\n{{ $origin = $origin | setValueAtPath \"GUI.SearchViewState\" \"\" -}}\n{{ $origin | toIni -}}",
    "zxc.20260125153252.1": "[advice]\n\taddEmptyPathspec = false\n\tpushNonFastForward = false\n\tstatusHints = false",
    "zxc.20260125153318.1": "[branch]\n\tsort = \"-committerdate\"",
    "zxc.20260125153946.1": "[color \"decorate\"]\n\tHEAD = \"red\"\n\tbranch = \"blue\"\n\tremoteBranch = \"magenta\"\n\ttag = \"yellow\"",
    "zxc.20260125153958.1": "[color \"diff\"]\n\tcontext = \"white\"\n\tfrag = \"magenta\"\n\tmeta = \"blue bold\"\n\told = \"red\"\n\twhitespace = \"yellow reverse\"\n",
    "zxc.20260125153928.1": "[color \"branch\"]\n\tcurrent = \"magenta\"\n\tlocal = \"default\"\n\tplain = \"blue\"\n\tremote = \"yellow\"\n\tupstream = \"green\"",
    "zxc.20260125153436.1": "[culumn]\n\tui = \"auto\"",
    "zxc.20260125153348.1": "[commit]\n\ttemplate = \"~/.config/git/template\"\n\tgpgsign = true\n\tverbose = true",
    "zxc.20260125153401.1": "[core]\n\tcompression = 9\n\teditor = \"{{ template \"editor\" }}\"\n\texcludesfile = \"~/.gitignore\"\n\tfsmonitor = true\n        {{ if lookPath \"delta\" -}}\n        pager = delta\n        {{ else if lookPath \"diff-so-fancy\" -}}\n\tpager = \"diff-so-fancy | less '--tabs=4' -RFX\"\n        {{ end -}}\n\tpreloadindex = true\n\tuntrackedCache = true\n\twhitespace = \"error\"\n\tautocrlf = \"input\"\n{{ if eq .chezmoi.os \"windows\" }}\tsshCommand = 'C:\\\\Program Files\\\\OpenSSH-Win64\\\\ssh.EXE'\n{{ end -}}",
    "zxc.20260202215744.1": "{{ if eq .chezmoi.os \"windows\" -}}\n{{ if lookPath \"git-credential-gopass\" -}}\n[credential]\n\thelper = \"gopass\"\n[credential \"helperselector\"]\n\tselected = gopass\n{{ else -}}\n[credential]\n\thelper = !\\\"{{ .chezmoi.homeDir }}/scoop/apps/git/current/mingw64/bin/git-credential-manager.exe\\\"\n[credential \"helperselector\"]\n    selected = manager\n{{ end -}}\n{{ end -}}",
    "zxc.20260202215728.1": "{{ if eq .chezmoi.os \"linux\" -}}\n{{ if lookPath \"gopass\" -}}\n[credential]\n\thelper = \"gopass\"\n{{ end -}}\n{{ end -}}",
    "zxc.20260125154038.1": "[credential \"https://gist.github.com\"]\n\thelper = !{{ lookPath \"gh\" | replace \"\\\\\" \"\\\\\\\\\" | squote }} auth git-credential",
    "zxc.20260125154056.1": "[credential \"https://github.com\"]\n\thelper = !{{ lookPath \"gh\" | replace \"\\\\\" \"\\\\\\\\\" | squote }} auth git-credential\n",
    "zxc.20260125153456.1": "[delta]\nside-by-side = true\nnavitage = true\nfile-yellow = true",
    "zxc.20260125153507.1": "[diff]\n\talgorithm = \"histogram\"\n\tcolorMoved = \"plain\"\n\tcontext = 3\n\tinterHunkContext = 10\n\tmnemonicPrefix = true\n\trenames = true",
    "zxc.20260125153521.1": "[diff-so-fancy]\n\tchangeHunkIndicators = true\n\tmarkEmptyLines = false\n\tstripLeadingSymbols = true\n\tuseUnicodeRuler = true",
