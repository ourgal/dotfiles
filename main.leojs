    "zxc.20260125153546.1": "[filter \"lfs\"]\n\tclean = \"git-lfs clean -- %f\"\n\tprocess = \"git-lfs filter-process\"\n\trequired = true\n\tsmudge = \"git-lfs smudge -- %f\"",
    "User.20260217125649.1": "{{ if .my.git.sign.ssh -}}\n[gpg]\n\tformat = \"ssh\"\n[gpg \"ssh\"]\n{{ if eq .chezmoi.os \"windows\" }}\tprogram = {{ lookPath \"ssh-keygen\" | replace \"\\\\\" \"\\\\\" | quote }}\n{{ end -}}\n{{ end -}}",
