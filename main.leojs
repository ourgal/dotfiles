    "zxc.20260330235914.1": "{{- /* chezmoi:modify-template */ -}}\n{{ $origin := fromYaml .chezmoi.stdin -}}\n{{ $origin = $origin | setValueAtPath \"show_notifications\" false -}}\n{{ $origin | toYaml -}}",
    "zxc.20260609212401.1": "<< dos >>\n{{ if lookPath \"firefox\" -}}\n@others\n{{ end -}}\n{{ end -}}\n",
    "zxc.20260609212435.1": "user_pref(\"browser.search.region\", \"US\");\nuser_pref(\"sidebar.visibility\", \"hide-sidebar\");\n\n{{ if eq .my.modules.firefox.theme \"shyfox\" -}}\n{{ template \"include\" (joinPath .chezmoi.homeDir \"scoop\" \"persist\" \"firefox\" \"shyfox\" \"user.js\") }}\n{{ else if eq .my.modules.firefox.theme \"flexfox\" -}}\n{{ template \"include\" (joinPath .chezmoi.homeDir \"scoop\" \"persist\" \"firefox\" \"flexfox\" \"scripts\" \"user.js\") }}\n{{ end -}}\n",
    "zxc.20260518220745.1": "{\n    \"version\": \"1.1.15.1\",\n    \"description\": \"A spaceship from Potato World crashes onto an alien planet. The sole survivor: Brotato, the only potato capable of handling 6 weapons at the same time. Waiting to be rescued by his mates, Brotato must survive in this hostile environment.\",\n    \"homepage\": \"https://freegogpcgames.com/32560/brotato/\",\n    \"architecture\": {\n        \"64bit\": {\n            \"url\": \"{{ .my.dufs.bucket.host }}/bucket/games/brotato.7z\",\n            \"hash\": \"1b23c8a3db488d7c6cf68750f0b7a8c6260daea2c6e6bfc5b208ae2641cc7eb7\"\n        }\n    },\n    \"post_install\": [\n        \"$name = \\\"brotato\\\"\",\n        \"$path = \\\"${env:APPDATA}\\\\brotato\\\\GOG-saves\\\"\",\n        \"$saves = if ($env:game_saves) { $env:game_saves } else { \\\"$env:USERPROFILE\\\\Documents\\\\game_saves\\\" }\",\n        \"mkdir -p $saves\\\\$name >$null 2>$null\",\n        \"New-Item -ItemType Junction -Path $path -Target $saves\\\\$name >$null\"\n    ],\n    \"shortcuts\": [\n        [\n            \"Brotato.exe\",\n            \"Brotato\"\n        ]\n    ]\n}",
    "zxc.20260521181617.1": "{\n    \"version\": \"1.1.1a\",\n    \"description\": \"Click, craft and collect your way to alchemical mastery. Progress through a branching skill tree and explore the forbidden woods. Collect resources and build machines of magic. Slay monsters, farm crops and automate your production to become the all-powerful Forage Wizard!\",\n    \"homepage\": \"https://byrutgame.org/54765-forage-wizard.html\",\n    \"architecture\": {\n        \"64bit\": {\n            \"url\": \"{{ .my.dufs.bucket.host }}/bocket/games/forage_wizard.7z\",\n            \"hash\": \"becc8887850006439631ec02c728f31d6da3911586717cd90a2e42cfb3000884\"\n        }\n    },\n    \"post_install\": [\n        \"$name = \\\"forage_wizard\\\"\",\n        \"$path = \\\"${env:USERPROFILE}\\\\AppData\\\\LocalLow\\\\Lost Maxim\\\\Forage Wizard\\\"\",\n        \"$saves = if ($env:game_saves) { $env:game_saves } else { \\\"$env:USERPROFILE\\\\Documents\\\\game_saves\\\" }\",\n        \"mkdir -p $saves\\\\$name >$null 2>$null\",\n        \"New-Item -ItemType Junction -Path $path -Target $saves\\\\$name >$null\"\n    ],\n    \"shortcuts\": [\n        [\n            \"Forage Wizard.exe\",\n            \"Forage Wizard\"\n        ]\n    ]\n}",
    "zxc.20260519083439.1": "{\n    \"version\": \"20973329\",\n    \"description\": \"The Mahjong Roguelike. Aotenjo: Infinite Hands is an deckbuilder where you will use Mahjong styles all over the world to beat innate threats, play different Patterns and combos, reach the \\\"bottom\\\" of Aotenjo, and discover ancient secrets....\",\n    \"homepage\": \"https://byrutgame.org/index.php?do=download&id=176872\",\n    \"architecture\": {\n        \"64bit\": {\n            \"url\": \"{{ .my.dufs.bucket.host }}/bucket/games/aotenjo.7z\",\n            \"hash\": \"43b66ee21523bbc7cf7b99b455450e0e252a71593552021f0c5a1b37eb2b52bc\"\n        }\n    },\n    \"post_install\": [\n        \"$name = \\\"aotenjo\\\"\",\n        \"$path = \\\"${env:USERPROFILE}\\\\AppData\\\\LocalLow\\\\Aotenjo\\\\Aotenjo\\\"\",\n        \"$saves = if ($env:game_saves) { $env:game_saves } else { \\\"$env:USERPROFILE\\\\Documents\\\\game_saves\\\" }\",\n        \"mkdir -p $saves\\\\$name >$null 2>$null\",\n        \"New-Item -ItemType Junction -Path $path -Target $saves\\\\$name >$null\"\n    ],\n    \"shortcuts\": [\n        [\n            \"Aotenjo.exe\",\n            \"Aotenjo\"\n        ]\n    ]\n}",
    "zxc.20260519140821.1": "{\n    \"version\": \"1.14.112\",\n    \"description\": \"Mow down thousands of night creatures and survive until dawn! Vampire Survivors is a gothic horror casual game with rogue-lite elements, where your choices can allow you to quickly snowball against the hundreds of monsters that get thrown at you. Be the bullet hell!\",\n    \"homepage\": \"https://byrutgame.org/23136-vampire-survivors.html\",\n    \"architecture\": {\n        \"64bit\": {\n            \"url\": \"{{ .my.dufs.bucket.host }}/bucket/games/VampireSurvivors.7z\",\n            \"hash\": \"031394a987a50b75506eec57639bbf782ef09db26da646e8465bc2162e32e17c\"\n        }\n    },\n    \"shortcuts\": [\n        [\n            \"VampireSurvivors.exe\",\n            \"Vampire Survivors\"\n        ]\n    ]\n}",
    "zxc.20260623195308.1": "{\n    \"version\": \"1.2.0a\",\n    \"description\": \"Manage your own discount supermarket! Get caught up in small-town drama, organize and plan your shop's layout, and strike lucrative trade deals as you expand your secretive aunt's business empire. Selling more frozen fries will surely heal this broken community...right?\",\n    \"homepage\": \"https://igg-games.com/discounty-free-download.html\",\n    \"architecture\": {\n        \"64bit\": {\n            \"url\": \"{{ .my.dufs.bucket.host }}/bucket/games/discounty.7z\",\n            \"hash\": \"a1924f7451033863acdd68c44426ef08c21f7f0b1074ee910e09dd7e777078bb\"\n        }\n    },\n    \"shortcuts\": [\n        [\n            \"Discounty.exe\",\n            \"Discounty\"\n        ]\n    ]\n}\n",
    "zxc.20260520104153.1": "{\n    \"version\": \"1.4.1a\",\n    \"description\": \"From the creators of Vampire Survivors comes a turbo-charged, turn-based roguelite deckbuilder! Deal world-ending combos, blitz through infested dungeons, and master the Turboturn to obliterate hordes of familiar foes with a chaotic hand of cards.\",\n    \"homepage\": \"https://byrutgame.org/53218-vampire-crawlers-the-turbo-wildcard-from-vampire-survivors.html\",\n    \"architecture\": {\n        \"64bit\": {\n            \"url\": \"{{ .my.dufs.bucket.host }}/bucket/games/VampireCrawlers.7z\",\n            \"hash\": \"2ffe6417de8191d4f6c61d1fcbab8d460d2db999a41e79529cf26947df792247\"\n        }\n    },\n    \"post_install\": [\n        \"$name = \\\"vampire_crawlers\\\"\",\n        \"$path = \\\"${env:USERPROFILE}\\\\AppData\\\\LocalLow\\\\Nosebleed Interactive\\\\Vampire Crawlers\\\\save\\\"\",\n        \"$saves = if ($env:game_saves) { $env:game_saves } else { \\\"$env:USERPROFILE\\\\Documents\\\\game_saves\\\" }\",\n        \"mkdir -p $saves\\\\$name >$null 2>$null\",\n        \"New-Item -ItemType Junction -Path $path -Target $saves\\\\$name >$null\"\n    ],\n    \"shortcuts\": [\n        [\n            \"Vampire Crawlers.exe\",\n            \"Vampire Crawlers\"\n        ]\n    ]\n}",
    "zxc.20260521144357.1": "{\n    \"version\": \"1.0.1\",\n    \"description\": \"The Animal Evolution Roguelite. Hunt, Flee, Scavenge and Thrive in a living ecosystem. Choose from 125+ Evolutions and Specialisations for unique creature combinations in every run. Adapt to survive the natural curve in order to beat carcinisation... or get Darwin'd trying!\",\n    \"homepage\": \"https://byrutgame.org/53330-everything-is-crab-the-animal-evolution-roguelite.html\",\n    \"architecture\": {\n        \"64bit\": {\n            \"url\": \"{{ .my.dufs.bucket.host }}/bucket/games/everything_is_crab.7z\",\n            \"hash\": \"df10b29274725b5e4f84a0320c2277fe19609456338d9ac796aa45176f84db6b\"\n        }\n    },\n    \"post_install\": [\n        \"$name = \\\"everything_is_crab\\\"\",\n        \"$path = \\\"${env:USERPROFILE}\\\\AppData\\\\LocalLow\\\\Odd Dreams Digital\\\\Everything is Crab\\\\SyncedData\\\\Steam\\\\real\\\"\",\n        \"$saves = if ($env:game_saves) { $env:game_saves } else { \\\"$env:USERPROFILE\\\\Documents\\\\game_saves\\\" }\",\n        \"mkdir -p $saves\\\\$name >$null 2>$null\",\n        \"New-Item -ItemType Junction -Path $path -Target $saves\\\\$name >$null\"\n    ],\n    \"shortcuts\": [\n        [\n            \"steamclient_loader.exe\",\n            \"Everything is Crab\"\n        ]\n    ]\n}",
    "zxc.20260523104524.1": "{\n    \"version\": \"1.2.1.3-4986\",\n    \"description\": \"Explore a vast cavern of creatures, relics and resources in a mining sandbox adventure for 1-8 players. Mine, build, fight, craft and farm to unravel the mystery of the ancient Core.\",\n    \"homepage\": \"https://byrutgame.org/21317-core-keeper.html\",\n    \"architecture\": {\n        \"64bit\": {\n            \"url\": \"{{ .my.dufs.bucket.host }}/bucket/games/core_keeper.7z\",\n            \"hash\": \"a6a47876c60a1f056183a1863b81b025f041c67b3a02620b5b084a20d4fae73a\"\n        }\n    },\n    \"post_install\": [\n        \"$name = \\\"core_keeper\\\"\",\n        \"$path = \\\"${env:USERPROFILE}\\\\AppData\\\\LocalLow\\\\Pugstorm\\\\Core Keeper\\\\Steam\\\\848908519\\\"\",\n        \"$saves = if ($env:game_saves) { $env:game_saves } else { \\\"$env:USERPROFILE\\\\Documents\\\\game_saves\\\" }\",\n        \"mkdir -p $saves\\\\$name >$null 2>$null\",\n        \"New-Item -ItemType Junction -Path $path -Target $saves\\\\$name >$null\"\n    ],\n    \"shortcuts\": [\n        [\n            \"CoreKeeper.exe\",\n            \"Core Keeper\"\n        ]\n    ]\n}",
    "zxc.20260523113725.1": "{\n    \"version\": \"1.54.1\",\n    \"description\": \"Use the magical device known as the Chronicon to travel into the souls and memories of fallen heroes to re-live their grand tales! Epic adventures full of loot and monsters await!\",\n    \"homepage\": \"https://byrutgame.org/7250-chronicon.html\",\n    \"architecture\": {\n        \"64bit\": {\n            \"url\": \"{{ .my.dufs.bucket.host }}/bucket/games/chronicon.7z\",\n            \"hash\": \"233e2299b04da5b68bf7c12bf3552a7609bcdf2d5115e794bbf2cee8c314df7e\"\n        }\n    },\n    \"post_install\": [\n        \"$name = \\\"chronicon\\\"\",\n        \"$path = \\\"${env:USERPROFILE}\\\\AppData\\\\Local\\\\Chronicon\\\\save\\\"\",\n        \"$saves = if ($env:game_saves) { $env:game_saves } else { \\\"$env:USERPROFILE\\\\Documents\\\\game_saves\\\" }\",\n        \"mkdir -p $saves\\\\$name >$null 2>$null\",\n        \"New-Item -ItemType Junction -Path $path -Target $saves\\\\$name >$null\"\n    ],\n    \"shortcuts\": [\n        [\n            \"Chronicon.exe\",\n            \"Chronicon\"\n        ]\n    ]\n}",
    "zxc.20260523115059.1": "{\n    \"version\": \"1.0.5\",\n    \"description\": \"Raise your daughter while she attends a magical academy. Choose which classes she attends, jobs she does, training she undergoes, and more in a character raising sim packed full of story and over 50 endings to reach. How she grows up to be the world's cutest princess depends on you! \",\n    \"homepage\": \"https://byrutgame.org/54539-magical-princess.html\",\n    \"architecture\": {\n        \"64bit\": {\n            \"url\": \"{{ .my.dufs.bucket.host }}/bucket/games/magical_princess.7z\",\n            \"hash\": \"2befa2834cc9ad2b0b72099271712ecd0ebdf9e4b8a56813e9b0ced0178ed9e0\"\n        }\n    },\n    \"post_install\": [\n        \"$name = \\\"magical_princess\\\"\",\n        \"$path = \\\"${env:USERPROFILE}\\\\AppData\\\\LocalLow\\\\Neotro Inc_\\\\MagicalPrincess\\\"\",\n        \"$saves = if ($env:game_saves) { $env:game_saves } else { \\\"$env:USERPROFILE\\\\Documents\\\\game_saves\\\" }\",\n        \"mkdir -p $saves\\\\$name >$null 2>$null\",\n        \"New-Item -ItemType Junction -Path $path -Target $saves\\\\$name >$null\"\n    ],\n    \"shortcuts\": [\n        [\n            \"MagicalPrincess.exe\",\n            \"Magical Princess\"\n        ]\n    ]\n}",
    "zxc.20260521113930.1": "{\n    \"version\": \"1.0\",\n    \"description\": \"First game of a four-part visual novel series. Nerdy Itsuki Ninomae accidentally creates a “digital hypnotism movie.” Showing it to his neighbor causes him to learn her and a classmate’s dark secret, dragging him into the underbelly of society.\",\n    \"homepage\": \"https://store.steampowered.com/app/2552410/Liminal_Border_Part_I/\",\n    \"architecture\": {\n        \"64bit\": {\n            \"url\": \"{{ .my.dufs.bucket.host }}/bucket/gal/liminal_border_1.7z\",\n            \"hash\": \"a1ad8798f2349482261528f22245521fcab75bb08b9f8e7e68a8b2e931d48196\"\n        }\n    },\n    \"post_install\": [\n        \"$name = \\\"liminal_border_1\\\"\",\n        \"$path = \\\"$dir\\\\savedata\\\"\",\n        \"$saves = if ($env:game_saves) { $env:game_saves } else { \\\"$env:USERPROFILE\\\\Documents\\\\game_saves\\\" }\",\n        \"mkdir -p $saves\\\\$name >$null 2>$null\",\n        \"New-Item -ItemType Junction -Path $path -Target $saves\\\\$name >$null\"\n    ],\n    \"shortcuts\": [\n        [\n            \"Liminal_Border_Part_1.exe\",\n            \"Liminal Border Part 1\"\n        ]\n    ]\n}",
    "zxc.20260522191815.1": "{\n    \"version\": \"1.0\",\n    \"description\": \"Unfairly saddled with crippling debt after the events of Part I, Itsuki Ninomae and the gang turn to fellow student and daughter of a crime lord Kotoko Teshigawara for help. An intertwined web of loyalties and desire awaits as Itsuki, Kotoko and the others fight for justice.\",\n    \"homepage\": \"https://store.steampowered.com/app/2730350/Liminal_Border_Part_II/\",\n    \"architecture\": {\n        \"64bit\": {\n            \"url\": \"{{ .my.dufs.bucket.host }}/bucket/gal/liminal_border_2.7z\",\n            \"hash\": \"65f0c7697a1db5a2b18ed8aa478fa8d9ed6a0df41660ab576b273a25ae9d3c02\"\n        }\n    },\n    \"post_install\": [\n        \"$name = \\\"liminal_border_2\\\"\",\n        \"$path = \\\"$dir\\\\savedata\\\"\",\n        \"$saves = if ($env:game_saves) { $env:game_saves } else { \\\"$env:USERPROFILE\\\\Documents\\\\game_saves\\\" }\",\n        \"mkdir -p $saves\\\\$name >$null 2>$null\",\n        \"New-Item -ItemType Junction -Path $path -Target $saves\\\\$name >$null\"\n    ],\n    \"shortcuts\": [\n        [\n            \"Liminal_Border_Part_2.exe\",\n            \"Liminal Border Part 2\"\n        ]\n    ]\n}",
    "zxc.20260523013141.1": "{\n    \"version\": \"1.0\",\n    \"description\": \"Following the events of Part II, Itsuki and the gang's \\\"Rave\\\" business is close to getting off the ground. Itsuki looks to Meryl Hathaway, a young girl often seen accompanying Kotoko, as a counter to the violence of the Umon-kai as he searches for a way to destroy them once and for all. \",\n    \"homepage\": \"https://store.steampowered.com/app/3094040/Liminal_Border_Part_III/\",\n    \"architecture\": {\n        \"64bit\": {\n            \"url\": \"{{ .my.dufs.bucket.host }}/bucket/gal/liminal_border_3.7z\",\n            \"hash\": \"ffc61e670bdf08b76ac52289ace1e21024686405ba5a5a37e827c7c34acfedf0\"\n        }\n    },\n    \"post_install\": [\n        \"$name = \\\"liminal_border_3\\\"\",\n        \"$path = \\\"$dir\\\\savedata\\\"\",\n        \"$saves = if ($env:game_saves) { $env:game_saves } else { \\\"$env:USERPROFILE\\\\Documents\\\\game_saves\\\" }\",\n        \"mkdir -p $saves\\\\$name >$null 2>$null\",\n        \"New-Item -ItemType Junction -Path $path -Target $saves\\\\$name >$null\"\n    ],\n    \"shortcuts\": [\n        [\n            \"Liminal_Border_Part_3.exe\",\n            \"Liminal Border Part 3\"\n        ]\n    ]\n}",
    "zxc.20260524153217.1": "{\n    \"version\": \"1.0\",\n    \"description\": \"A revenge-driven adult adventure game. Betrayed by your childhood friend turned ruthless CEO, you're given one month in his estate. Seduce his wife, sister, and mother. Manage your schedule, play minigames, and make choices that shape your path to payback. \",\n    \"homepage\": \"https://store.steampowered.com/app/3591440/Liminal_Border_Part_IV/\",\n    \"architecture\": {\n        \"64bit\": {\n            \"url\": \"{{ .my.dufs.bucket.host }}/bucket/gal/SPITE.Taking.the.Bosss.Wife.Sister.and.Mother.7z\",\n            \"hash\": \"751cec0995026a272b8642a26319b059ee200c5d8604e9916e295f2afa5ff11f\"\n        }\n    },\n    \"shortcuts\": [\n        [\n            \"spite.exe\",\n            \"SPITE Taking the Boss's Wife, Sister and Mother\"\n        ]\n    ]\n}",
    "zxc.20260520112127.1": "{\n    \"version\": \"1.0\",\n    \"description\": \"Café Stella and the Reaper’s Butterflies is a Japanese-style visual novel produced by Yuzusoft, a Japanese developer of romance VNs. It won numerous awards in the year of its release in Japan for its art, music, and characters.\",\n    \"homepage\": \"https://byrutgame.org/25210-cafe-stella-and-the-reapers-butterflies.html\",\n    \"architecture\": {\n        \"64bit\": {\n            \"url\": \"{{ .my.dufs.bucket.host }}/bucket/gal/cafe_stella_and_the_reapers_butterflies.7z\",\n            \"hash\": \"0eb4803fed0e18865142855b3f473748a216382ab5f620fb3dd035f3b83342d0\"\n        }\n    },\n    \"post_install\": [\n        \"$name = \\\"cafe_stella_and_the_reapers_butterflies\\\"\",\n        \"$path = \\\"$dir\\\\savedata\\\"\",\n        \"$saves = if ($env:game_saves) { $env:game_saves } else { \\\"$env:USERPROFILE\\\\Documents\\\\game_saves\\\" }\",\n        \"mkdir -p $saves\\\\$name >$null 2>$null\",\n        \"New-Item -ItemType Junction -Path $path -Target $saves\\\\$name >$null\"\n    ],\n    \"shortcuts\": [\n        [\n            \"CafeStella.exe\",\n            \"Cafe Stella and the Reaper's Butterflies\"\n        ]\n    ]\n}",
    "zxc.20260523130446.1": "{\n    \"version\": \"1.0\",\n    \"description\": \"A new chapter begins with the arrival of the catgirl, Fraise! She seeks advice from his little sister, Shigure and while Fraise feels the relationship between siblings is most important, Shigure priorities the happiness of her catgirls. This sets the stage in the battle between catgirl and girl!\",\n    \"homepage\": \"https://store.steampowered.com/app/3655150/NEKOPARA_After/\",\n    \"architecture\": {\n        \"64bit\": {\n            \"url\": \"{{ .my.dufs.bucket.host }}/bucket/gal/nekopara_after.7z\",\n            \"hash\": \"542be7199af34c0e95158fd5d2080388fd84f0d46405fe1e9ee7633dfe316709\"\n        }\n    },\n    \"post_install\": [\n        \"$name = \\\"nekopara_after\\\"\",\n        \"$path = \\\"$dir\\\\savedata\\\"\",\n        \"$saves = if ($env:game_saves) { $env:game_saves } else { \\\"$env:USERPROFILE\\\\Documents\\\\game_saves\\\" }\",\n        \"mkdir -p $saves\\\\$name >$null 2>$null\",\n        \"New-Item -ItemType Junction -Path $path -Target $saves\\\\$name >$null\"\n    ],\n    \"shortcuts\": [\n        [\n            \"nekopara_after.exe\",\n            \"NEKOPARA After\"\n        ]\n    ]\n}",
    "zxc.20260526223321.1": "{\n    \"version\": \"1.2.1\",\n    \"description\": \"Fracture Field is an idle/incremental quarry mining game. Shatter rocks with timed swings then invest your earnings into upgrades. Build a fleet of drones to automate your empire, bomb tough layers, and unlock powerful prestige upgrades on your journey to master the quarry.\",\n    \"homepage\": \"https://store.steampowered.com/app/3946110/Fracture_Field/\",\n    \"architecture\": {\n        \"64bit\": {\n            \"url\": \"{{ .my.dufs.bucket.host }}/bucket/games/fracture_field.7z\",\n            \"hash\": \"efd1f0ff3769a26bae2d310846a30d07d3272b112d04d11aaff11ce901c9a2da\"\n        }\n    },\n    \"shortcuts\": [\n        [\n            \"Fracture Field.exe\",\n            \"Fracture Field\"\n        ]\n    ]\n}",
    "zxc.20260529233633.1": "{\n    \"version\": \"1.0\",\n    \"description\": \"Beast Saga is an open-world RPG set in a martial arts universe where you play as a young wolf tribe member named Lang Jiusi. Immerse yourself in a world of free exploration, gathering, crafting, life skills, martial arts cultivation, forming alliances and experiencing unique Jianghu adventures.\",\n    \"homepage\": \"https://igg-games.com/beast-saga-free-download.html\",\n    \"architecture\": {\n        \"64bit\": {\n            \"url\": \"{{ .my.dufs.bucket.host }}/bucket/games/beast_saga.7z\",\n            \"hash\": \"17aae69e64855336b003a3bc8fe5f6037a68c12caa2f6d57e224d41e7157f744\"\n        }\n    },\n    \"post_install\": [\n        \"$name = \\\"beast_saga\\\"\",\n        \"$path = \\\"$dir\\\\SaveData\\\"\",\n        \"$saves = if ($env:game_saves) { $env:game_saves } else { \\\"$env:USERPROFILE\\\\Documents\\\\game_saves\\\" }\",\n        \"mkdir -p $saves\\\\$name >$null 2>$null\",\n        \"New-Item -ItemType Junction -Path $path -Target $saves\\\\$name >$null\"\n    ],\n    \"shortcuts\": [\n        [\n            \"BeastSaga.exe\",\n            \"Beast Saga\"\n        ]\n    ]\n}",
    "zxc.20260530002240.1": "{\n    \"version\": \"1.0\",\n    \"description\": \"STARDUST: Wish of Witch is a single-player SRPG beautifully crafted in pixel art. Follow the secret of the wish-granting star and join the adventure of the girl “Star” and the mage “Yu”.\",\n    \"homepage\": \"https://igg-games.com/stardust-wish-of-witch-free-download.html\",\n    \"architecture\": {\n        \"64bit\": {\n            \"url\": \"{{ .my.dufs.bucket.host }}/bucket/games/stardust_wish_of_witch.7z\",\n            \"hash\": \"29b05e2941a6a4563fe88d6d6d1057c3d9ecb82288425568a13e0b5e32494e95\"\n        }\n    },\n    \"post_install\": [\n        \"$name = \\\"stardust_wish_of_witch\\\"\",\n        \"$path = \\\"${env:USERPROFILE}\\\\AppData\\\\LocalLow\\\\KnivStudio\\\\StarDust_Steam\\\"\",\n        \"$saves = if ($env:game_saves) { $env:game_saves } else { \\\"$env:USERPROFILE\\\\Documents\\\\game_saves\\\" }\",\n        \"mkdir -p $saves\\\\$name >$null 2>$null\",\n        \"New-Item -ItemType Junction -Path $path -Target $saves\\\\$name >$null\"\n    ],\n    \"shortcuts\": [\n        [\n            \"StarDust_Steam.exe\",\n            \"STARDUST Wish of Witch\"\n        ]\n    ]\n}",
    "zxc.20260601154622.1": "{\n    \"version\": \"1.0.23\",\n    \"description\": \"A coin-pushing dopamine machine. RACCOIN is a roguelike deckbuilder where you combine special coins with powerful items to trigger wildly satisfying combos. Stack shiny towers, spin the lucky wheel, and shake the machine until all the coins drop.\",\n    \"homepage\": \"https://igg-games.com/raccoin-coin-pusher-roguelike-free-download.html\",\n    \"architecture\": {\n        \"64bit\": {\n            \"url\": \"{{ .my.dufs.bucket.host }}/bucket/games/raccoin.7z\",\n            \"hash\": \"79efa8e8a3a373e53cab1f7ad83e2cfac689bbc0f897bfd7711eec73b2991f85\"\n        }\n    },\n    \"post_install\": [\n        \"$name = \\\"raccoin\\\"\",\n        \"$path = \\\"${env:USERPROFILE}\\\\DoraccoonGames\\\\RACCOIN\\\\SaveData\\\\76561197960287930\\\"\",\n        \"$saves = if ($env:game_saves) { $env:game_saves } else { \\\"$env:USERPROFILE\\\\Documents\\\\game_saves\\\" }\",\n        \"mkdir -p $saves\\\\$name >$null 2>$null\",\n        \"New-Item -ItemType Junction -Path $path -Target $saves\\\\$name >$null\"\n    ],\n    \"shortcuts\": [\n        [\n            \"RACCOIN.exe\",\n            \"RACCOIN Coin Pusher Roguelike\"\n        ]\n    ]\n}\n",
    "zxc.20260623220951.1": "{\n    \"version\": \"1.0\",\n    \"description\": \"Snacktorio is a level-based cooking automation game where you build & scale food production lines to feed the beasts threatening to consume your world. Manage strange ingredients across sprawling cooking factories to keep the monsters fed while you uncover what's stirring their growing appetites...\",\n    \"homepage\": \"https://igg-games.com/snacktorio-free-download.html\",\n    \"architecture\": {\n        \"64bit\": {\n            \"url\": \"{{ .my.dufs.bucket.host }}/bucket/games/snacktorio.7z\",\n            \"hash\": \"1327c26095e0362487632364dfc37c6b2bcedade273ad2be77bf880ade6d97d6\"\n        }\n    },\n    \"post_install\": [\n        \"$name = \\\"snacktorio\\\"\",\n        \"$path = \\\"${env:USERPROFILE}\\\\AppData\\\\Roaming\\\\Snacktorio\\\"\",\n        \"$saves = if ($env:game_saves) { $env:game_saves } else { \\\"$env:USERPROFILE\\\\Documents\\\\game_saves\\\" }\",\n        \"mkdir -p $saves\\\\$name >$null 2>$null\",\n        \"New-Item -ItemType Junction -Path $path -Target $saves\\\\$name >$null\"\n    ],\n    \"shortcuts\": [\n        [\n            \"Snacktorio.exe\",\n            \"Snacktorio\"\n        ]\n    ]\n}\n",
    "zxc.20260125211938.1": "<< dos >>\n{{ if lookPath \"pwsh\" -}}\n@others\n{{ end -}}\n{{ end -}}\n",
    "zxc.20260316162600.1": "#Requires AutoHotkey v2.0\n#SingleInstance Force\n\nLWin::F24\nRWin::F24",
    "zxc.20260323180608.1": "InstallKeybdHook\nInstallMouseHook\nCoordMode(\"mouse\", \"screen\")\n\nOnExit (*) => SystemCursor(\"Show\")  ; Ensure the cursor is made visible when the script exits\n\nSetTimer(Main, 10)\n\nMain() {\n\n   if(A_TimeIdleKeyboard < 25)\n      ;A keyboard key has been pressed, hide cursor\n      SystemCursor(\"Hide\")\n\n   else if(A_TimeIdleMouse < 25)\n      ;Mouse have been used, show cursor\n      SystemCursor(\"Show\")\n}\n\nSystemCursor(cmd) { ; cmd = \"Show|Hide|Toggle|Reload\"\n\n   static visible := true, c := Map()\n   static sys_cursors := [32512, 32513, 32514, 32515, 32516, 32642, 32643, 32644, 32645, 32646, 32648, 32649, 32650]\n\n   if (cmd = \"Reload\" or !c.Count) { ; Reload when requested or at first call.\n\n      for i, id in sys_cursors {\n         h_cursor := DllCall(\"LoadCursor\", \"Ptr\", 0, \"Ptr\", id)\n         h_default := DllCall(\"CopyImage\", \"Ptr\", h_cursor, \"UInt\", 2, \"Int\", 0, \"Int\", 0, \"UInt\", 0)\n         h_blank := DllCall(\"CreateCursor\", \"Ptr\", 0, \"Int\", 0, \"Int\", 0, \"Int\", 32, \"Int\", 32, \"Ptr\", Buffer(32 * 4, 0xFF), \"Ptr\", Buffer(32 * 4, 0))\n         c[id] := { default: h_default, blank: h_blank }\n      }\n   }\n\n   switch cmd {\n      case \"Show\":\n         if (!visible)\n            visible := true\n         else\n            return\n      case \"Hide\":\n         if (visible)\n            visible := false\n         else\n            return\n      case \"Toggle\":\n         visible := !visible\n      default: return\n   }\n\n   for id, handles in c {\n      h_cursor := DllCall(\"CopyImage\", \"Ptr\", visible ? handles.default : handles.blank, \"UInt\", 2, \"Int\", 0, \"Int\", 0, \"UInt\", 0)\n      DllCall(\"SetSystemCursor\", \"Ptr\", h_cursor, \"UInt\", id)\n   }\n}",
    "zxc.20260413210312.1": "<< os >>\n#Requires AutoHotkey v2.0\n#SingleInstance Force\n\nRun \"gopass show -c keepassxc/main\", ,\"Hide\"\nWinWait \"Message from User\"\n\n{{ if includeTemplate \"opt\" (dict \"chezmoi\" .chezmoi \"my\" .my \"cmd\" \"glazewm\" \"opt\" (list \"windows\" \"startup\" \"glazewm\" \"enable\") \"os\" \"windows\") | trim | atoi -}}\nRun \"glazewm command focus --workspace 9\"\n{{ end -}}\nRun \"keepassxc\"\nWinWaitActive \" - KeePassXC\"\nWinActive \" - KeePassXC\"\n\nSend \"^v\"\nSend \"{Enter}\"\nreturn\n",
    "zxc.20260423145238.1": "---\n@others\n@language yaml",
    "zxc.20260501183147.1": "all:\n  hosts:\n    chromebit:\n      ansible_user: user\n      ansible_host: chromebit.local\n      ansible_become_method: doas\n      ansible_become_pass: \"{{ gopass \"password/linux/user\" }}\"\n",
    "zxc.20260501183207.1": "windows:\n  vars:\n    ansible_connection: ssh\n    ansible_shell_type: powershell\n  hosts:\n    nuc:\n      ansible_host: nuc.local\n      my_hostname: nuc\n    bed:\n      ansible_host: bed.local\n      my_hostname: bed\n    work:\n      ansible_host: 192.168.1.110\n      my_hostname: work\n",
    "zxc.20260501183224.1": "wsl-debian:\n  vars:\n    ansible_connection: community.general.wsl\n    ansible_user: user\n  hosts:\n    nuc-windows-wsl-debian:\n      ansible_host: nuc.local\n      wsl_distribution: debian\n      wsl_user: root\n",
