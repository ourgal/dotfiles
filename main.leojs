    "zxc.20260616145557.1": "{{ if includeTemplate \"opt\" (dict \"chezmoi\" .chezmoi \"my\" .my \"cmd\" \"mpv\" \"opt\" (list \"mpv\" \"plugins\" \"betterchapters\") \"os\" \"linux\") | trim | atoi -}}\n@others\n{{ end -}}\n",
    "zxc.20260616145450.1": "-- betterchapters.lua\n-- Loads the next or previous playlist entry if there are no more chapters in the seek direction.\n-- To bind in input.conf, use: <keybind> script_binding <keybind name>\n-- Keybind names: chapter_next, chapter_prev\n-- Recommended to use with autoload.lua\n\nfunction chapter_seek(direction)\n    local chapters = mp.get_property_number(\"chapters\")\n    local chapter  = mp.get_property_number(\"chapter\")\n    if chapter == nil then chapter = 0 end\n    if chapters == nil then chapters = 0 end\n    if chapter+direction < 0 then\n        mp.command(\"playlist_prev\")\n    elseif chapter+direction >= chapters then\n        mp.command(\"playlist_next\")\n    else\n        mp.commandv(\"osd-msg\", \"add\", \"chapter\", direction)\n    end\nend\n\nmp.add_key_binding(\"PGUP\", \"chapter_next\", function() chapter_seek(1) end)\nmp.add_key_binding(\"PGDWN\", \"chapter_prev\", function() chapter_seek(-1) end)\n",
    "zxc.20260619211159.1": "{{ if includeTemplate \"opt\" (dict \"chezmoi\" .chezmoi \"my\" .my \"cmd\" \"mpv\" \"opt\" (list \"mpv\" \"plugins\" \"costum\") \"os\" \"linux\") | trim | atoi -}}\n@others\n{{ end -}}\n",
    "zxc.20260616222806.1": "local url = dofile({{ joinPath .chezmoi.homeDir \".local\" \"share\" \"repos\" \"neturl\" \"lib\" \"net\" \"url.lua\" | quote }})\n\nmp.add_hook(\"on_load\", 9, function()\n    local path = url.parse(mp.get_property(\"path\", \"\"))\n\n    if path.host == \"www.bilibili.com\" then\n        mp.commandv(\"change-list\", \"ytdl-raw-options\", \"append\", \"cookies-from-browser=firefox:~/scoop/persist/firefox\")\n    end\n\n    if path.host == \"www.youtube.com\" or path.host == \"youtu.be\" then\n        mp.set_property(\"file-local-options/ytdl-format\", \"18/22\")\n        mp.set_property(\"file-local-options/speed\", 2.0)\n        mp.commandv(\"change-list\", \"ytdl-raw-options\", \"append\", \"write-auto-sub=\")\n    end\nend)\n",
    "zxc.20260619203724.2": "{{ if includeTemplate \"opt\" (dict \"chezmoi\" .chezmoi \"my\" .my \"cmd\" \"mpv\" \"opt\" (list \"mpv\" \"plugins\" \"anilist_updater\") \"os\" \"linux\") | trim | atoi -}}\n@others\n{{ end -}}\n",
