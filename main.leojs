    "zxc.20260423143729.278": "- name: Facts\n  ansible.builtin.gather_facts:\n  when: ansible_facts.user_dir is not defined\n",
    "zxc.20260423143729.279": "- name: Enable firewall for Domain, Public and Private profiles\n  ansible.windows.win_firewall:\n    state: enabled\n    profiles:\n      - Domain\n      - Private\n      - Public\n",
    "zxc.20260423143729.280": "- name: Check current source folder\n  ansible.windows.win_stat:\n    path: C:\\Users\\User\\scoop\\apps\\croc\\current\n  register: path\n- name: Croc firewall rule\n  community.windows.win_firewall_rule:\n    name: croc.exe\n    localport: 9009-9013\n    action: allow\n    direction: in\n    protocol: tcp\n    state: \"{{ 'present' if path.stat.exists is true else 'absent' }}\"\n    enabled: true\n- name: Croc firewall rule\n  community.windows.win_firewall_rule:\n    name: croc.exe udp\n    localport: 9009-9013\n    action: allow\n    direction: in\n    protocol: udp\n    state: \"{{ 'present' if path.stat.exists is true else 'absent' }}\"\n    enabled: true\n",
    "zxc.20260423143729.281": "- name: Check current source folder\n  ansible.windows.win_stat:\n    path: C:\\Users\\User\\scoop\\apps\\deskflow\\current\n  register: path\n- name: Deskflow firewall rule\n  community.windows.win_firewall_rule:\n    name: deskflow-core.exe\n    localport: 24800-24801\n    action: allow\n    protocol: tcp\n    direction: in\n    state: \"{{ 'present' if path.stat.exists is true else 'absent' }}\"\n    enabled: true\n- name: Deskflow firewall rule\n  community.windows.win_firewall_rule:\n    name: deskflow-core.exe udp\n    localport: 24800-24801\n    action: allow\n    protocol: udp\n    direction: in\n    state: \"{{ 'present' if path.stat.exists is true else 'absent' }}\"\n    enabled: true\n",
    "zxc.20260423143729.282": "- name: Check current source folder\n  ansible.windows.win_stat:\n    path: C:\\Users\\User\\scoop\\apps\\aria2\\current\n  register: path\n- name: Aria2 firewall rule\n  community.windows.win_firewall_rule:\n    name: aria2c.exe\n    localport: any\n    program: \"{{ path.stat.lnk_source }}\\\\aria2c.exe\"\n    action: allow\n    protocol: tcp\n    direction: in\n    state: \"{{ 'present' if path.stat.exists is true else 'absent' }}\"\n    enabled: true\n- name: Aria2 firewall rule\n  community.windows.win_firewall_rule:\n    name: aria2c.exe udp\n    localport: any\n    program: \"{{ path.stat.lnk_source }}\\\\aria2c.exe\"\n    action: allow\n    protocol: udp\n    direction: in\n    state: \"{{ 'present' if path.stat.exists is true else 'absent' }}\"\n    enabled: true\n",
