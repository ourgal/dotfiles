    "zxc.20260529135500.1": "{{ if includeTemplate \"opt\" (dict \"chezmoi\" .chezmoi \"my\" .my \"cmd\" \"transmission-daemon\" \"opt\" (list \"windows\" \"startup\" \"transmission\" \"enable\") \"os\" \"windows\") | trim | atoi -}}\nRun \"{{ joinPath .chezmoi.homeDir \"scoop\" \"apps\" \"transmission\" \"current\" \"transmission-daemon.exe\" }} --foreground\", {{ joinPath .chezmoi.homeDir \"Downloads\" | quote }}, \"Hide\"\n{{ end -}}\n",
    "User.20260221180424.1": "{{ if includeTemplate \"opt\" (dict \"chezmoi\" .chezmoi \"my\" .my \"cmd\" \"espansod\" \"opt\" (list \"windows\" \"startup\" \"espanso\" \"enable\") \"os\" \"windows\") | trim | atoi -}}\nRun \"{{ joinPath .chezmoi.homeDir \"scoop\" \"apps\" \"espanso\" \"current\" \"espansod.exe\" }} start\", {{ .chezmoi.homeDir | quote }}, \"Hide\"\n{{ end -}}\n",
