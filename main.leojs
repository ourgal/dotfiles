    "zxc.20260501141441.1": "- name: Set NetworkManager rc-manager\n  become: true\n  community.general.ini_file:\n    path: /mnt/etc/NetworkManager/NetworkManager.conf\n    section: main\n    option: rc-manager\n    value: resolvconf\n    mode: \"0644\"\n",
    "zxc.20260501141550.1": "- name: Xbps settings\n  become: true\n  block:\n    - name: Set xbps mirror\n      ansible.builtin.copy:\n        dest: /mnt/etc/xbps.d/00-repository-main.conf\n        content: |\n          repository={{ xbps_mirror }}\n        mode: \"0644\"\n    - name: Set xbps nonfree mirror\n      ansible.builtin.copy:\n        dest: /mnt/etc/xbps.d/01-repository-nonfree.conf\n        content: |\n          repository={{ xbps_nonfree_mirror }}\n        mode: \"0644\"\n",
