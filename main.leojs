    "zxc.20260125153715.1": "[push]\n\tautoSetupRemote = true\n\tdefault = \"current\"\n\tfollowTags = true\n\tuseForceIfIncludes = true",
    "zxc.20260125153727.1": "[rebase]\n\tautoSquash = true\n\tautoStash = true\n\tmissingCommitsCheck = \"warn\"\n\tupdateRefs = true",
    "zxc.20260125153745.1": "[rerere]\n\tautoupdate = true\n\tenabled = true",
