umConnections>0</numConnections>\n</device>\n<device id=\"{{ gopass \"syncthing/s10/id\" }}\" name=\"s10\" compression=\"metadata\" introducer=\"false\" skipIntroductionRemovals=\"false\" introducedBy=\"\">\n    <address>dynamic</address>\n    <paused>false</paused>\n    <autoAcceptFolders>false</autoAcceptFolders>\n    <maxSendKbps>0</maxSendKbps>\n    <maxRecvKbps>0</maxRecvKbps>\n    <maxRequestKiB>0</maxRequestKiB>\n    <untrusted>false</untrusted>\n    <remoteGUIPort>0</remoteGUIPort>\n    <numConnections>0</numConnections>\n</device>\n<device id=\"{{ gopass \"syncthing/m6/id\" }}\" name=\"m6\" compression=\"metadata\" introducer=\"false\" skipIntroductionRemovals=\"false\" introducedBy=\"\">\n    <address>dynamic</address>\n    <paused>false</paused>\n    <autoAcceptFolders>false</autoAcceptFolders>\n    <maxSendKbps>0</maxSendKbps>\n    <maxRecvKbps>0</maxRecvKbps>\n    <maxRequestKiB>0</maxRequestKiB>\n    <untrusted>false</untrusted>\n    <remoteGUIPort>0</remoteGUIPort>\n    <numConnections>0</numConnections>\n</device>",
