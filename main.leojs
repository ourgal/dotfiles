    "zxc.20260329102250.1": "# Gather System Serial Number\n$computerSpec = (Get-CimInstance -ClassName Win32_BIOS).SerialNumber\n\n# Generate a Hash (MD5)\n$md5 = [System.Security.Cryptography.MD5]::Create()\n$hash = $md5.ComputeHash([System.Text.Encoding]::UTF8.GetBytes($computerSpec))\n\n# Convert Hash to GUID\n$guid = [System.Guid]$hash\n$guid.Guid | Tee-Object -FilePath {{ joinPath (env \"LOCALAPPDATA\") \"uuid\" }}",
