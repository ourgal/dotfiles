    "zxc.20260202211707.1": "{{ if or ( eq .chezmoi.os \"linux\" ) ( eq .chezmoi.os \"windows\" ) -}}\n{{ if lookPath \"editorconfig\" -}}\n@others\n{{ end -}}\n{{ end -}}",
    "zxc.20260202211948.1": "root=true\n\n[*]\ncharset=utf-8\n{{ if eq .chezmoi.os \"linux\" -}}\nend_of_line=lf\n{{ else if eq .chezmoi.os \"windows\" -}}\nend_of_line=crlf\n{{ end -}}\nindent_size=2\nindent_style=space\ninsert_final_newline=true\ntrim_trailing_whitespace=true\n\n[*.py]\nindent_size=4\nindent_style=space\n\n[Makefile]\nindent_style=tab",
    "User.20260216000318.1": "<< unix dos >>\n{{ if lookPath \"cargo\" -}}\n@others\n{{ end -}}\n{{ end -}}",
    "User.20260216000441.1": "[source.crates-io]\nreplace-with = 'mirror'\n\n[source.mirror]\nregistry = \"sparse+https://mirrors.cernet.edu.cn/crates.io-index/\"\n\n[registries.mirror]\nindex = \"sparse+https://mirrors.cernet.edu.cn/crates.io-index/\"",
    "User.20260303213403.1": "[[index]]\nurl = {{ .my.pip.mirror | quote }}\ndefault = true",
