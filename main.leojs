    "zxc.20260423143729.218": "- mutagen\n",
    "zxc.20260423143729.219": "- jedi-language-server\n",
    "zxc.20260423143729.220": "- python-lsp-server\n",
    "zxc.20260423143729.221": "- basedpyright\n",
    "zxc.20260423143729.222": "- grip\n",
    "zxc.20260423143729.223": "- names\n",
