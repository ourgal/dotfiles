    "zxc.20260505181312.5": "export SSH_AUTH_SOCK=$(gpgconf --list-dirs agent-ssh-socket)\n",
    "zxc.20260505223347.1": "export GTK_IM_MODULE=fcitx\nexport QT_IM_MODULE=fcitx\nexport XMODIFIERS=\"@im=fcitx\"",
    "User.20260215182442.1": "<< dos >>\n{{ if eq .chezmoi.hostname \"nuc\" -}}\n@others\n{{ end -}}\n{{ end -}}",
