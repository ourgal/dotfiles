    "zxc.20260423143729.272": "- name: Install wegame\n  tags: wegame\n  community.windows.win_scoop:\n    name: wegame\n    state: present\n    global: false\n    no_cache: true\n  register: result\n  retries: 3\n  delay: 5\n  until: result is not failed\n",
