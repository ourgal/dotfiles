{{ $crush_version := "0.94.1" -}}
{{ $crush_url := printf "https://github.com/charmbracelet/crush/releases/download/v%s/crush_%s_Android_%s.tar.gz" $crush_version $crush_version .chezmoi.arch -}}
{{ $crush_path := printf "%s/crush" (trimSuffix ".tar.gz" (last (splitList "/" $crush_url))) -}}
[".local/bin/crush"]
    type = "archive-file"
    url = {{ print $mirror $crush_url | quote }}
    path = {{ $crush_path | quote }}
    executable = true
    refreshPeriod = "168h"
{{ end -}}

