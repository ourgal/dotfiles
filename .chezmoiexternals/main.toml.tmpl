{{ $mirror := (print .my.gh_proxy "/" ) -}}

{{ if eq .chezmoi.os "linux" -}}
{{ if lookPath "bash" -}}
[".local/lib/ble_sh"]
    type = "git-repo"
    url = {{ print $mirror "https://github.com/akinomyoga/ble.sh" | quote }}
    refreshPeriod = "168h"
    clone.args = [
        "--recurse-submodules",
        "-j8"
    ]
    pull.args = [
        "--recurse-submodules",
        "-j8"
    ]
{{ end -}}
{{ end -}}

{{ if eq .chezmoi.os "windows" -}}
{{ if lookPath "codium" -}}
{{ $vsnetrw_url := "https://github.com/danprince/vsnetrw/releases/download/v0.3.2/vsnetrw-0.3.2.vsix" -}}
[".cache/vscodium/extensions/vsnetrw.vsix"]
    type = "file"
    url = {{ print $mirror $vsnetrw_url | quote }}
{{ end -}}
{{ end -}}

{{ if eq .chezmoi.os "linux" "android" -}}
{{ if and (hasKey .chezmoi.osRelease "name") (ne .chezmoi.osRelease.name "Void") -}}
[".local/share/fonts/nerdsymbols"]
    type = "archive"
    url = {{ print $mirror .my.font.nerdsymbols_url | quote }}
    exact = true
    include = [ "*.ttf" ]
{{ end -}}
{{ end -}}

{{ if eq .chezmoi.os "linux" "android" -}}

{{ range (list "Bold" "BoldItalic" "ExtraBold" "Italic" "ExtraBoldItalic" "ExtraLightItalic" "Medium" "ExtraLight" "SemiBold" "LightItalic" "Light" "SemiBoldItalic" "Regular" "MediumItalic" "Thin" "ThinItalic") }}
[".local/share/fonts/maple/MapleMono-NF-CN-{{ . }}.ttf"]
