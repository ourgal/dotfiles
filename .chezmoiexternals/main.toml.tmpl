{{ $mirror := (print .my.gh_proxy "/" ) -}}

{{ if eq .chezmoi.os "linux" -}}
{{ if lookPath "bash" -}}
[".local/lib/ble_sh"]
    type = "git-repo"
    url = {{ print $mirror "https://github.com/akinomyoga/ble.sh" | quote }}
    refreshPeriod = "168h"
    clone.args = [
        "--recurse-submodules",
        "-j8"
    ]
    pull.args = [
        "--recurse-submodules",
        "-j8"
    ]
{{ end -}}
{{ end -}}

