{{ if and (eq .chezmoi.os "windows") (lookPath "gh") -}}

{{ $config_file := joinPath .chezmoi.homeDir "AppData" "Roaming" "GitHub CLI" "hosts.yml" -}}
{{ $data := dict -}}
{{ if stat $config_file -}}
{{ $data = include $config_file | fromYaml -}}
{{ end -}}
{{ if dig "github.com" "user" "" $data | not -}}
    {{ $token := includeTemplate "secrets" . | fromToml | dig "github" "ourgal" "token" "" -}}
    {{ if $token -}}
     "{{ $token }}" | gh auth login --hostname github.com --with-token
    {{- end -}}
{{ end -}}

{{ end -}}
