{{ if eq .chezmoi.os "windows" -}}
Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"
$PSNativeCommandUseErrorActionPreference = $true

$env:Path = "$env:LOCALAPPDATA\hermes\bin;" + $env:Path

$h = Get-Command hermes -ErrorAction SilentlyContinue
if ($null -ne $h) {
    Write-Host "Hermes Agent is already installed on PATH." -ForegroundColor Yellow
} else {
    Write-Host "Installing Hermes Agent (this may take a few minutes)..." -ForegroundColor Green
    iex (irm https://hermes-agent.nousresearch.com/install.ps1)
}

if (Get-Command hermes -ErrorAction SilentlyContinue) {
    Write-Host "Hermes Agent is ready." -ForegroundColor Green
} else {
    throw "Hermes Agent installed but the hermes command is not available on PATH. Restart your terminal after installing."
}
{{ else -}}
{{ end -}}
