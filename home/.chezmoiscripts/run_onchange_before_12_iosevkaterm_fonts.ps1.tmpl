{{ if eq .chezmoi.os "windows" -}}

{{ includeTemplate "download" (dict
  "url" (print .my.gh_proxy "/" "https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.1/IosevkaTerm.tar.xz")
  "output" (joinPath .chezmoi.homeDir "AppData" "Local" "Microsoft" "Windows" "Fonts" | printf "%s/")
  "extract" true
  "sub_dir" true
  "include" "*.ttf"
  "chezmoi" .chezmoi
)}}

{{ end -}}
