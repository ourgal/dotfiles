{{ if eq .chezmoi.os "linux" -}}
{{ if ne (dig "osRelease" "id" "" .chezmoi) "arch" -}}
#!{{ lookPath "bash" }}

{{ $ver := "3.10.4" -}}
{{ $arch := "x86_64" -}}

{{ includeTemplate "download" (dict
  "url" (print .my.gh_proxy "/" (printf "https://github.com/5rahim/seanime/releases/download/v%s/seanime-%s_Linux_%s.tar.gz" $ver $ver $arch))
  "output" (joinPath .chezmoi.homeDir ".local" "bin" | printf "%s/")
  "extract" true
  "include" "*/seanime"
  "chezmoi" .chezmoi
)}}

{{ end -}}
{{ end -}}
