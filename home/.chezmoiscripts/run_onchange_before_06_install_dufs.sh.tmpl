{{ if eq .chezmoi.os "linux" -}}
#!{{ lookPath "bash" }}

{{ $dufs_version := "0.46.0" -}}
{{ $arch := "x86_64" -}}
{{ if eq .chezmoi.arch "arm64" -}}
{{ $arch = "aarch64" -}}
{{ end -}}
{{ $dufs_url := printf "https://github.com/sigoden/dufs/releases/download/v%s/dufs-v%s-%s-unknown-linux-musl.tar.gz" $dufs_version $dufs_version $arch -}}

{{ includeTemplate "download" (dict
  "url" (print .my.gh_proxy "/" $dufs_url)
  "output" (joinPath .chezmoi.homeDir ".local" "bin" "dufs")
  "extract" true
  "executable" true
  "chezmoi" .chezmoi
)}}

{{ end -}}
