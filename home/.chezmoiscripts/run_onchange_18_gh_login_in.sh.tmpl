{{ if and (ne .chezmoi.os "windows") (ne .chezmoi.hostname "user-PC") (lookPath "gh") -}}

{{ $config_file := joinPath .chezmoi.homeDir ".confg" "gh" "hosts.yml" -}}
{{ $data := dict -}}
{{ if stat $config_file -}}
{{ $data = include $config_file | fromYaml -}}
{{ end -}}
{{ if dig "github.com" "user" "" $data | not -}}
{{ $token := includeTemplate "secrets" . | fromToml | dig "github" "ourgal" "token" "" -}}
{{ if $token -}}
#!{{ lookPath "bash" }}
echo "{{ $token }}" | gh auth login --hostname github.com --with-token
{{ end -}}
{{ end -}}

{{ end -}}
