{{ if and (ne .chezmoi.os "windows") (lookPath "gh") -}}

{{ $config_file := joinPath .chezmoi.homeDir ".confg" "gh" "hosts.yml" -}}
{{ $data := dict -}}
{{ if stat $config_file -}}
{{ $data = include $config_file | fromYaml -}}
{{ end -}}
{{ if dig "github.com" "oauth_token" "" $data | not -}}
    {{ $token := includeTemplate "secrets" . | fromToml | dig "github" "ourgal" "token" "" }}
    {{ if $token -}}
#!{{ lookPath "bash" }}
    gh auth login --hostname github.com --with-token "{{ $token }}"
    {{- end -}}
{{ end -}}

{{ end -}}
