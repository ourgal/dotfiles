{{- /* chezmoi:modify-template */ -}}
{{- /*
  Register Mnemosyne's MCP server for CodeBuddy Code. Only the "mnemosyne"
  server entry is managed here; servers CodeBuddy or the user adds are kept.
  On Windows use the persistent Hermes side-venv executable so this runs the
  same Mnemosyne build as the Hermes provider, and point HERMES_HOME at the
  active Windows home so both agents share one SQLite store. Without that env
  the standalone CLI would fall back to ~/.hermes/mnemosyne/data (an empty DB).
  On Termux the built-in memory system is used instead, so the Mnemosyne entry
  is actively removed even if it was registered here previously.
*/ -}}
{{- $data := dict "mcpServers" (dict) -}}
{{- if .chezmoi.stdin -}}
{{- $data = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $servers := default (dict) (get $data "mcpServers") -}}
{{- $isTermux := or (lookPath "termux-info") (env "TERMUX_VERSION") -}}
{{- if $isTermux -}}
{{- /* Termux uses CodeBuddy's built-in memory; strip the Mnemosyne server. */ -}}
{{- $servers = unset $servers "mnemosyne" -}}
{{- else -}}
{{- $hermesHome := "" -}}
{{- $mnemosyneCmd := "" -}}
{{- if eq .chezmoi.os "windows" -}}
{{- $hermesHome = joinPath .chezmoi.homeDir "AppData" "Local" "hermes" -}}
{{- $mnemosyneCmd = joinPath $hermesHome ".mnemosyne" "venv" "Scripts" "mnemosyne.exe" -}}
{{- else -}}
{{- $hermesHome = joinPath .chezmoi.homeDir ".hermes" -}}
{{- /* Catalog plugins install into a hashed side-venv, so "mnemosyne" is not on
       PATH here. Use the stable wrapper that resolves the active venv. */ -}}
{{- $mnemosyneCmd = joinPath .chezmoi.homeDir ".local" "bin" "mnemosyne" -}}
{{- end -}}
{{- $managed := dict "mnemosyne" (dict
      "type" "stdio"
      "command" ($mnemosyneCmd | replace "\\" "/")
      "args" (list "mcp")
      "env" (dict "HERMES_HOME" ($hermesHome | replace "\\" "/"))) -}}
{{- $servers = $managed | mergeOverwrite $servers -}}
{{- end -}}
{{- $_ := set $data "mcpServers" $servers -}}
{{ $data | toJson }}
