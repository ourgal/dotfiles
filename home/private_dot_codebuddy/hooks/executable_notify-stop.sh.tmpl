#!/usr/bin/env bash
# CodeBuddy Stop hook: delegate to the shared task-end notifier so all agents
# use one implementation. Failures stay silent so the hook never blocks a turn.
cat >/dev/null 2>&1 || true
"{{ joinPath .chezmoi.homeDir ".local" "bin" "notify-agent-done" | replace "\\" "/" }}" "CodeBuddy" "Answer complete" >/dev/null 2>&1 || true
printf '{}\n'
