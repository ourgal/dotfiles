# Managed by WorkBuddy: select fcitx5 as the only input method framework.
# Sourced by im-config during X session startup (phase 1 and phase 2).
# This replaces the system default that auto-started fcitx4 + Sogou.

if [ "$IM_CONFIG_PHASE" = "1" ]; then
    XMODIFIERS=@im=fcitx
    GTK_IM_MODULE=fcitx
    QT_IM_MODULE=fcitx
    SDL_IM_MODULE=fcitx
    CLUTTER_IM_MODULE=xim
    INPUT_METHOD=fcitx5
fi

if [ "$IM_CONFIG_PHASE" = "2" ]; then
    # fcitx5 is installed in /usr/local/bin here, so the stock
    # /usr/share/im-config/data/23_fcitx5.rc cannot launch it.
    if [ -x /usr/local/bin/fcitx5 ]; then
        /usr/local/bin/fcitx5 -d -r >/dev/null 2>&1
    fi
fi
