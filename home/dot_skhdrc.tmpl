{{ if eq .chezmoi.os "darwin" -}}
# skhd config. Managed by chezmoi. Cmd is the Super key on macOS.
# Combine modifiers with '+' and separate the final key with '-'. The launchd
# PATH omits /opt/homebrew/bin, so call yabai by absolute path.
# If `cmd - 1` is not detected, use keycodes: 0x12=1, 0x13=2, 0x14=3,
# 0x15=4, 0x17=5, 0x16=6, 0x1A=7, 0x1C=8, 0x19=9. `=` and `-` have no
# literal keyword in skhd: use 0x18 and 0x1B.
# Spaces
cmd - 1 : /opt/homebrew/bin/yabai -m space --focus 1
cmd - 2 : /opt/homebrew/bin/yabai -m space --focus 2
cmd - 3 : /opt/homebrew/bin/yabai -m space --focus 3
cmd - 4 : /opt/homebrew/bin/yabai -m space --focus 4
cmd - 5 : /opt/homebrew/bin/yabai -m space --focus 5
cmd - 6 : /opt/homebrew/bin/yabai -m space --focus 6
cmd - 7 : /opt/homebrew/bin/yabai -m space --focus 7
cmd - 8 : /opt/homebrew/bin/yabai -m space --focus 8
cmd - 9 : /opt/homebrew/bin/yabai -m space --focus 9
# Send the focused window to a Space
cmd + shift - 1 : /opt/homebrew/bin/yabai -m window --space 1
cmd + shift - 2 : /opt/homebrew/bin/yabai -m window --space 2
cmd + shift - 3 : /opt/homebrew/bin/yabai -m window --space 3
cmd + shift - 4 : /opt/homebrew/bin/yabai -m window --space 4
cmd + shift - 5 : /opt/homebrew/bin/yabai -m window --space 5
cmd + shift - 6 : /opt/homebrew/bin/yabai -m window --space 6
cmd + shift - 7 : /opt/homebrew/bin/yabai -m window --space 7
cmd + shift - 8 : /opt/homebrew/bin/yabai -m window --space 8
cmd + shift - 9 : /opt/homebrew/bin/yabai -m window --space 9
# Focus (vim direction)
cmd - h : /opt/homebrew/bin/yabai -m window --focus west
cmd - j : /opt/homebrew/bin/yabai -m window --focus south
cmd - k : /opt/homebrew/bin/yabai -m window --focus north
cmd - l : /opt/homebrew/bin/yabai -m window --focus east
# Move the focused window
cmd + shift - h : /opt/homebrew/bin/yabai -m window --move west
cmd + shift - j : /opt/homebrew/bin/yabai -m window --move south
cmd + shift - k : /opt/homebrew/bin/yabai -m window --move north
cmd + shift - l : /opt/homebrew/bin/yabai -m window --move east
# Layout
cmd - f : /opt/homebrew/bin/yabai -m window --toggle zoom-fullscreen
cmd + shift - space : /opt/homebrew/bin/yabai -m window --toggle float
cmd - 0x18 : /opt/homebrew/bin/yabai -m window --resize right:20:0
cmd - 0x1B : /opt/homebrew/bin/yabai -m window --resize left:20:0
{{ end -}}
