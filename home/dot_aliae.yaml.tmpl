# yaml-language-server: $schema=https://aliae.dev/schema.json
alias:
  - name: reboot
    value: Restart-Computer
    if: eq .Shell "pwsh"
  - name: poweroff
    value: Stop-Computer
    if: eq .Shell "pwsh"
  - name: lg
    value: lazygit
  - name: scroff
    value: |
      (Add-Type '[DllImport("user32.dll")]public static extern int PostMessage(int h,int m,int w,int l);' -Name a -Pas)::PostMessage(-1,0x0112,0xF170,2)
    type: function
    if: and (eq .Shell "pwsh") (eq .OS "windows")
  - name: scroff
    value: xset dpms force off
    type: function
    if: eq .OS "linux"
env:
  - name: EDITOR
    value: {{ includeTemplate "editor" . | quote }}
  - name: GOPROXY
    value: {{ printf "%s,direct" .my.go_proxy | quote }}
  - name: TERM
    value: xterm-256color
    if: eq .Shell "pwsh"
  - name: shell_startup
    value: {{ joinPath .chezmoi.homeDir "AppData" "Roaming" "Microsoft" "Windows" "Start Menu" "Programs" "Startup" | quote }}
    if: eq .OS "windows"
  - name: CODEBUDDY_CODE_GIT_BASH_PATH
    value: {{ joinPath .chezmoi.homeDir "scoop" "apps" "git" "current" "bin" "bash.exe" | quote }}
    if: eq .OS "windows"
  - name: CARAPACE_BRIDGES
    value: zsh,fish,bash,inshellisense,powershell
    if: eq .Shell "pwsh"
path:
  # aliae skips missing directories and entries already in PATH.
  - value: |
      {{ joinPath .chezmoi.homeDir ".local" "bin" }}
      {{ joinPath .chezmoi.homeDir "go" "bin" }}
      {{ joinPath .chezmoi.homeDir "miniforge3" "bin" }}
