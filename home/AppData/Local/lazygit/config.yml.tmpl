{{ if lookPath "diff-so-fancy" -}}
git:
  diffRenderers:
    - colorArg: always
      command: diff-so-fancy
{{ else if lookPath "delta" -}}
git:
  diffRenderers:
    - colorArg: always
      command: delta --paging=never
{{ else -}}
{{ end -}}
{{ if lookPath "gmc" -}}
customCommands:
  - key: 'G'
    command: 'gmc -apy'
    context: 'global'
    loadingText: 'Running gmc -apy'
    output: log
{{ end -}}
