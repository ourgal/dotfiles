# Default to Chinese on macOS (ascii_mode state 0); everywhere else default to
# English (state 1 = 西文). "@0" is ascii_mode, the first switch in sbfm.schema.yaml.
patch:
  "switches/@0/reset": {{ if eq .chezmoi.os "darwin" }}0{{ else }}1{{ end }}
  # Disable every stock modifier switch_key and the two numbered ascii_mode
  # toggles from sbxlm.yaml, so no upstream key switches the mode.
  "ascii_composer/switch_key/Caps_Lock": noop
  "ascii_composer/switch_key/Shift_L": noop
  "ascii_composer/switch_key/Shift_R": noop
  "ascii_composer/switch_key/Control_L": noop
  "ascii_composer/switch_key/Control_R": noop
  "ascii_composer/switch_key/Eisu_toggle": noop
  # Compiled key_binder/bindings indices: 16 = Control+Shift+2,
  # 21 = Control+Shift+at. Recheck after a sbsrf/sbxlm scheme upgrade.
  "key_binder/bindings/@16": {}
  "key_binder/bindings/@21": {}
{{- if ne .chezmoi.os "darwin" }}
  "key_binder/bindings/+":
    - { when: always, accept: Control+space, toggle: ascii_mode }
{{- end }}
