[".config/awesome-copycats"]
    type = "git-repo"
    url = {{ print $mirror "https://github.com/lcpz/awesome-copycats" | quote }}
    clone.args = [
        "--recurse-submodules",
        "-j8"
    ]
    pull.args = [
        "--recurse-submodules",
        "-j8"
    ]
{{ end -}}
{{ end -}}

