# ~/.config/tmux/tmux.conf
#
# Converted from the NixOS modules in ~/Documents/my_repos/snowfall:
#   modules/home/cli/multiplexer/tmux/{base,plugins,themes,resurrect}
# No plugin manager: tmux-power is cloned by .chezmoiexternals/main.toml.tmpl
# to ~/.config/tmux/plugins/tmux-power and its script is run at the bottom.
#   reload config   : `tmux source-file ~/.config/tmux/tmux.conf`

# ============================================================================
# CORE
# ============================================================================
set -g default-terminal "tmux-256color"
set -ag terminal-overrides ",xterm-256color:RGB"
{{ if lookPath "fish" -}}
set -g default-shell "{{ lookPath "fish" }}"
{{ end -}}
set -g history-limit 20000

set -g buffer-limit 20
set -sg escape-time 0
set -g display-time 1500
set -g remain-on-exit off
set -g repeat-time 300
set -g focus-events on
setw -g aggressive-resize on
setw -g allow-rename off
setw -g automatic-rename on
set -g automatic-rename-format "#{?#{||:#{==:#{pane_current_command},zsh},#{==:#{pane_current_command},fish}},#{b:pane_current_path},#{pane_current_command}}"

set -gq allow-passthrough on
# TERM is deliberately not in update-environment: leaking the client's
# xterm-kitty into panes makes apps reset the cursor against kitty directly
# instead of letting tmux restore it. Panes use default-terminal instead.

# parent terminal title reflects the current window
set -g set-titles on
set -g set-titles-string "#I:#W"

# humans count from 1
set -g base-index 1
setw -g pane-base-index 1
set -g clock-mode-style 24

set -g mouse on
set -g detach-on-destroy off
set -g @copy_use_osc52_fallback on
setw -g mode-keys vi

{{ if includeTemplate "opt" (dict "chezmoi" .chezmoi "my" .my "cmd" "tmux" "opt" (list "tmux" "plugins" "tmux-resurrect") "os" (list "linux" "darwin")) | trim | atoi -}}
# --- resurrect / continuum -------------------------------------------------
# continuum-boot is off: the Arch tmux_server role owns the systemd unit.
set -g @resurrect-capture-pane-contents 'on'
set -g @resurrect-processes 'lazygit newsboat clifm "devbox shell" "hx *" ncmpcpp "~nnn-wrapped->nnn" lf rmpc "~ranger->ranger-cd" "yazi->yy"'
set -g @continuum-restore 'on'
set -g @continuum-boot 'off'
set -g @continuum-save-interval '10'
{{ end -}}

# --- yank ------------------------------------------------------------------
set -g @yank_action 'copy-pipe'

{{ if ne .chezmoi.os "android" -}}
# --- extrakto --------------------------------------------------------------
set -g @extrakto_key 'i'

# --- thumbs ----------------------------------------------------------------
set -g @thumbs-key '.'
set -g @thumbs-osc52 1
set -g @thumbs-command 'tmux set-buffer -- {} && echo -n {} | xsel -ib && tmux display-message "Copied {}"'

# --- session pickers -------------------------------------------------------
set -g @session-wizard 'k'
set -g @sessionx-bind 'o'
{{ end -}}

{{ if ne .chezmoi.os "android" -}}
# --- tea / tome / paste-image ---------------------------------------------
set -g @tea-bind 'T'
set -g @tome_key 'a'
set -g @tome_scratch_key 'A'
set -g @tome_playbook '.playbook.fish'
set -g @paste-image-key 'P'

# --- ssh-split -------------------------------------------------------------
set -g @ssh-split-keep-cwd 'true'
set -g @ssh-split-keep-remote-cwd 'true'
set -g @ssh-split-fail 'false'
set -g @ssh-split-no-env 'false'
set -g @ssh-split-no-shell 'false'
set -g @ssh-split-strip-cmd 'true'
set -g @ssh-split-verbose 'true'
set -g @ssh-split-debug 'false'
set -g @ssh-split-h-key 'v'
set -g @ssh-split-v-key 's'
set -g @ssh-split-w-key 'c'
{{ end -}}

# --- which-key -------------------------------------------------------------
# menu lives in ~/.config/tmux/plugins/tmux-which-key/config.yaml
set -g @tmux-which-key-xdg-enable 1

# --- status bar theme ------------------------------------------------------
{{ if includeTemplate "opt" (dict "chezmoi" .chezmoi "my" .my "cmd" "tmux" "opt" (list "tmux" "plugins" "tmux-power") "os" (list "linux" "android" "darwin")) | trim | atoi -}}
# --- tmux-power theme ------------------------------------------------------
set -g @tmux_power_theme 'moon'
set -g @tmux_power_status_interval 2
set -g @tmux_power_left_a  ' #{USER}@#h'
set -g @tmux_power_left_b  ' #S'
set -g @tmux_power_right_w '#(git -C "#{pane_current_path}" symbolic-ref --quiet --short HEAD 2>/dev/null | sed "s/^/  /")'
set -g @tmux_power_right_y ' %H:%M'
set -g @tmux_power_right_z ' %F'
{{ end -}}
set -g status-position top

# ============================================================================
# KEY BINDINGS
# ============================================================================
# tmux's stock new-window/split-window start in the session's initial directory,
# not the active pane's cwd; rebind them (and V/S below) with -c.

# new session, paste, rename
bind n new-session
bind p paste-buffer
bind r command-prompt -I "#{window_name}" "rename-window '%%'"
bind R command-prompt -I "#{session_name}" "rename-session '%%'"

bind w choose-session
bind = command-prompt -I "#{move-window}" "move-window '%%'"

# reorder windows
bind-key -r "<" swap-window -d -t -1
bind-key -r ">" swap-window -d -t +1

# new panes / windows inherit the active pane's cwd
bind c new-window -c "#{pane_current_path}"
bind % split-window -h -c "#{pane_current_path}"
bind '"' split-window -v -c "#{pane_current_path}"

# full-size splits
bind-key "V" split-window -fh -c "#{pane_current_path}"
bind-key "S" split-window -fv -c "#{pane_current_path}"

# kill
bind x kill-window
bind C-x confirm-before -p "kill other windows? (y/n)" "kill-window -a"
bind X confirm-before -p "kill-session #S? (y/n)" kill-session

# detach
bind d detach
bind D if -F '#{session_many_attached}' \
    'confirm-before -p "Detach other clients? (y/n)" "detach -a"' \
    'display "Session has only 1 client attached"'

# zellij-like navigation
bind -n M-j if -F "#{pane_at_bottom}" "switch-client -n" "select-pane -D"
bind -n M-k if -F "#{pane_at_top}" "switch-client -p" "select-pane -U"
bind -n M-l if -F "#{pane_at_right}" "next-window" "select-pane -R"
bind -n M-h if -F "#{pane_at_left}" "previous-window" "select-pane -L"

# copy mode
bind b copy-mode

# ============================================================================
# PLUGIN SCRIPTS — must stay at the very bottom, after their options.
# resurrect sets the script paths continuum calls; continuum must come after
# tmux-power because it prepends its autosave to status-right.
# ============================================================================
{{ if includeTemplate "opt" (dict "chezmoi" .chezmoi "my" .my "cmd" "tmux" "opt" (list "tmux" "plugins" "tmux-resurrect") "os" (list "linux" "darwin")) | trim | atoi -}}
run '~/.config/tmux/plugins/tmux-resurrect/resurrect.tmux'
{{ end -}}
{{ if includeTemplate "opt" (dict "chezmoi" .chezmoi "my" .my "cmd" "tmux" "opt" (list "tmux" "plugins" "tmux-power") "os" (list "linux" "android" "darwin")) | trim | atoi -}}
run '~/.config/tmux/plugins/tmux-power/tmux-power.tmux'
{{ end -}}
{{ if includeTemplate "opt" (dict "chezmoi" .chezmoi "my" .my "cmd" "tmux" "opt" (list "tmux" "plugins" "tmux-continuum") "os" (list "linux" "darwin")) | trim | atoi -}}
run '~/.config/tmux/plugins/tmux-continuum/continuum.tmux'
{{ end -}}
