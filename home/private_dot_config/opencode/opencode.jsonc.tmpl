{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-models-discovery@2.1.0"
  ],
  "provider": {
    "qiniu": {
      "name": "qiniu",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.qnaigc.com/v1",
        "apiKey": "{{ includeTemplate "secrets" . | fromToml | dig "AI" "qiniu" "" }}"
      },
      "models": {
        "qiniu/conatus-free": {
          "name": "Conatus Free",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        }
      }
    },
    "10router": {
      "name": "10router",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://192.168.123.123:20128/v1",
        "apiKey": "{{ includeTemplate "secrets" . | fromToml | dig "AI" "10router" "" }}",
        "modelsDiscovery": {
          "enabled": true
        }
      }
    }
  }
}
