{{- if eq (index .my.themes .my.modules.windows.theme).wm "komorebi" -}}
{{ includeTemplate "kanagawa_yasb_config" . }}
{{- else -}}
watch_config: true
watch_stylesheet: true
debug: false

bars:
  rose-pine-bar:
    enabled: true
    screens: ["*"]
    class_name: "yasb-bar"
    style: "adaptive"
    alignment:
      position: "top"
      align: "center"
    animation:
      enabled: true
      duration: 250
    window_flags:
      always_on_top: false
      windows_app_bar: true
    dimensions:
      width: "100%"
      height: 34
    padding:
      top: 0
      left: 0
      bottom: 0
      right: 0
    widgets:
      left:
        - home
        - glazewm_workspaces
        - clock
      right:
        - traffic
        - cpu
        - memory
        - battery
        - volume
        - systray
        - wallpapers
        - power_menu

widgets:
  home:
    type: "yasb.home.HomeWidget"
    options:
      label: "<span>\uf015</span>"
      menu_list:
        - { title: "Home", path: "~" }
        - { title: "Downloads", path: "~\\Downloads" }
        - { title: "Documents", path: "~\\Documents" }
        - { title: "Pictures", path: "~\\Pictures" }
      system_menu: true
      power_menu: false

  glazewm_workspaces:
    type: "glazewm.workspaces.GlazewmWorkspacesWidget"
    options:
      offline_label: "GlazeWM Offline"
      hide_if_offline: true

  clock:
    type: "yasb.clock.ClockWidget"
    options:
      label: "{%a %d %b %H:%M}"
      label_alt: "{%A, %d %B %Y %H:%M}"

  traffic:
    type: "yasb.traffic.TrafficWidget"
    options:
      label: "<span>\ueab4</span> {download_speed}  <span>\ueab7</span> {upload_speed}"
      label_alt: "Download {download_speed} | Upload {upload_speed}"
      speed_unit: bytes
      update_interval: 1000
      hide_if_offline: true
      callbacks:
        on_left: "toggle_label"
        on_right: "exec cmd /c Taskmgr"

  cpu:
    type: "yasb.cpu.CpuWidget"
    options:
      label: "<span>\uf2db</span> {info[percent][total]}%"
      label_alt: "<span>\uf2db</span> {info[freq][current]} MHz"
      update_interval: 2000
      hide_decimal: true

  memory:
    type: "yasb.memory.MemoryWidget"
    options:
      label: "<span>\uf538</span> {virtual_mem_percent}%"
      label_alt: "<span>\uf538</span> {virtual_mem_free} / {virtual_mem_total}"
      update_interval: 5000
      hide_decimal: true

  battery:
    type: "yasb.battery.BatteryWidget"
    options:
      label: "<span>{icon}</span> {percent}%"
      label_alt: "<span>{icon}</span> {percent}% | {time_remaining}"
      update_interval: 5000
      hide_unsupported: true
      charging_options:
        icon_format: "{charging_icon}"

  volume:
    type: "yasb.volume.VolumeWidget"
    options:
      label: "<span>{icon}</span> {level}"
      label_alt: "{level}"

  systray:
    type: "yasb.systray.SystrayWidget"
    options:
      class_name: "systray"
      icon_size: 16
      label_position: "right"
      show_unpinned: false
      show_in_popup: true
      icons_per_row: 5
      popup:
        blur: false
        round_corners: false
        round_corners_type: "normal"
        border_color: "System"
        alignment: "right"
        direction: "down"
        offset_left: 8

  wallpapers:
    type: "yasb.wallpapers.WallpapersWidget"
    options:
      label: "<span>\udb83\udc8d</span>"
      image_path:
        - {{ joinPath .chezmoi.homeDir ".local" "share" "kanagawa-win11" "Wallpapers" | quote }}
      change_automatically: false
      update_interval: 60
      engine:
        enabled: true
        animation: "circle"
      gallery:
        enabled: true
        blur: false
        image_width: 220
        image_per_page: 6
        gallery_columns: 0
        horizontal_position: "center"
        vertical_position: "center"
        position_offset: 0
        respect_work_area: true
        show_buttons: false
        orientation: "portrait"
        image_spacing: 8
        lazy_load: true
        lazy_load_fadein: 400
        image_corner_radius: 8
      callbacks:
        on_left: "toggle_gallery"
        on_middle: "do_nothing"
        on_right: "change_wallpaper"

  power_menu:
    type: "yasb.power_menu.PowerMenuWidget"
    options:
      label: "\uf011"
      uptime: true
      show_user: false
      menu_style: "popup"
      popup:
        blur: false
        round_corners: false
        round_corners_type: "normal"
        border_color: "System"
        alignment: "right"
        offset_left: 8
      animation_duration: 200
      button_row: 5
      buttons:
        shutdown: ["\uf011", "Shut Down"]
        restart: ["\uead2", "Restart"]
        signout: ["\udb80\udf43", "Sign out"]
        hibernate: ["\uf28e", "Hibernate"]
        sleep: ["\u23fe", "Sleep"]
        cancel: ["", "Cancel"]
{{- end -}}
