{{- /* zdiff3 needs git >= 2.35; older git rejects the value entirely. */ -}}
{{ $conflictStyle := "zdiff3" -}}
{{ if lookPath "git" -}}
{{ if not (semverCompare ">=2.35.0" (output "git" "--version" | regexFind `[0-9]+\.[0-9]+\.[0-9]+`)) -}}
{{ $conflictStyle = "merge" -}}
{{ end -}}
{{ end -}}
{{ $cfg = set $cfg "merge" (dict "conflictstyle" $conflictStyle "renameLimit" 10000) -}}
