{{ $_ = set $_ "sw" "show --color-words" -}}
{{ $_ = set $_ "l" "log" -}}
{{ $_ = set $_ "logs" "log --show-signature --stat" -}}
{{ $_ = set $_ "lp" "log -p" -}}
{{ $_ = set $_ "chp" "cherry-pick" -}}
{{ $_ = set $_ "chpa" "cherry-pick --abort" -}}
