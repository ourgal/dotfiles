"""Rose Pine bar, ported from the-argus/rose-pine-dots Config/qtile/bar.py.

All widgets come from libqtile itself; CPU/Net/Memory use psutil, which is
available on Arch. The battery widget is only added on machines that have one.
"""

import glob

import psutil
from libqtile import bar, widget
from libqtile.lazy import lazy
from libqtile.widget.battery import BatteryState

WINDOW_FONT = "{{ .my.font.monospace }}:style=Italic"

{{ if eq .chezmoi.hostname "surface" }}
# eDP-1 runs with `--scale 0.5x0.5`, so X enlarges everything 2x. Shrink the
# bar geometry here to keep it at the unscaled reference proportions.
BAR_SCALE = 0.6
{{ else }}
BAR_SCALE = 1.0
{{ end }}

BAR_HEIGHT = int(round(34 * BAR_SCALE))
MARGIN = int(round(9 * BAR_SCALE))
BORDER_WIDTH = max(1, int(round(2 * BAR_SCALE)))
LOGO_SIZE = int(round(18 * BAR_SCALE))
BIG_SIZE = int(round(16 * BAR_SCALE))
TRAY_ICON_SIZE = int(round(20 * BAR_SCALE))

# Powerline "rounded left" glyph. Drawn in the next segment's colour over the
# current segment's background, it produces the soft notches in the reference.
SEPARATOR = "\ue0b6"

colors = {
    "bg": "#191724",
    "fg": "#e0def4",
    "gutter": "#555169",
    "red": "#eb6f92",
    "green": "#31748f",
    "yellow": "#f6c177",
    "blue": "#9ccfd8",
    "magenta": "#c4a7e7",
    "orange": "#6e6a86",
    "pink": "#2a2837",
}

DEFAULT_BG = colors["bg"]
DEFAULT_FG = colors["fg"]

# Nerd Font glyphs used in the bar.
ARCH_LOGO = "\uf303"        # nf-linux-archlinux
CPU_ICON = "\uf2db"         # nf-fa-microchip
MEM_ICON = "\uf00b"         # nf-fa-tasks

# Horizontal battery glyphs: 4 internal blocks, from empty (0) to full (4).
BATTERY_BLOCKS = (
    "\uf244",  # 0/4  nf-fa-battery_empty
    "\uf243",  # 1/4  nf-fa-battery_quarter
    "\uf242",  # 2/4  nf-fa-battery_half
    "\uf241",  # 3/4  nf-fa-battery_three_quarter
    "\uf240",  # 4/4  nf-fa-battery_full
)
BOLT_ICON = "\uf0e7"        # nf-fa-bolt (electric icon shown while charging)

METER_CELLS = 5
METER_FULL = "\u2588"        # █
METER_EMPTY = "\u2591"       # ░


def _block_meter(percent):
    """Horizontal meter, e.g. '███░░' for 60%."""
    filled = min(METER_CELLS, max(0, int(percent / 100 * METER_CELLS + 0.5)))
    return METER_FULL * filled + METER_EMPTY * (METER_CELLS - filled)


class BlockBattery(widget.Battery):
    """Battery widget using a horizontal battery with charge-level blocks.

    The stock widget only swaps an arrow based on state; this picks one of the
    four Font Awesome battery-level glyphs from the percentage instead, and
    adds a bolt while charging. Colour handling is kept from the parent.
    """

    def build_string(self, status):
        if self.hide_threshold is not None and status.percent > self.hide_threshold:
            return ""

        if self.layout is not None:
            if (
                status.state == BatteryState.DISCHARGING
                and status.percent < self.low_percentage
            ):
                self.layout.colour = self.low_foreground
                self.background = self.low_background
            elif status.state == BatteryState.CHARGING:
                self.layout.colour = self.charging_foreground or self.foreground
                self.background = self.charging_background or self.normal_background
            else:
                self.layout.colour = self.foreground
                self.background = self.normal_background

        level = min(4, int(round(status.percent * 4)))
        icon = BATTERY_BLOCKS[level]
        if status.state == BatteryState.CHARGING:
            icon += " " + BOLT_ICON
        return f" {icon} {status.percent:2.0%}"


class BlockCPU(widget.CPU):
    """CPU widget with a block meter showing current load."""

    def poll(self):
        return self.format.format(meter=_block_meter(psutil.cpu_percent()))


class BlockMemory(widget.Memory):
    """Memory widget with a block meter showing the used fraction."""

    def poll(self):
        return self.format.format(meter=_block_meter(psutil.virtual_memory().percent))


def _specs():
    """(widget class, kwargs, separator after, inherit next background)."""
    specs = [
        (
            widget.Spacer,
            dict(length=5, background=colors["magenta"]),
            False,
            True,
        ),
        (
            widget.TextBox,
            dict(
                text=ARCH_LOGO,
                font=WINDOW_FONT,
                fontsize=LOGO_SIZE,
                padding=6,
                background=colors["magenta"],
                foreground=colors["bg"],
                mouse_callbacks={"Button1": lazy.spawncmd()},
            ),
            True,
            False,
        ),
        (
            widget.GroupBox,
            dict(
                font=WINDOW_FONT,
                fontsize=BIG_SIZE,
                padding=3,
                foreground=colors["gutter"],
                highlight_method="text",
                block_highlight_text_color=colors["fg"],
                active=colors["fg"],
                inactive=colors["gutter"],
                rounded=False,
                highlight_color=[colors["fg"], colors["yellow"]],
                urgent_alert_method="line",
                urgent_text=colors["red"],
                urgent_border=colors["red"],
                disable_drag=True,
                use_mouse_wheel=False,
                hide_unused=False,
                spacing=5,
                this_current_screen_border=colors["yellow"],
            ),
            True,
            False,
        ),
        (
            widget.WindowName,
            dict(
                font=WINDOW_FONT,
                fontsize=BIG_SIZE,
                padding=3,
                format="{name}",
                background=colors["gutter"],
                center_aligned=True,
            ),
            True,
            False,
        ),
        (
            widget.Systray,
            dict(padding=5, background=colors["orange"], icon_size=TRAY_ICON_SIZE),
            True,
            False,
        ),
        (
            BlockCPU,
            dict(
                font=WINDOW_FONT,
                fontsize=BIG_SIZE,
                padding=3,
                format=CPU_ICON + " {meter}",
                background=colors["yellow"],
                foreground=colors["bg"],
            ),
            True,
            False,
        ),
    ]

    if glob.glob("/sys/class/power_supply/BAT*"):
        specs.append(
            (
                BlockBattery,
                dict(
                    font=WINDOW_FONT,
                    fontsize=BIG_SIZE,
                    padding=3,
                    background=colors["magenta"],
                    foreground=colors["bg"],
                    low_foreground=colors["red"],
                    low_background=None,
                    low_percentage=0.3,
                ),
                True,
                False,
            )
        )

    specs += [
        (
            widget.Net,
            dict(
                font=WINDOW_FONT,
                fontsize=BIG_SIZE,
                padding=3,
                format="\u2193 {down:.0f}{down_suffix} \u2191 {up:.0f}{up_suffix}",
                update_interval=3,
                background=colors["pink"],
            ),
            True,
            False,
        ),
        (
            BlockMemory,
            dict(
                font=WINDOW_FONT,
                fontsize=BIG_SIZE,
                padding=3,
                format=MEM_ICON + " {meter}",
                update_interval=1.0,
            ),
            True,
            False,
        ),
        (
            widget.CurrentLayout,
            dict(
                font=WINDOW_FONT,
                fontsize=BIG_SIZE,
                padding=3,
                background=colors["pink"],
            ),
            True,
            False,
        ),
        (
            widget.Clock,
            dict(
                font=WINDOW_FONT,
                fontsize=BIG_SIZE,
                padding=3,
                format="%m/%d/%Y",
                background=colors["orange"],
            ),
            True,
            False,
        ),
        (
            widget.Clock,
            dict(
                font=WINDOW_FONT,
                fontsize=BIG_SIZE,
                padding=3,
                format="%I:%M %p ",
                background=colors["gutter"],
            ),
            False,
            False,
        ),
    ]

    return specs


def _widgets():
    specs = _specs()
    widgets = []

    for index, (cls, kwargs, separator, inherit_bg) in enumerate(specs):
        if inherit_bg and index + 1 < len(specs):
            kwargs["background"] = specs[index + 1][1].get("background", DEFAULT_BG)

        widgets.append(cls(**kwargs))

        if separator and index + 1 < len(specs):
            widgets.append(
                widget.TextBox(
                    text=" " + SEPARATOR,
                    font=WINDOW_FONT,
                    fontsize=BAR_HEIGHT,
                    padding=-1,
                    foreground=specs[index + 1][1].get("background", DEFAULT_BG),
                    background=kwargs.get("background", DEFAULT_BG),
                )
            )

    return widgets


def make_bar():
    return bar.Bar(
        _widgets(),
        BAR_HEIGHT,
        foreground=DEFAULT_FG,
        background=DEFAULT_BG,
        opacity=1.0,
        margin=[MARGIN, MARGIN, BORDER_WIDTH, MARGIN],
    )
