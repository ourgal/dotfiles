{{ $os := .chezmoi.os -}}
{{ if eq .chezmoi.os "linux" -}}
{{ $os = .chezmoi.osRelease.id -}}
{{ end -}}
#Requires AutoHotkey v2.0
#SingleInstance Force

Run "gopass show -c keepassxc/main", ,"Hide"
WinWait "Message from User"

{{ if and (eq (index .my.themes .my.modules.windows.theme).wm "glazewm") (lookPath "glazewm") -}}
Run "glazewm command focus --workspace 9"
{{ end -}}
Run "keepassxc"
WinWaitActive " - KeePassXC"
WinActive " - KeePassXC"

Send "^v"
Send "{Enter}"
return
