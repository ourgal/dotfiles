# chezmoi:template:left-delimiter=[[ right-delimiter=]]
---
tailscale_enabled: true
tailscale_packages:
  - tailscale

# Optional pre-auth key for unattended joins; leave empty to log in manually.
tailscale_auth_key: ''

# Advertise the LAN subnet as a Tailscale route (off by default).
tailscale_advertise_routes: false

tailscale_lan_subnet: >-
  {{ (ansible_facts.get('default_ipv4', {}).get('address', '192.168.0.101') ~ '/' ~
      ansible_facts.get('default_ipv4', {}).get('netmask', '255.255.255.0'))
     | ansible.utils.ipaddr('network/prefix') }}

tailscale_up_args:
  - --accept-routes
  - --advertise-exit-node
  - --accept-dns=false
  - --timeout=60s
