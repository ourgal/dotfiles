{{ includeTemplate "ansible_playbook_makefile" . -}}

sops:
	env $(ANSIBLE_ENV) sops inventory/group_vars/secrets.sops.yml

ROUTER_PLAYBOOK := playbooks/router.yml
.PHONY: router

router: lint
	$(ANSIBLE_ENV) ansible-playbook -i $(INVENTORY) $(ROUTER_PLAYBOOK) $(if $(TAGS),--tags $(TAGS),)

AI_PLAYBOOK := playbooks/ai.yml
.PHONY: ai

ai: lint
	$(ANSIBLE_ENV) ansible-playbook -i $(INVENTORY) $(AI_PLAYBOOK) $(if $(TAGS),--tags $(TAGS),)
