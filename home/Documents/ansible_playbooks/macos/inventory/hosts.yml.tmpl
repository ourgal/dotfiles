---
all:
  vars:
    ansible_become_pass: {{ includeTemplate "secrets" . | fromToml | dig "password" "linux" "user" "" }}
  hosts:
    # ssh already resolves this alias (see dot_ssh/config.tmpl).
    macmini:
      # AI servers disabled: no model is served on port 8080. The llama_cpp
      # role's retire path stops/disables the launchd daemon and removes the GGUF.
      mlx_vlm_enabled: false
      llama_cpp_enabled: false
      # Delete the NixOS partitions of the dual-boot install and give the space
      # back to macOS.
      nixos_uninstall_enabled: true
