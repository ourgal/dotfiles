<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{ syncthing_service }}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ syncthing_binary }}</string>
    <string>serve</string>
    <string>--no-browser</string>
    <string>--home</string>
    <string>{{ syncthing_config_home }}</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>{{ syncthing_user_home }}</string>
  </dict>
  <key>StandardOutPath</key>
  <string>{{ syncthing_log_dir }}/syncthing.log</string>
  <key>StandardErrorPath</key>
  <string>{{ syncthing_log_dir }}/syncthing.err.log</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
