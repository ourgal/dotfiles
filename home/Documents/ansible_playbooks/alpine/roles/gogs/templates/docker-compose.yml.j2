services:
  gogs:
    image: {{ gogs_image }}
    container_name: gogs
    restart: unless-stopped
    # Gogs takes no config from the environment: set server.DOMAIN, ROOT_URL and
    # SSH_PORT in {{ gogs_dir }}/data/gogs/conf/app.ini on first boot.
    environment:
      - USER_UID={{ gogs_uid }}
      - USER_GID={{ gogs_gid }}
    ports:
      - "{{ gogs_http_port }}:3000"
      - "{{ gogs_ssh_port }}:22"
    volumes:
      - gogs-data:/data
    networks:
      - gogs

volumes:
  gogs-data:

networks:
  gogs:
    name: gogs
