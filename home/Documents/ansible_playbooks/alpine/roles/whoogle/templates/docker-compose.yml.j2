services:
  whoogle-search:
    image: {{ whoogle_image }}
    container_name: whoogle-search
    restart: unless-stopped
    pids_limit: 50
    mem_limit: 256mb
    memswap_limit: 256mb
    user: whoogle
    security_opt:
      - no-new-privileges
    cap_drop:
      - ALL
    # The image runs as uid 927 and keeps all state here; tmpfs keeps it
    # ephemeral, which is all Whoogle needs.
    tmpfs:
      - /config/:size=10M,uid=927,gid=927,mode=1700
      - /var/lib/tor/:size=15M,uid=927,gid=927,mode=1700
      - /run/tor/:size=1M,uid=927,gid=927,mode=1700
{% if whoogle_config_url or whoogle_user %}
    environment:
{% if whoogle_config_url %}
      WHOOGLE_CONFIG_URL: "{{ whoogle_config_url }}"
{% endif %}
{% if whoogle_user %}
      WHOOGLE_USER: "{{ whoogle_user }}"
      WHOOGLE_PASS: "{{ whoogle_password }}"
{% endif %}
{% endif %}
    ports:
      - "{{ whoogle_http_port }}:5000"
