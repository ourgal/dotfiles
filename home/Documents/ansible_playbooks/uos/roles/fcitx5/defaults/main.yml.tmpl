# chezmoi:template:left-delimiter=[[ right-delimiter=]]
---
# Port of ~/Documents/scripts/uos/04_setup-fcitx5.sh.
# UOS Desktop 20 ships only a 2018 fcitx5 snapshot with no input method, so the
# 5.0.x stack below is built from the Debian 11 source line against the local
# gcc 8.3 / boost 1.67 / ICU 63. Everything installs into /usr/local.
fcitx5_enabled: true
fcitx5_prefix: /usr/local
fcitx5_state_dir: "{{ ansible_facts.user_dir }}/.local/share/fcitx5-setup"
fcitx5_jobs: "{{ ansible_facts.processor_vcpus | default(2) }}"

fcitx5_rime: true
fcitx5_opencc: true
fcitx5_sbsrf: true
fcitx5_proxy: ""
fcitx5_proxy_env: "{{ {'https_proxy': fcitx5_proxy, 'http_proxy': fcitx5_proxy} if fcitx5_proxy else {} }}"

fcitx5_mirror_primary: "https://mirrors.tuna.tsinghua.edu.cn/debian/pool"
fcitx5_mirror_fallback: "https://deb.debian.org/debian/pool"
# Download through the shared gh mirror; this host cannot reach GitHub directly.
fcitx5_sbsrf_url: "[[ .my.gh_proxy ]]/https://github.com/sbsrf/sbsrf/releases/latest/download/sbsrf.zip"
# Point at a locally downloaded zip to avoid the GitHub asset entirely.
fcitx5_sbsrf_zip: ""

fcitx5_rime_user_dir: "{{ ansible_facts.user_dir }}/.local/share/fcitx5/rime"
fcitx5_rime_share_dir: "{{ fcitx5_prefix }}/share/rime-data"

# Where GTK/Qt actually scan for input modules. These are the standard Debian
# multiarch paths; override them if UOS moved them.
fcitx5_gtk2_immoduledir: "/usr/lib/{{ ansible_facts.architecture }}-linux-gnu/gtk-2.0/2.10.0/immodules"
fcitx5_gtk3_immoduledir: "/usr/lib/{{ ansible_facts.architecture }}-linux-gnu/gtk-3.0/3.0.0/immodules"
fcitx5_qt5_plugindir: "/usr/lib/{{ ansible_facts.architecture }}-linux-gnu/qt5/plugins"

fcitx5_apt_packages:
  - g++
  - make
  - cmake
  - ninja-build
  - pkg-config
  - gettext
  - git
  - wget
  - ca-certificates
  - extra-cmake-modules
  - libuv1-dev
  - libsystemd-dev
  - libdbus-1-dev
  - dbus-x11
  - libexpat1-dev
  - libicu-dev
  - libmarisa-dev
  - libjson-c-dev
  - zlib1g-dev
  - libbrotli-dev
  - libcurl4-openssl-dev
  - libboost-dev
  - libboost-iostreams-dev
  - libboost-filesystem-dev
  - libboost-regex-dev
  - libxcb1-dev
  - libxcb-ewmh-dev
  - libxcb-icccm4-dev
  - libxcb-randr0-dev
  - libxcb-util0-dev
  - libxcb-xkb-dev
  - libxcb-xfixes0-dev
  - libxcb-shm0-dev
  - libxcb-keysyms1-dev
  - libxcb-xinerama0-dev
  - libxcb-shape0-dev
  - uthash-dev
  - libxkbcommon-dev
  - libxkbcommon-x11-dev
  - libxkbfile-dev
  - libx11-dev
  - xkb-data
  - xcb-proto
  - x11proto-dev
  - libcairo2-dev
  - libpango1.0-dev
  - libgdk-pixbuf2.0-dev
  - libglib2.0-dev
  - libgirepository1.0-dev
  - libgtk-3-dev
  - libgtk2.0-dev
  - libgtk-3-bin
  - libgtk2.0-bin
  - qtbase5-dev
  - qtbase5-dev-tools
  - qtbase5-private-dev
  - libqt5dbus5
  - libenchant-2-dev
  - libopencc-dev
  - iso-codes
  - shared-mime-info
  - desktop-file-utils
fcitx5_rime_apt_packages:
  - libleveldb-dev
  - libyaml-cpp-dev
  - libgoogle-glog-dev
  - libgflags-dev
  - libboost-system-dev
  - liblua5.3-dev
  - python3
  - rapidjson-dev
  - libtclap-dev
  - unzip
fcitx5_optional_apt_packages:
  - appstream
  - librsvg2-dev
  - libwayland-dev
  - libxcb-imdkit0

# Pinned versions are matched to each other; do not bump one on its own.
# Build order matters: fmt, xcb-imdkit, opencc and librime must precede their
# consumers. `args` are the real CMake cache options for these versions.
fcitx5_all_components:
  - name: fmt
    url: "main/f/fmtlib/fmtlib_7.1.3%2Bds1.orig.tar.gz"
    args: [-DFMT_TEST=OFF, -DFMT_DOC=OFF]
  - name: imdkit
    url: "main/x/xcb-imdkit/xcb-imdkit_1.0.9.orig.tar.xz"
    args: [-DUSE_SYSTEM_UTHASH=ON]
  - name: fcitx5
    url: "main/f/fcitx5/fcitx5_5.0.21.orig.tar.xz"
    args: [-DENABLE_WAYLAND=OFF, -DUSE_SYSTEMD=ON, -DENABLE_XDGAUTOSTART=ON, -DENABLE_ENCHANT=ON]
  - name: libime
    url: "main/libi/libime/libime_1.0.16.orig.tar.xz"
    args: [-DENABLE_DOC=OFF]
  - name: opencc
    url: "main/o/opencc/opencc_1.1.9%2Bds1.orig.tar.xz"
    args:
      - -DUSE_SYSTEM_MARISA=ON
      - -DUSE_SYSTEM_RAPIDJSON=ON
      - -DUSE_SYSTEM_TCLAP=ON
      - -DENABLE_DARTS=OFF
      - -DENABLE_GTEST=OFF
      - -DENABLE_BENCHMARK=OFF
      - -DBUILD_PYTHON=OFF
      - -DBUILD_DOCUMENTATION=OFF
  - name: gtk
    url: "main/f/fcitx5-gtk/fcitx5-gtk_5.0.21.orig.tar.xz"
    args:
      - -DENABLE_GTK4_IM_MODULE=OFF
      - -DENABLE_GIR=OFF
      - -DENABLE_SNOOPER=OFF
      - "-DGTK2_IM_MODULEDIR={{ fcitx5_gtk2_immoduledir }}"
      - "-DGTK3_IM_MODULEDIR={{ fcitx5_gtk3_immoduledir }}"
  - name: qt
    url: "main/f/fcitx5-qt/fcitx5-qt_5.0.16.orig.tar.xz"
    args:
      - -DENABLE_QT4=OFF
      - -DENABLE_QT5=ON
      - -DENABLE_QT6=OFF
      - "-DCMAKE_INSTALL_QT5PLUGINDIR={{ fcitx5_qt5_plugindir }}"
  - name: addons
    url: "main/f/fcitx5-chinese-addons/fcitx5-chinese-addons_5.0.16.orig.tar.xz"
    args:
      - -DENABLE_GUI=OFF
      - -DENABLE_BROWSER=OFF
      - "-DENABLE_OPENCC={{ 'ON' if (fcitx5_opencc | bool) else 'OFF' }}"
      - -DENABLE_CLOUDPINYIN=ON
  - name: librime
    url: "main/libr/librime/librime_1.8.5%2Bdfsg1.orig.tar.xz"
    args:
      - -DBUILD_TEST=OFF
      - -DBUILD_MERGED_PLUGINS=ON
      - -DBUILD_DATA=OFF
      - -DENABLE_LOGGING=ON
      - -DBOOST_USE_SIGNALS2=ON
      - "-DRIME_DATA_DIR={{ fcitx5_rime_share_dir }}"
  - name: rimefe
    url: "main/f/fcitx5-rime/fcitx5-rime_5.0.15.orig.tar.xz"
    args:
      - "-DRIME_DATA_DIR={{ fcitx5_rime_share_dir }}"

# librime-lua is delivered as a second orig tarball and merged in-tree.
fcitx5_extra_tarballs:
  - url: "main/libr/librime/librime_1.8.5%2Bdfsg1.orig-librime-lua.tar.xz"
    subdir: "librime/extracted/plugins/lua"
