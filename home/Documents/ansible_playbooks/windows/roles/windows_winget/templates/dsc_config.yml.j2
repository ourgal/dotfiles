resources:
{% for package in windows_winget_packages %}
{%   if package is mapping %}
{%     set package_id = package.id | default(package.name) %}
{%     set package_state = package.state | default(windows_winget_state) %}
{%     set package_source = package.source | default(windows_winget_source) %}
{%     set package_accept_agreements = package.accept_agreements | default(windows_winget_accept_agreements) %}
{%     set package_install_mode = package.install_mode | default(windows_winget_install_mode) %}
{%     set package_match_option = package.match_option | default(windows_winget_match_option) %}
{%     set package_version = package.version | default(none) %}
{%   else %}
{%     set package_id = package %}
{%     set package_state = windows_winget_state %}
{%     set package_source = windows_winget_source %}
{%     set package_accept_agreements = windows_winget_accept_agreements %}
{%     set package_install_mode = windows_winget_install_mode %}
{%     set package_match_option = windows_winget_match_option %}
{%     set package_version = none %}
{%   endif %}
  - name: {{ package_id | to_json }}
    type: Microsoft.WinGet/Package
    properties:
      id: {{ package_id | to_json }}
      source: {{ package_source | to_json }}
      acceptAgreements: {{ package_accept_agreements | bool | to_json }}
      installMode: {{ package_install_mode | to_json }}
      matchOption: {{ package_match_option | to_json }}
      useLatest: {{ (package_state == 'latest') | to_json }}
      _exist: {{ (package_state != 'absent') | to_json }}
{%   if package_version is not none %}
      version: {{ package_version | to_json }}
{%   endif %}
{% endfor %}
