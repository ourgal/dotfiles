# chezmoi:template:left-delimiter=[[ right-delimiter=]]
---
- name: Easyos
  hosts: all
  ignore_unreachable: true
  vars:
    gh_proxy: [[ .my.gh_proxy ]]/
    tmp: /root/.cache
  tasks:
    - name: Update apt cache
      tags: apt
      ansible.builtin.apt:
        update_cache: true
    - name: Install apt packages
      ansible.builtin.apt:
        name:
          # system
          - aptitude
          - ssh-askpass
          # clipboard
          - xclip
          - xsel
          # remote
          - deskflow
          # encrypt
          - keepassxc
          # editor
          - vim
          - vim-gtk3
          - vim-gui-common
          - emacs
          - kakoune
          - neovim
          # image viewer
          - feh
          # book
          - calibre
          # mpv plugin dependencies
          - python3-guessit
          - python3-requests
          # browser
          - qutebrowser
          # bookmark
          - buku
          # download
          - aria2
          - transmission-cli
          - transmission-daemon
          - qbittorrent
          # shell
          - fish
          # archive
          - atool
          - 7zip
          # fuzzy finder
          - fzf
          # file manager
          - nnn
          - ranger
          - lf
          - mc
          # terminal
          - kitty
          # share
          - rclone
          # cd
          - zoxide
          # prompt
          - starship
          # less
          - bat
          # grep
          - ripgrep
          # fetch
          - fastfetch
          # screen
          - tmux
          # top
          - btop
          - htop
          # mv
          - mmv
          # du
          - duf
          # dev
          - make
          - git
          - gh
          - git-crypt
          - lazygit
          - editorconfig
          # ansible
          - ansible
          - ansible-core
          # diff
          - delta
          # python
          - pipx
          # nodejs
          - nodejs
          - npm
    - name: Gather package facts
      ansible.builtin.package_facts:
        manager: auto
    - name: Chezmoi
      vars:
        v: 2.72.0
      when: "'chezmoi' not in ansible_facts.packages or ansible_facts.packages['chezmoi'][0].version != v"
      block:
        - name: Download chezmoi
          ansible.builtin.get_url:
            url: "{{ gh_proxy }}https://github.com/twpayne/chezmoi/releases/download/v{{ v }}/chezmoi_{{ v }}_linux_amd64.deb"
            dest: "{{ tmp }}/chezmoi.deb"
            checksum: "sha256:6023435f5393553345ec10c75cd8160658c415f2bf9c3d8def3e120c92faf629"
            mode: "0644"
        - name: Install chezmoi
          ansible.builtin.apt:
            deb: "{{ tmp }}/chezmoi.deb"
    - name: Gopass
      vars:
        v: 1.16.1
      when: "'gopass' not in ansible_facts.packages or ansible_facts.packages['gopass'][0].version != v"
      block:
        - name: Download gopass
          ansible.builtin.get_url:
            url: "{{ gh_proxy }}https://github.com/gopasspw/gopass/releases/download/v{{ v }}/gopass_{{ v }}_linux_amd64.deb"
            dest: "{{ tmp }}/gopass.deb"
            checksum: "sha256:c96b0e10813598799f2154f22456501ec190f45eaa7fead7beba21f17993a514"
            mode: '0644'
        - name: Install gopass
          ansible.builtin.apt:
            deb: "{{ tmp }}/gopass.deb"
    - name: Helix
      vars:
        v: 25.07.1
      when: "'helix' not in ansible_facts.packages or ansible_facts.packages['helix'][0].version != '25.7.1-1'"
      block:
        - name: Download helix
          ansible.builtin.get_url:
            url: "{{ gh_proxy }}https://github.com/helix-editor/helix/releases/download/{{ v }}/helix_25.7.1-1_amd64.deb"
            dest: "{{ tmp }}/helix.deb"
            checksum: "sha256:c9ff7ee3113f039c21c3ff31e8e2b71d1cc51a2c3e6c39face36e3cf25fe8788"
            mode: '0644'
        - name: Install helix
          ansible.builtin.apt:
            deb: "{{ tmp }}/helix.deb"
    - name: Add Flathub repository remote
      community.general.flatpak_remote:
        name: flathub
        state: present
        flatpakrepo_url: https://dl.flathub.org/repo/flathub.flatpakrepo
        method: system
    - name: Install pipx packages
      tags:
        - pipx
      community.general.pipx:
        name: "{{ item }}"
      loop:
        - uv
    - name: Set emacs desktop file
      ansible.builtin.copy:
        dest: /usr/share/applications/emacs_simple.desktop
        mode: "0644"
        content: |
          [Desktop Entry]
          Version=1.0
          Name=Emacs
          GenericName=Text Editor
          Comment=GNU Emacs is an extensible, customizable text editor - and more
          MimeType=text/english;text/plain;text/x-makefile;text/x-c++hdr;text/x-c++src;text/x-chdr;text/x-csrc;text/x-java;text/x-moc;text/x-pascal;text/x-tcl;text/x-tex;application/x-shellscript;text/x-c;text/x-c++;
          TryExec=/usr/bin/emacs
          Exec=/usr/bin/emacs
          Icon=emacs
          Type=Application
          Terminal=false
          Categories=Utility;Development;TextEditor;
          StartupNotify=true
          StartupWMClass=Emacs
          Keywords=Text;Editor;
    - name: Set emacs client desktop file
      ansible.builtin.copy:
        dest: /usr/share/applications/emacsclient_simple.desktop
        mode: "0644"
        content: |
          [Desktop Entry]
          Name=Emacs Client
          GenericName=Text Editor
          Comment=Edit text
          MimeType=text/english;text/plain;text/x-makefile;text/x-c++hdr;text/x-c++src;text/x-chdr;text/x-csrc;text/x-java;text/x-moc;text/x-pascal;text/x-tcl;text/x-tex;application/x-shellscript;text/x-c;text/x-c++;x-scheme-handler/org-protocol;
          Exec=/usr/bin/emacsclient --alternate-editor= --create-frame
          Icon=emacs
          Type=Application
          Terminal=false
          Categories=Development;TextEditor;
          StartupNotify=true
          StartupWMClass=Emacs
          Keywords=emacsclient;
          Actions=new-window;new-instance;

          [Desktop Action new-window]
          Name=New Window
          Exec=/usr/bin/emacsclient --alternate-editor= --create-frame %F

          [Desktop Action new-instance]
          Name=New Instance
          Exec=emacs %F
  handlers:
    - name: Refresh font cache
      ansible.builtin.command:
        cmd: fc-cache -f
      changed_when: false
